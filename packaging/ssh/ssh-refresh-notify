#!/bin/sh
/usr/bin/env -i \
  PATH=/usr/bin:/bin \
  LANG=C \
  LC_ALL=C \
  /usr/bin/python3 -I \
  /opt/forkmesh-mirror/ssh_post_receive_refresh.py \
  --config /etc/forkmesh/ssh-refresh.json \
  notify && exit 0





umask 077
retry_marker=$(/usr/bin/mktemp \
  /run/forkmesh-mirror-refresh/.notify-failed.XXXXXXXX) || exit 1
if /usr/bin/printf '%s\n' 'forkmesh-refresh-v1' >"$retry_marker"; then
  /usr/bin/mv -f -- "$retry_marker" /run/forkmesh-mirror-refresh/pending
  exit $?
fi
/usr/bin/rm -f -- "$retry_marker"
exit 1
