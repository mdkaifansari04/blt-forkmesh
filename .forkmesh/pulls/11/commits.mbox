+
+void _skipCompressedBlock(
+  _DeflateBitReader reader,
+  _Huffman literal,
+  _Huffman? distance,
+) {
+  while (true) {
+    final symbol = literal.decode(reader);
+    if (symbol < 256) continue;
+    if (symbol == 256) return;
