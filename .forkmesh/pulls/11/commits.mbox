+        object.objectId.hex,
+      ]);
+      expect(type.exitCode, 0, reason: type.stderr.toString());
+      expect(type.stdout.toString().trim(), object.type.name);
+      final body = await Process.run(_systemGit, <String>[
+        '-C',
+        root.path,
