+          reader.readBits(symbol == 17 ? 3 : 7) + (symbol == 17 ? 3 : 11);
+      if (lengths.length + count > total) _invalidDeflateLengths();
+      lengths.addAll(List<int>.filled(count, 0));
+    } else {
