+QString workingTreeHead(const QString &path)
+{
+    QByteArray output;
+    if (path.trimmed().isEmpty() ||
+        !runGitCapture(path, {QStringLiteral("rev-parse"), QStringLiteral("HEAD")},
+                       &output, nullptr))
+        return QString();
+    return QString::fromUtf8(output).trimmed();
+}
+
+// Resolve .git for ordinary clones and linked worktrees. logs/HEAD changes for
+// commits, merges, checkouts, resets, and history rewrites without polling.
+QString worktreeHeadLogPath(const QString &workTree)
+{
+    const QFileInfo marker(QDir(workTree).filePath(QStringLiteral(".git")));
+    QString gitDir;
+    if (marker.isDir()) {
+        gitDir = marker.absoluteFilePath();
+    } else if (marker.isFile()) {
+        QFile file(marker.absoluteFilePath());
+        if (!file.open(QIODevice::ReadOnly))
+            return QString();
+        const QString line = QString::fromUtf8(file.readLine()).trimmed();
+        if (!line.startsWith(QStringLiteral("gitdir:"), Qt::CaseInsensitive))
+            return QString();
+        gitDir = line.mid(7).trimmed();
+        if (QDir::isRelativePath(gitDir))
+            gitDir = marker.dir().absoluteFilePath(gitDir);
+    }
+    const QString log =
+        QDir::cleanPath(QDir(gitDir).filePath(QStringLiteral("logs/HEAD")));
+    return QFileInfo::exists(log) ? log : QString();
+}
