+void MainWindow::refreshRepoChangeWatches()
+{
+    if (!m_repoChangeWatcher) {
+        m_repoChangeWatcher = new QFileSystemWatcher(this);
+        m_repoChangeDebounce = new QTimer(this);
+        m_repoChangeDebounce->setSingleShot(true);
+        m_repoChangeDebounce->setInterval(75);
+        connect(m_repoChangeWatcher, &QFileSystemWatcher::fileChanged, this,
+                [this](const QString &path) {
+                    const QString localPath = m_repoChangeWatchPaths.value(path);
+                    if (!localPath.isEmpty())
+                        m_changedLocalRepos.insert(localPath);
+                    if (QFileInfo::exists(path) &&
+                        !m_repoChangeWatcher->files().contains(path))
+                        m_repoChangeWatcher->addPath(path);
+                    m_repoChangeDebounce->start();
+                });
+        connect(m_repoChangeDebounce, &QTimer::timeout, this, [this] {
+            const QSet<QString> changed = m_changedLocalRepos;
+            m_changedLocalRepos.clear();
+            refreshRepoChangeWatches();
+            for (const QString &localPath : changed) {
+                for (int i = 0; i < m_repositories.size(); ++i) {
+                    const RepositoryRecord &repo = m_repositories.at(i);
+                    if (!repo.previewOnly && repo.localPath == localPath) {
+                        propagateRepoUpdate(i);
+                        break;
+                    }
+                }
+            }
+        });
+    }
+
+    QSet<QString> wanted;
+    for (const RepositoryRecord &repo : std::as_const(m_repositories)) {
+        if (repo.previewOnly || repo.localPath.trimmed().isEmpty() ||
+            repo.mirrorPath.trimmed().isEmpty())
+            continue;
+        const QString logPath = worktreeHeadLogPath(repo.localPath);
+        if (logPath.isEmpty())
+            continue;
+        wanted.insert(logPath);
+        m_repoChangeWatchPaths.insert(logPath, repo.localPath);
+        if (!m_repoChangeWatcher->files().contains(logPath))
+            m_repoChangeWatcher->addPath(logPath);
+    }
+    for (const QString &path : m_repoChangeWatcher->files()) {
+        if (wanted.contains(path))
+            continue;
+        m_repoChangeWatcher->removePath(path);
+        m_repoChangeWatchPaths.remove(path);
+    }
+}
