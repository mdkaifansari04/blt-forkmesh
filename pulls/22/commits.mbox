+void MainWindow::setDiscussionInlineNotice(const QString &message, bool isError)
+{
+    if (m_discussionInlineNotice)
+        m_discussionInlineNotice->hide();
+    if (!message.trimmed().isEmpty())
+        flashMessage(message, isError);
+}
