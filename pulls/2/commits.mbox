 cloudflare_worker/public/index.html           | 560 +++--------------
 cloudflare_worker/public/styles.css           | 582 +++++++++++++++---
 .../tests/test_landing_typography.py          | 112 ++++
 7 files changed, 697 insertions(+), 557 deletions(-)
