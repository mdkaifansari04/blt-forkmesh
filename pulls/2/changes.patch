+void checkNoRepoStarAction(QWidget &root)
+{
+    QStringList starActions;
+    const QList<QPushButton *> buttons = root.findChildren<QPushButton *>();
+    for (QPushButton *button : buttons) {
+        if (button->objectName() != QStringLiteral("repoAction"))
+            continue;
+        if (!button->text().startsWith(QStringLiteral("Star")))
+            continue;
+        starActions.append(widgetPath(button));
+    }
+
+    check(starActions.isEmpty(),
+          QStringLiteral("repo detail header omits the Star action button"));
+    for (const QString &path : starActions)
+        qInfo().noquote() << QStringLiteral("FOUND STAR ACTION ") + path;
+}
+
