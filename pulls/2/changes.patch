+
+        QSemaphore syncPrepStarted;
+        QSemaphore finishSyncPrep;
+        window.testSetSyncPrepRunner([&] {
+            syncPrepStarted.release();
+            finishSyncPrep.acquire();
+        });
+        QTemporaryDir syncMirrorDir;
+        const QString syncMirrorPath =
