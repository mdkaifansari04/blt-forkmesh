+bool MainWindow::testCommitRowActionsIncludeRestore()
+{
+    if (!m_commitsTable)
+        return false;
+    loadCommits();
+    if (m_commitsTable->rowCount() <= 0)
+        return false;
+    QWidget *actions = m_commitsTable->cellWidget(0, kCommitActionCol);
+    if (!actions)
+        return false;
+
+    QList<QPushButton *> buttons = actions->findChildren<QPushButton *>();
+    if (auto *button = qobject_cast<QPushButton *>(actions))
+        buttons.prepend(button);
+
+    bool hasDelete = false;
+    bool hasRestore = false;
+    for (QPushButton *button : buttons) {
+        const QString tip = button->toolTip();
+        hasDelete = hasDelete || tip.contains(QStringLiteral("Remove"));
+        hasRestore = hasRestore || tip.contains(QStringLiteral("Undo"));
+    }
+    return hasDelete && hasRestore;
+}
