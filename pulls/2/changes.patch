+"""Mailtrap sender contracts for worker email administration."""
+
+import ast
+import asyncio
+import hashlib
+import hmac
+import inspect
+import json
+import sys
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+
+import pytest
+
+
+ENTRY = Path(__file__).resolve().parents[1] / "src" / "entry.py"
+ENTRY_TEXT = ENTRY.read_text(encoding="utf-8")
+ENTRY_TREE = ast.parse(ENTRY_TEXT, filename=str(ENTRY))
+
+
+def _function_node(name):
+    return next(
+        node
+        for node in ast.walk(ENTRY_TREE)
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        and node.name == name
+    )
+
+
+def _load_email_sender():
+    wanted_functions = {"_outreach_sender_name", "_send_email"}
+    wanted_constants = {
+        "MAILTRAP_SEND_URL",
+        "OUTREACH_SENDER_EMAIL",
+        "OUTREACH_SENDER_NAME",
+    }
+    body = []
+    for node in ENTRY_TREE.body:
+        if (
+            isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+            and node.name in wanted_functions
+        ):
+            body.append(node)
+        elif isinstance(node, ast.Assign) and any(
+            isinstance(target, ast.Name) and target.id in wanted_constants
+            for target in node.targets
+        ):
+            body.append(node)
+
+    module = ast.fix_missing_locations(ast.Module(body=body, type_ignores=[]))
+    namespace = {"json": json, "to_js": lambda value: value}
+    exec(compile(module, str(ENTRY), "exec"), namespace)
+    return namespace
+
+
+def _run_send(
+    monkeypatch,
+    *,
+    env=None,
+    to_email="recipient@example.com",
+    status=200,
+    transport_error=None,
+    **kwargs,
+):
+    calls = []
+
+    async def fetch(url, options):
+        calls.append((url, options))
+        if transport_error is not None:
+            raise transport_error
+        return SimpleNamespace(
+            status=status,
+            body="provider body containing bearer-token-secret",
+        )
+
+    js_module = ModuleType("js")
+    js_module.fetch = fetch
+    monkeypatch.setitem(sys.modules, "js", js_module)
+    sender = _load_email_sender()["_send_email"]
+    env = env or SimpleNamespace(MAILTRAP_API_TOKEN="test-token")
+    result = asyncio.run(sender(env, to_email, "Subject", "Plain text", **kwargs))
+    return result, calls
+
+
+def _payload(calls):
+    assert len(calls) == 1
+    return json.loads(calls[0][1]["body"])
+
+
+def test_send_email_signature_preserves_positional_and_keyword_only_contract():
+    node = _function_node("_send_email")
+    arguments = node.args
+
+    assert arguments.posonlyargs == []
+    assert [argument.arg for argument in arguments.args] == [
+        "env",
+        "to_email",
+        "subject",
+        "text",
+        "html",
+    ]
+    assert [ast.literal_eval(default) for default in arguments.defaults] == [None]
+    assert arguments.vararg is None
+    assert [argument.arg for argument in arguments.kwonlyargs] == [
+        "from_email",
+        "from_name",
+        "reply_to_email",
+        "reply_to_name",
+        "custom_variables",
+        "detailed",
+    ]
+    assert [ast.literal_eval(default) for default in arguments.kw_defaults] == [
+        None,
+        None,
+        None,
+        None,
+        None,
+        False,
+    ]
+    assert arguments.kwarg is None
+
