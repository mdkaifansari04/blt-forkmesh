+EMAIL_ADMIN_PATH = "/admin-email"
+EMAIL_ADMIN_COOKIE = "forkmesh_email_admin"
+EMAIL_ADMIN_SESSION_TTL_MS = 12 * 60 * 60 * 1000
+EMAIL_ADMIN_LOGIN_BUCKET_MS = 15 * 60 * 1000
