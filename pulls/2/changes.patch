+def test_email_admin_handler_has_generic_failures_csrf_and_no_store():
+    handler = _function_node("_email_admin")
+    source = ast.get_source_segment(ENTRY_TEXT, handler)
+
+    assert "Invalid username or password." in source
+    assert "_email_admin_html_response" in source
+    assert 'EMAIL_ADMIN_CACHE_CONTROL = "no-store, max-age=0, must-revalidate"' in ENTRY_TEXT
+    assert "_email_admin_redirect" in source
+    assert "status=303" in ENTRY_TEXT
+    assert '"Set-Cookie"' in source
+    assert "_email_admin_csrf_ok" in source
+    assert 'action == "logout"' in source
+    assert "_clear_email_admin_session_cookie" in source
+    assert "render_login_page" in source
+    assert "render_console_page" in source
