+def _email_admin_secret(env):
+    value = str(getattr(env, "EMAIL_ADMIN_SESSION_SECRET", "") or "").strip()
+    return value.encode()
+
+
+def _email_admin_sign(env, purpose, value):
+    canonical = ("forkmesh-email-admin-" + purpose + "-v1\n" + value).encode()
+    return hmac.new(_email_admin_secret(env), canonical, "sha256").hexdigest()
+
+
+def _email_admin_login_bucket():
+    return int(Date.now()) // EMAIL_ADMIN_LOGIN_BUCKET_MS
+
+
+def _email_admin_login_token(env, bucket):
+    return _email_admin_sign(env, "login", str(bucket))
+
+
+def _email_admin_login_token_ok(env, bucket_value, token):
+    if not _email_admin_secret(env) or not token:
+        return False
+    try:
+        bucket = int(bucket_value)
+    except (TypeError, ValueError):
+        return False
+    current = _email_admin_login_bucket()
+    if bucket not in (current, current - 1):
+        return False
+    expected = _email_admin_login_token(env, bucket)
+    return hmac.compare_digest(str(token), expected)
+
+
+def _email_admin_password_parts(env):
+    value = str(getattr(env, "EMAIL_ADMIN_PASSWORD_HASH", "") or "").strip()
+    salt, separator, digest = value.partition(":")
+    if not separator or not salt or not digest:
+        return "", ""
+    return salt, digest
+
+
+def _email_admin_session_cookie(env):
+    expires = int(Date.now()) + EMAIL_ADMIN_SESSION_TTL_MS
+    signature = _email_admin_sign(env, "session", str(expires))
+    return (
+        EMAIL_ADMIN_COOKIE + "=" + str(expires) + "." + signature
+        + "; Path=/admin-email; Max-Age=43200; HttpOnly; Secure; SameSite=Strict"
+    )
+
+
+def _clear_email_admin_session_cookie():
+    return (
+        EMAIL_ADMIN_COOKIE
+        + "=; Path=/admin-email; Max-Age=0; HttpOnly; Secure; SameSite=Strict"
+    )
+
+
+def _email_admin_session_valid(env, request):
+    if not _email_admin_secret(env):
+        return False
+    token = _cookie_value(request, EMAIL_ADMIN_COOKIE)
+    expires_value, separator, signature = token.partition(".")
+    if not separator or not expires_value.isdigit() or not signature:
+        return False
+    expires = int(expires_value)
+    now = int(Date.now())
+    if expires <= now or expires > now + EMAIL_ADMIN_SESSION_TTL_MS:
+        return False
+    expected = _email_admin_sign(env, "session", expires_value)
+    return hmac.compare_digest(signature, expected)
+
+
+def _email_admin_csrf_token(env, request):
+    if not _email_admin_session_valid(env, request):
+        return ""
+    session = _cookie_value(request, EMAIL_ADMIN_COOKIE)
+    return _email_admin_sign(env, "csrf", session)
