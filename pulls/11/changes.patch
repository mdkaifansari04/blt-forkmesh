+bool IssueStore::writeIssueIndex(QString *error) const
+{
+    QJsonArray array;
+    for (const Issue &issue : loadAll(error)) {
+        qint64 updatedAt = issue.createdAt;
+        for (const IssueEvent &ev : issue.events)
+            updatedAt = std::max(updatedAt, ev.ts);
+
+        array.append(QJsonObject{{"number", issue.number},
+                                 {"title", issue.title},
+                                 {"status", issue.status},
+                                 {"labels", fromStringList(issue.labels)},
+                                 {"milestone", issue.milestone},
+                                 {"priority", issue.priority},
+                                 {"progress", issue.progress},
+                                 {"assignees", fromStringList(issue.assignees)},
+                                 {"createdAt", double(issue.createdAt)},
+                                 {"author", issue.author},
+                                 {"authorName", issue.authorName},
+                                 {"votes", issue.votes},
+                                 {"bountyUsd", issue.bountyUsd},
+                                 {"bountyAddress", issue.bountyAddress},
+                                 {"bountyStatus", issue.bountyStatus},
+                                 {"updatedAt", double(updatedAt)}});
+    }
+    QDir().mkpath(issuesDir());
+    return writeTextFile(issuesDir() + "/index.json",
+                         QString::fromUtf8(QJsonDocument(array).toJson()), error);
+}
