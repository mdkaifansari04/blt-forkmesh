+    m_agentQueueLimitIncreaseButton->setFixedSize(24, 30);
+    m_agentQueueLimitIncreaseButton->setCursor(Qt::PointingHandCursor);
+    m_agentQueueLimitIncreaseButton->setToolTip("Run one more agent at once");
