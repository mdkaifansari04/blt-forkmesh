diff --git a/cloudflare_worker/tests/test_public_static_assets.py b/cloudflare_worker/tests/test_public_static_assets.py
new file mode 100644
index 00000000..58a45c0f
--- /dev/null
+++ b/cloudflare_worker/tests/test_public_static_assets.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Static contract tests for browser-loaded public assets."""
+
+from html.parser import HTMLParser
+from pathlib import Path
+import re
+
+
+PUBLIC = Path(__file__).resolve().parents[1] / "public"
+
+
+class StaticAssetParser(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.paths = []
+
+    def handle_starttag(self, tag, attrs):
+        values = dict(attrs)
+        if tag == "img":
+            self._append(values.get("src"))
+            self._append(values.get("data-src"))
+            self._append_srcset(values.get("srcset"))
+            return
+
+        if tag == "video":
+            self._append(values.get("src"))
+            self._append(values.get("poster"))
+            return
+
+        if tag == "source":
+            self._append(values.get("src"))
+            self._append_srcset(values.get("srcset"))
+            return
+
+        if tag == "script":
+            self._append(values.get("src"))
+            return
+
+        if tag == "link":
+            rel = values.get("rel", "")
+            if any(token in rel.split() for token in ("icon", "manifest", "preload", "stylesheet")):
+                self._append(values.get("href"))
+
+    def _append_srcset(self, value):
+        if not value:
+            return
+        for candidate in value.split(","):
+            self._append(candidate.strip().split(" ", 1)[0])
+
+    def _append(self, value):
+        if not value or not value.startswith("/") or value.startswith("//"):
+            return
+        self.paths.append(value.split("?", 1)[0].split("#", 1)[0])
+
+
+def _css_urls(text):
+    return [
+        match.group(1).split("?", 1)[0].split("#", 1)[0]
+        for match in re.finditer(r"url\([\"']?(/[^)\"']+)", text)
+    ]
+
+
+def _absolute_forkmesh_asset_urls(text):
+    asset_extensions = (
+        ".avif",
+        ".gif",
+        ".ico",
+        ".jpg",
+        ".jpeg",
+        ".mp4",
+        ".png",
+        ".svg",
+        ".webmanifest",
+        ".webp",
+    )
+    paths = []
+    for match in re.finditer(r"https://forkmesh\.com(/[^\s\"'<>]+)", text):
+        path = match.group(1).split("?", 1)[0].split("#", 1)[0]
+        if path.lower().endswith(asset_extensions):
+            paths.append(path)
+    return paths
+
+
+def test_browser_loaded_public_assets_exist():
+    missing = []
+
+    for page in sorted(PUBLIC.rglob("*.html")):
+        parser = StaticAssetParser()
+        text = page.read_text(encoding="utf-8")
+        parser.feed(text)
+        paths = parser.paths + _css_urls(text) + _absolute_forkmesh_asset_urls(text)
+        for path in paths:
+            if not (PUBLIC / path.lstrip("/")).is_file():
+                missing.append(f"{page.relative_to(PUBLIC).as_posix()}: {path}")
+
+    for stylesheet in sorted(PUBLIC.rglob("*.css")):
+        text = stylesheet.read_text(encoding="utf-8")
+        for path in _css_urls(text):
+            if not (PUBLIC / path.lstrip("/")).is_file():
+                missing.append(f"{stylesheet.relative_to(PUBLIC).as_posix()}: {path}")
+
+    assert missing == []
