+QString backoffDuration(qint64 ms)
+{
+    const qint64 seconds = qMax<qint64>(1, (ms + 999) / 1000);
+    if (seconds < 60)
+        return QStringLiteral("%1s").arg(seconds);
+    const qint64 minutes = seconds / 60;
+    const qint64 remainingSeconds = seconds % 60;
+    return remainingSeconds == 0
+               ? QStringLiteral("%1m").arg(minutes)
+               : QStringLiteral("%1m %2s").arg(minutes).arg(remainingSeconds);
+}
+
+QString backoffRate(qint64 delayMs)
+{
+    if (delayMs <= 0)
+        return QStringLiteral("normal");
+    const double requestsPerMinute = 60.0 * 1000.0 / delayMs;
+    const int decimals = requestsPerMinute >= 10.0 ? 0 : 1;
+    return QStringLiteral("%1 requests/min")
+        .arg(QString::number(requestsPerMinute, 'f', decimals));
+}
