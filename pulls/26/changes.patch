     }
 
+    // The exponential delay selected for the current failure streak. Zero
+    // means this channel has no active backoff.
+    qint64 currentDelayMs(const QString &channel) const
+    {
+        return m_channels.value(channel).delayMs;
+    }
+
+    // The time remaining before this channel may be tried again.
+    qint64 retryAfterMs(const QString &channel, qint64 nowMs) const
+    {
+        const State state = m_channels.value(channel);
+        return qMax<qint64>(0, state.nextAllowedMs - nowMs);
+    }
+
     // A request succeeded: clear the failure streak so the next poll fires on
     // the normal schedule.
     void noteSuccess(const QString &channel)
@@ -39,6 +53,21 @@ public:
             m_channels.remove(channel);
     }
 
+    // A host-wide backoff must not be cleared by an unrelated request that
+    // happened to succeed while the cooldown was active. Such requests can be
+    // in flight from before the failure, or can hit a different endpoint with
+    // a separate limit. Only a success after the cooldown has elapsed resets
+    // the host-wide failure streak.
+    void noteSuccess(const QString &channel, qint64 nowMs)
+    {
+        if (channel.isEmpty())
+            return;
+        const auto it = m_channels.constFind(channel);
+        if (it != m_channels.constEnd() && it->nextAllowedMs > nowMs)
+            return;
+        m_channels.remove(channel);
+    }
+
     // A request failed: extend the cooldown. The nth consecutive failure holds
     // the channel off for min(baseMs · 2^(n-1), capMs), plus a little jitter so
     // independently-failing channels don't all retry on the exact same tick.
@@ -54,6 +83,7 @@ public:
         for (int i = 1; i < s.failures && delay < capMs; ++i)
             delay <<= 1;
         delay = qMin(delay, capMs);
+        s.delayMs = delay;
         const quint32 span = static_cast<quint32>(qMax<qint64>(1, delay / 8));
         s.nextAllowedMs =
             nowMs + delay + QRandomGenerator::global()->bounded(span);
@@ -67,6 +97,7 @@ public:
 private:
     struct State {
         int failures = 0;
+        qint64 delayMs = 0;
         qint64 nextAllowedMs = 0;
     };
