-        g.setPen(QPen(QColor(m_line), 2));
-        g.drawLine(QPointF(cx, m_first ? kNodeY : 0), QPointF(cx, height()));
-        g.setPen(Qt::NoPen);
-        g.setBrush(QColor(m_node));
-        g.drawEllipse(QPointF(cx, kNodeY), 4.0, 4.0);
-    }
-
-private:
-    QString m_node, m_line;
-    bool m_first;
-};
