+QUrl ServerNode::canonicalMainnodeRoomUrl(const QUrl &serverUrl,
+                                          const QString &roomName)
+{
+    QUrl url;
+    url.setScheme(serverUrl.scheme());
+    url.setHost(serverUrl.host());
+    if (serverUrl.port() >= 0)
+        url.setPort(serverUrl.port());
+    url.setPath(QStringLiteral("/api/repo/mainnode/forkmesh/rooms/%1/ws")
+                    .arg(normalizedRoomName(roomName)));
+    url.setQuery(QString());
+    url.setFragment(QString());
+    return url;
+}
