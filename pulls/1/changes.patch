--- /dev/null
+++ b/cloudflare_worker/migrations/0035_email_admin.sql
@@ -0,0 +1,70 @@
+-- ForkMesh D1 migration 0035 - encrypted email operations console.
+-- Private recipient and message fields live in encrypted data blobs.
+
+CREATE TABLE IF NOT EXISTS email_recipients (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  email_bi TEXT NOT NULL UNIQUE,
+  data TEXT NOT NULL,
+  created_at INTEGER NOT NULL,
+  updated_at INTEGER NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS email_categories (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  name TEXT NOT NULL COLLATE NOCASE UNIQUE,
+  created_at INTEGER NOT NULL,
+  updated_at INTEGER NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS email_category_memberships (
+  category_id INTEGER NOT NULL,
+  recipient_id INTEGER NOT NULL,
+  created_at INTEGER NOT NULL,
+  PRIMARY KEY (category_id, recipient_id),
+  FOREIGN KEY (category_id) REFERENCES email_categories(id) ON DELETE CASCADE,
+  FOREIGN KEY (recipient_id) REFERENCES email_recipients(id) ON DELETE CASCADE
+);
+
+CREATE INDEX IF NOT EXISTS idx_email_memberships_recipient
+  ON email_category_memberships(recipient_id);
+
+CREATE TABLE IF NOT EXISTS email_templates (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  name TEXT NOT NULL COLLATE NOCASE UNIQUE,
+  data TEXT NOT NULL,
+  is_seeded INTEGER NOT NULL DEFAULT 0,
+  created_at INTEGER NOT NULL,
+  updated_at INTEGER NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS email_campaigns (
+  id TEXT NOT NULL PRIMARY KEY,
+  status TEXT NOT NULL,
+  data TEXT NOT NULL,
+  created_at INTEGER NOT NULL,
+  reviewed_at INTEGER NOT NULL DEFAULT 0,
+  queued_at INTEGER NOT NULL DEFAULT 0,
+  completed_at INTEGER NOT NULL DEFAULT 0
+);
+
+CREATE INDEX IF NOT EXISTS idx_email_campaigns_created
+  ON email_campaigns(created_at DESC);
+
+CREATE TABLE IF NOT EXISTS email_deliveries (
+  id TEXT NOT NULL PRIMARY KEY,
+  campaign_id TEXT NOT NULL,
+  recipient_id INTEGER,
+  status TEXT NOT NULL,
+  data TEXT NOT NULL,
+  attempts INTEGER NOT NULL DEFAULT 0,
+  last_error TEXT NOT NULL DEFAULT '',
+  queued_at INTEGER NOT NULL DEFAULT 0,
+  sent_at INTEGER NOT NULL DEFAULT 0,
+  updated_at INTEGER NOT NULL,
+  UNIQUE (campaign_id, recipient_id),
+  FOREIGN KEY (campaign_id) REFERENCES email_campaigns(id) ON DELETE CASCADE,
+  FOREIGN KEY (recipient_id) REFERENCES email_recipients(id) ON DELETE SET NULL
+);
+
+CREATE INDEX IF NOT EXISTS idx_email_deliveries_campaign_status
+  ON email_deliveries(campaign_id, status);
diff --git a/cloudflare_worker/src/email_admin.py b/cloudflare_worker/src/email_admin.py
new file mode 100644
index 00000000..6730a643
--- /dev/null
+++ b/cloudflare_worker/src/email_admin.py
@@ -0,0 +1,268 @@
+import html
+import json
+import re
+import unicodedata
+
+
+EMAIL_LOCAL_RE = re.compile(r"[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+", re.ASCII)
+EMAIL_DOMAIN_LABEL_RE = re.compile(r"[A-Za-z0-9-]+", re.ASCII)
+PLACEHOLDER_RE = re.compile(r"{{([^{}]*)}}")
+UNSAFE_SEPARATOR_CATEGORIES = frozenset(("Zl", "Zp"))
+ALLOWED_PLACEHOLDERS = frozenset(("name", "company", "email"))
+MAX_RECIPIENT_JSON_CHARS = 1_000_000
+MAX_RECIPIENTS = 5_000
+DEFAULT_CATEGORIES = ("following", "confirmed", "not-responding")
+DEFAULT_TEMPLATES = (
+    {
+        "name": "Sponsorship introduction",
+        "subject": "Partner with ForkMesh",
+        "body": (
+            "Hi {{name}},\n\n"
+            "We are building ForkMesh, an open collaboration network for developers, "
+            "and would love to explore a sponsorship with {{company}}.\n\n"
+            "Would you be open to a short conversation?\n\n"
+            "Best,\nThe ForkMesh founders"
+        ),
+    },
+    {
+        "name": "Partnership outreach",
+        "subject": "A potential ForkMesh partnership",
+        "body": (
+            "Hi {{name}},\n\n"
+            "ForkMesh helps developers collaborate through a distributed network. "
+            "We see a potential partnership with {{company}}.\n\n"
+            "Could we schedule a short introduction?\n\n"
+            "Best,\nThe ForkMesh founders"
+        ),
+    },
+    {
+        "name": "Follow-up",
+        "subject": "Following up on ForkMesh",
+        "body": (
+            "Hi {{name}},\n\n"
+            "We wanted to follow up on our note about ForkMesh and {{company}}. "
+            "If this is relevant, we would be happy to share more context.\n\n"
+            "Best,\nThe ForkMesh founders"
+        ),
+    },
+)
+
+
+def _has_unsafe_text_character(value):
+    for character in value:
+        category = unicodedata.category(character)
+        if category.startswith("C") or category in UNSAFE_SEPARATOR_CATEGORIES:
+            return True
+    return False
+
+
+def normalize_email(value):
+    if not isinstance(value, str):
+        return ""
+    email = value.strip().lower()
+    if (
+        _has_unsafe_text_character(value)
+        or not email.isascii()
+        or len(email) > 254
+        or email.count("@") != 1
+    ):
+        return ""
+
+    local, domain = email.split("@")
+    if (
+        not 1 <= len(local) <= 64
+        or not EMAIL_LOCAL_RE.fullmatch(local)
+        or local.startswith(".")
+        or local.endswith(".")
+        or ".." in local
+        or not 1 <= len(domain) <= 253
+        or "." not in domain
+    ):
+        return ""
+
+    labels = domain.split(".")
+    if any(
+        not 1 <= len(label) <= 63
+        or not EMAIL_DOMAIN_LABEL_RE.fullmatch(label)
+        or label.startswith("-")
+        or label.endswith("-")
+        for label in labels
+    ):
+        return ""
+    return email
+
+
+def _clean_field(value, limit):
+    if value is None:
+        return ""
+    if not isinstance(value, str) or _has_unsafe_text_character(value):
+        return ""
+    return value.strip()[:limit]
+
+
+def _valid_metadata(value):
+    return value is None or (
+        isinstance(value, str) and not _has_unsafe_text_character(value)
+    )
+
+
+def _render_field(value, limit):
+    if not isinstance(value, str):
+        return ""
+    if _has_unsafe_text_character(value):
+        return value
+    return value.strip()[:limit]
+
+
+def dedupe_recipients(recipients):
+    ordered = []
+    by_email = {}
+    for raw in recipients:
+        if not isinstance(raw, dict):
+            continue
+        email = normalize_email(raw.get("email"))
+        if not email:
+            continue
+
+        current = by_email.get(email)
+        if current is None:
+            current = {
+                "email": email,
+                "name": _clean_field(raw.get("name"), 120),
+                "company": _clean_field(raw.get("company"), 160),
+            }
+            by_email[email] = current
+            ordered.append(current)
+            continue
+
+        if not current["name"]:
+            current["name"] = _clean_field(raw.get("name"), 120)
+        if not current["company"]:
+            current["company"] = _clean_field(raw.get("company"), 160)
+    return ordered
+
+
+def _reject_json_constant(_value):
+    raise ValueError("non-finite JSON constant")
+
+
+def parse_recipient_array(raw):
+    if not isinstance(raw, str):
+        return {
+            "recipients": [],
+            "errors": [{"index": -1, "error": "invalid_json"}],
+        }
+    if len(raw) > MAX_RECIPIENT_JSON_CHARS:
+        return {
+            "recipients": [],
+            "errors": [{"index": -1, "error": "payload_too_large"}],
+        }
+
+    try:
+        payload = json.loads(raw, parse_constant=_reject_json_constant)
+    except (TypeError, ValueError):
+        return {
+            "recipients": [],
+            "errors": [{"index": -1, "error": "invalid_json"}],
+        }
+
+    if not isinstance(payload, list):
+        return {
+            "recipients": [],
+            "errors": [{"index": -1, "error": "array_required"}],
+        }
+    if len(payload) > MAX_RECIPIENTS:
+        return {
+            "recipients": [],
+            "errors": [{"index": -1, "error": "recipient_limit_exceeded"}],
+        }
+
+    recipients = []
+    errors = []
+    for index, item in enumerate(payload):
+        if isinstance(item, str):
+            candidate = {"email": item, "name": "", "company": ""}
+        elif isinstance(item, dict):
+            candidate = {
+                "email": item.get("email", ""),
+                "name": item.get("name", ""),
+                "company": item.get("company", ""),
+            }
+        else:
+            errors.append(
+                {
+                    "index": index,
+                    "error": "recipient_must_be_string_or_object",
+                }
+            )
+            continue
+
+        email = normalize_email(candidate["email"])
+        if not email:
+            errors.append({"index": index, "error": "invalid_email"})
+            continue
+
+        metadata_errors = [
+            {"index": index, "error": "invalid_" + field}
+            for field in ("name", "company")
+            if not _valid_metadata(candidate[field])
+        ]
+        if metadata_errors:
+            errors.extend(metadata_errors)
+            continue
+
+        candidate["email"] = email
+        recipients.append(candidate)
+
+    return {"recipients": dedupe_recipients(recipients), "errors": errors}
+
+
+def _replace_placeholders(value, recipient):
+    text = value or ""
+    values = {
+        "name": _render_field(recipient.get("name"), 120) or "there",
+        "company": _render_field(recipient.get("company"), 160) or "your team",
+        "email": normalize_email(recipient.get("email")),
+    }
+    placeholder_names = set()
+    cursor = 0
+    for match in PLACEHOLDER_RE.finditer(text):
+        unmatched = text[cursor : match.start()]
+        if "{{" in unmatched or "}}" in unmatched:
+            raise ValueError("malformed placeholder")
+        placeholder_names.add(match.group(1).strip())
+        cursor = match.end()
+    unmatched = text[cursor:]
+    if "{{" in unmatched or "}}" in unmatched:
+        raise ValueError("malformed placeholder")
+    unknown = sorted(placeholder_names - ALLOWED_PLACEHOLDERS)
+    if unknown:
+        raise ValueError("unknown placeholder: " + unknown[0])
+    return PLACEHOLDER_RE.sub(lambda match: values[match.group(1).strip()], text)
+
+
+def _text_to_html(value):
+    value = value.replace("\r\n", "\n").replace("\r", "\n")
+    paragraphs = []
+    for paragraph in re.split(r"\n\s*\n", value.strip()):
+        escaped = html.escape(paragraph).replace("\n", "<br>")
+        paragraphs.append("<p>" + escaped + "</p>")
+    return "".join(paragraphs)
+
+
+def render_message(subject, body, recipient):
+    rendered_subject = _replace_placeholders(subject, recipient)
+    has_line_boundary = bool(rendered_subject) and rendered_subject.splitlines() != [
+        rendered_subject
+    ]
+    if _has_unsafe_text_character(rendered_subject) or has_line_boundary:
+        raise ValueError("subject must be a single line")
+    rendered_subject = rendered_subject.strip()
+    rendered_text = _replace_placeholders(body, recipient).strip()
+    if not rendered_subject or not rendered_text:
+        raise ValueError("subject and body are required")
+    return {
+        "subject": rendered_subject,
+        "text": rendered_text,
+        "html": _text_to_html(rendered_text),
+    }
