-REPO = Path(__file__).resolve().parent.parent
-BASE = "main"
-HOST, PORT = "127.0.0.1", 8799
-
-DATA_HOME = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
-KEY_PATH = Path(DATA_HOME) / "ForkMesh/ForkMesh/identity/ed25519.pem"
