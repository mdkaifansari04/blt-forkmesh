diff --git a/cloudflare_worker/tests/test_email_admin_domain.py b/cloudflare_worker/tests/test_email_admin_domain.py
new file mode 100644
index 00000000..a81a66b2
--- /dev/null
+++ b/cloudflare_worker/tests/test_email_admin_domain.py
@@ -0,0 +1,511 @@
+import json
+import time
+
+import pytest
+
+from src import email_admin
+from src.email_admin import (
+    ALLOWED_PLACEHOLDERS,
+    DEFAULT_CATEGORIES,
+    DEFAULT_TEMPLATES,
+    dedupe_recipients,
+    normalize_email,
+    parse_recipient_array,
+    render_message,
+)
+
+
+def test_normalize_email_trims_and_lowercases():
+    assert (
+        normalize_email("  User.Tag+News@Sub.Example.COM  ")
+        == "user.tag+news@sub.example.com"
+    )
+
+
+def test_normalize_email_accepts_local_and_total_length_boundaries():
+    longest_local = "A" * 64 + "@Example.com"
+    longest_domain = ".".join(("a" * 63, "b" * 63, "c" * 63, "d" * 60))
+    longest_address = "x@" + longest_domain
+
+    assert len(longest_domain) == 252
+    assert len(longest_address) == 254
+    assert normalize_email(longest_local) == longest_local.lower()
+    assert normalize_email(longest_address) == longest_address
+
+
+@pytest.mark.parametrize(
+    "value",
+    (
+        "",
+        None,
+        "missing-at.example",
+        "a@b",
+        "a b@example.com",
+        "a@b@example.com",
+        "a" * 250 + "@x.io",
+        "a" * 65 + "@example.com",
+        ".person@example.com",
+        "person.@example.com",
+        "first..last@example.com",
+        "person@.example.com",
+        "person@example.com.",
+        "person@example..com",
+        "person@-example.com",
+        "person@example-.com",
+        "person@exa_mple.com",
+        "person@" + "a" * 64 + ".com",
+        "person@example." + "a" * 64,
+        "person\x00@example.com",
+        "person\x7f@example.com",
+        "person@exam\x00ple.com",
+        "t\N{LATIN SMALL LETTER E WITH ACUTE}st@example.com",
+        "person@ex\N{LATIN SMALL LETTER A WITH DIAERESIS}mple.com",
+    ),
+)
+def test_normalize_email_rejects_invalid_values(value):
+    assert normalize_email(value) == ""
+
+
+def test_parse_recipient_array_accepts_mixed_strings_and_objects():
+    parsed = parse_recipient_array(
+        json.dumps(
+            [
+                " A@Example.com ",
+                {
+                    "email": "b@example.com",
+                    "name": "  Bea  ",
+                    "company": "  Orbit  ",
+                },
+            ]
+        )
+    )
+
+    assert parsed == {
+        "recipients": [
+            {"email": "a@example.com", "name": "", "company": ""},
+            {"email": "b@example.com", "name": "Bea", "company": "Orbit"},
+        ],
+        "errors": [],
+    }
+
+
+def test_parse_recipient_array_trims_metadata_to_field_limits():
+    parsed = parse_recipient_array(
+        json.dumps(
+            [
+                {
+                    "email": "person@example.com",
+                    "name": " " + "N" * 125 + " ",
+                    "company": " " + "C" * 165 + " ",
+                }
+            ]
+        )
+    )
+
+    assert parsed["errors"] == []
+    assert parsed["recipients"] == [
+        {
+            "email": "person@example.com",
+            "name": "N" * 120,
+            "company": "C" * 160,
+        }
+    ]
+
+
+@pytest.mark.parametrize(
+    ("field", "value", "error"),
+    (
+        ("name", {"nested": "value"}, "invalid_name"),
+        ("name", ["Pat"], "invalid_name"),
+        ("name", True, "invalid_name"),
+        ("name", 42, "invalid_name"),
+        ("company", {"nested": "value"}, "invalid_company"),
+        ("company", ["Acme"], "invalid_company"),
+        ("company", False, "invalid_company"),
+        ("company", 42, "invalid_company"),
+        ("name", "Pat\r\nBcc: victim@example.com", "invalid_name"),
+        ("name", "Pat\x7f", "invalid_name"),
+        ("company", "Acme\x00Labs", "invalid_company"),
+        ("company", "Acme\nLabs", "invalid_company"),
+    ),
+)
+def test_parse_recipient_array_rejects_invalid_metadata(field, value, error):
+    recipient = {"email": "person@example.com", "name": None, "company": None}
+    recipient[field] = value
+
+    assert parse_recipient_array(json.dumps([recipient])) == {
+        "recipients": [],
+        "errors": [{"index": 0, "error": error}],
+    }
+
+
+@pytest.mark.parametrize("field", ("name", "company"))
+@pytest.mark.parametrize("separator", ("\u0085", "\u2028", "\u2029"))
+def test_parse_recipient_array_rejects_unicode_metadata_controls(field, separator):
+    recipient = {
+        "email": "person@example.com",
+        "name": "Renée",
+        "company": "ForkMesh",
+    }
+    recipient[field] += separator + "injected"
+
+    assert parse_recipient_array(json.dumps([recipient])) == {
+        "recipients": [],
+        "errors": [{"index": 0, "error": "invalid_" + field}],
+    }
+
+
+def test_parse_recipient_array_preserves_valid_unicode_metadata():
+    parsed = parse_recipient_array(
+        json.dumps(
+            [
+                {
+                    "email": "person@example.com",
+                    "name": "Renée 😀",
+                    "company": "Café ForkMesh 🚀",
+                }
+            ]
+        )
+    )
+
+    assert parsed == {
+        "recipients": [
+            {
+                "email": "person@example.com",
+                "name": "Renée 😀",
+                "company": "Café ForkMesh 🚀",
+            }
+        ],
+        "errors": [],
+    }
+
+
+def test_parse_recipient_array_accepts_null_metadata_as_empty():
+    assert parse_recipient_array(
+        '[{"email":"person@example.com","name":null,"company":null}]'
+    ) == {
+        "recipients": [{"email": "person@example.com", "name": "", "company": ""}],
+        "errors": [],
+    }
+
+
+@pytest.mark.parametrize(
+    ("raw", "error"),
+    (
+        ("not-json", "invalid_json"),
+        ('{"email":"person@example.com"}', "array_required"),
+        ('"person@example.com"', "array_required"),
+    ),
+)
+def test_parse_recipient_array_reports_top_level_errors(raw, error):
+    assert parse_recipient_array(raw) == {
+        "recipients": [],
+        "errors": [{"index": -1, "error": error}],
+    }
+
+
+@pytest.mark.parametrize("constant", ("NaN", "Infinity", "-Infinity"))
+def test_parse_recipient_array_rejects_non_finite_json_constants(constant):
+    assert parse_recipient_array("[" + constant + "]") == {
+        "recipients": [],
+        "errors": [{"index": -1, "error": "invalid_json"}],
+    }
+
+
+def test_parse_recipient_array_reports_indexed_invalid_entries():
+    parsed = parse_recipient_array(
+        '["valid@example.com", "broken", 42, {"name":"No email"}]'
+    )
+
+    assert parsed["recipients"] == [
+        {"email": "valid@example.com", "name": "", "company": ""}
+    ]
+    assert parsed["errors"] == [
+        {"index": 1, "error": "invalid_email"},
+        {"index": 2, "error": "recipient_must_be_string_or_object"},
+        {"index": 3, "error": "invalid_email"},
+    ]
+
+
+def test_dedupe_recipients_preserves_order_and_merges_empty_metadata():
+    rows = [
+        {"email": " PERSON@example.com ", "name": "", "company": "Acme"},
+        {"email": "second@example.com", "name": "Sam", "company": ""},
+        {"email": "person@EXAMPLE.com", "name": "Pat", "company": "Other"},
+        {"email": "SECOND@example.com", "name": "Ignored", "company": "Orbit"},
+        {"email": "person@example.com", "name": "Ignored", "company": "Ignored"},
+    ]
+
+    assert dedupe_recipients(rows) == [
+        {"email": "person@example.com", "name": "Pat", "company": "Acme"},
