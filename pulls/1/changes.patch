+bool isSafeRoomChar(QChar ch)
+{
+    const ushort c = ch.unicode();
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+           (c >= '0' && c <= '9') || c == '-' || c == '_';
+}
+
+QString normalizedRoomName(const QString &roomName)
+{
+    const QString trimmed = roomName.trimmed();
+    if (trimmed.isEmpty())
+        return kDefaultRoomName;
+    if (trimmed.size() > kMaxRoomNameChars)
+        return kDefaultRoomName;
+    for (const QChar ch : trimmed) {
+        if (!isSafeRoomChar(ch))
+            return kDefaultRoomName;
+    }
+    return trimmed;
+}
