+import re
+import runpy
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+MIGRATION = ROOT / "migrations" / "0035_email_admin.sql"
+SCHEMA = runpy.run_path(str(ROOT / "src" / "schema.py"))["SCHEMA_STATEMENTS"]
+
+
+TABLES = (
+    "email_recipients",
+    "email_categories",
+    "email_category_memberships",
+    "email_templates",
+    "email_campaigns",
+    "email_deliveries",
+)
+INDEXES = (
+    "idx_email_memberships_recipient",
+    "idx_email_campaigns_created",
+    "idx_email_deliveries_campaign_status",
+)
+PRIVACY_TABLES = (
+    "email_recipients",
+    "email_templates",
+    "email_campaigns",
+    "email_deliveries",
+)
+INDEX_DEFINITIONS = (
+    (
+        "idx_email_memberships_recipient",
+        "email_category_memberships",
+        ("recipient_id",),
+    ),
+    ("idx_email_campaigns_created", "email_campaigns", ("created_at",)),
+    (
+        "idx_email_deliveries_campaign_status",
+        "email_deliveries",
+        ("campaign_id", "status"),
+    ),
+)
+
+
+_CREATE_STATEMENT = re.compile(
+    r"\bCREATE\s+(?:TABLE|INDEX)\s+IF\s+NOT\s+EXISTS\b.*?;",
+    re.IGNORECASE | re.DOTALL,
+)
+_CREATE_NAME = re.compile(
+    r"\bCREATE\s+(?:TABLE|INDEX)\s+IF\s+NOT\s+EXISTS\s+([A-Za-z_]\w*)\b",
+    re.IGNORECASE,
+)
+_SQL_TOKEN = re.compile(
+    r"'(?:''|[^'])*'"
+    r'|"(?:""|[^"])*"'
+    r"|[(),;]"
+    r'''|[^\s(),;'\"]+'''
+)
+
+
+def _normalize_sql(statement):
+    sql = statement.strip()
+    if sql.endswith(";"):
+        sql = sql[:-1].rstrip()
+    return " ".join(_SQL_TOKEN.findall(sql))
+
+
+def _statements_by_name(statements, required_names):
+    required = set(required_names)
+    found = {}
+    for statement in statements:
+        match = _CREATE_NAME.search(statement)
+        if match is None or match.group(1) not in required:
+            continue
+        name = match.group(1)
+        assert name not in found, f"duplicate schema statement for {name}"
+        found[name] = _normalize_sql(statement)
+
+    missing = required - found.keys()
+    assert not missing, f"missing schema statements: {sorted(missing)}"
+    return found
+
+
+def _assert_schema_parity(migration_statements, runtime_statements, required_names):
+    migration = _statements_by_name(migration_statements, required_names)
+    runtime = _statements_by_name(runtime_statements, required_names)
+
+    for name in required_names:
+        assert migration[name] == runtime[name], (
+            f"{name} differs between migration and runtime schema:\n"
+            f"migration: {migration[name]}\n"
+            f"runtime: {runtime[name]}"
+        )
+
+
+@pytest.fixture
+def migrated_db():
+    database = sqlite3.connect(":memory:")
+    database.execute("PRAGMA foreign_keys = ON")
+    database.executescript(MIGRATION.read_text(encoding="utf-8"))
+    try:
+        yield database
+    finally:
+        database.close()
+
+
+def _table_columns(database, table):
+    return {
+        row[1]: row
+        for row in database.execute(f"PRAGMA table_info({table})").fetchall()
+    }
+
+
+@pytest.mark.parametrize(
+    "runtime_statement",
+    (
+        "CREATE TABLE IF NOT EXISTS email_recipients "
+        "(data TEXT NOT NULL, id INTEGER PRIMARY KEY)",
+        "CREATE TABLE IF NOT EXISTS email_recipients "
+        "(id INTEGER PRIMARY KEY, data TEXT)",
+    ),
+)
+def test_schema_parity_checker_rejects_synthetic_drift(runtime_statement):
+    migration_statement = (
+        "CREATE TABLE IF NOT EXISTS email_recipients "
+        "(id INTEGER PRIMARY KEY, data TEXT NOT NULL);"
+    )
+
+    with pytest.raises(AssertionError, match="email_recipients"):
+        _assert_schema_parity(
+            (migration_statement,),
+            (runtime_statement,),
+            ("email_recipients",),
+        )
+
+
+def test_email_admin_migration_and_runtime_schema_match():
+    sql = MIGRATION.read_text(encoding="utf-8")
+    migration_statements = _CREATE_STATEMENT.findall(sql)
+
+    _assert_schema_parity(migration_statements, SCHEMA, TABLES + INDEXES)
+
+
+@pytest.mark.parametrize("table", ("email_campaigns", "email_deliveries"))
+def test_email_text_primary_keys_are_declared_not_null(migrated_db, table):
+    id_column = _table_columns(migrated_db, table)["id"]
+
+    assert id_column[2].upper() == "TEXT"
+    assert id_column[3] == 1
+    assert id_column[5] == 1
+
+
+@pytest.mark.parametrize(
+    ("setup_sql", "insert_sql"),
+    (
+        (
+            "",
+            "INSERT INTO email_campaigns (id,status,data,created_at) "
+            "VALUES (NULL,'draft','encrypted-campaign',1)",
+        ),
+        (
+            """INSERT INTO email_recipients
+                 (email_bi,data,created_at,updated_at)
+                 VALUES ('recipient-bi','encrypted-recipient',1,1);
+               INSERT INTO email_campaigns (id,status,data,created_at)
+                 VALUES ('campaign-1','draft','encrypted-campaign',1);""",
+            """INSERT INTO email_deliveries
+                 (id,campaign_id,recipient_id,status,data,updated_at)
+                 VALUES (NULL,'campaign-1',1,'draft','encrypted-delivery',1)""",
+        ),
+    ),
+)
+def test_email_text_primary_keys_reject_null_inserts(
+    migrated_db, setup_sql, insert_sql
+):
+    migrated_db.executescript(setup_sql)
+
+    with pytest.raises(sqlite3.IntegrityError):
+        migrated_db.execute(insert_sql)
+
+
+def test_delivery_recipient_foreign_key_sets_null_on_delete(migrated_db):
+    recipient_foreign_keys = [
+        row
+        for row in migrated_db.execute(
+            "PRAGMA foreign_key_list(email_deliveries)"
+        ).fetchall()
+        if row[2] == "email_recipients" and row[3] == "recipient_id"
+    ]
+
+    assert _table_columns(migrated_db, "email_deliveries")["recipient_id"][3] == 0
+    assert len(recipient_foreign_keys) == 1
+    assert recipient_foreign_keys[0][6] == "SET NULL"
+
+
+def test_deleting_recipient_retains_delivery_snapshot(migrated_db):
+    recipient_id = migrated_db.execute(
+        """INSERT INTO email_recipients
+             (email_bi,data,created_at,updated_at)
+             VALUES ('recipient-bi','encrypted-recipient',1,1)"""
+    ).lastrowid
+    migrated_db.execute(
+        """INSERT INTO email_campaigns (id,status,data,created_at)
+             VALUES ('campaign-1','draft','encrypted-campaign',1)"""
+    )
+    migrated_db.execute(
+        """INSERT INTO email_deliveries
+             (id,campaign_id,recipient_id,status,data,updated_at)
+             VALUES ('delivery-1','campaign-1',?,'draft','encrypted-delivery',1)""",
+        (recipient_id,),
+    )
+
+    migrated_db.execute(
+        "DELETE FROM email_recipients WHERE id=?", (recipient_id,)
+    )
+
+    delivery = migrated_db.execute(
+        """SELECT id,campaign_id,recipient_id,data
+             FROM email_deliveries WHERE id='delivery-1'"""
+    ).fetchone()
+    assert delivery == (
+        "delivery-1",
+        "campaign-1",
+        None,
+        "encrypted-delivery",
+    )
+
+
+@pytest.mark.parametrize("table", PRIVACY_TABLES)
+def test_privacy_tables_require_encrypted_data(migrated_db, table):
+    data_column = _table_columns(migrated_db, table).get("data")
+
+    assert data_column is not None
+    assert data_column[2].upper() == "TEXT"
+    assert data_column[3] == 1
+
+
+@pytest.mark.parametrize(
+    ("index_name", "table", "expected_columns"), INDEX_DEFINITIONS
+)
+def test_email_admin_indexes_cover_expected_columns(
+    migrated_db, index_name, table, expected_columns
+):
+    index_table = migrated_db.execute(
+        "SELECT tbl_name FROM sqlite_master WHERE type='index' AND name=?",
+        (index_name,),
+    ).fetchone()
+    index_columns = tuple(
+        row[2]
+        for row in migrated_db.execute(
+            f"PRAGMA index_info({index_name})"
+        ).fetchall()
+    )
+
+    assert index_table == (table,)
+    assert index_columns == expected_columns
+
+
+def test_email_admin_schema_has_privacy_and_deduplication_constraints():
+    sql = MIGRATION.read_text(encoding="utf-8")
+    assert "email_bi TEXT NOT NULL UNIQUE" in sql
+    assert "data TEXT NOT NULL" in sql
+    assert "PRIMARY KEY (category_id, recipient_id)" in sql
+    assert "UNIQUE (campaign_id, recipient_id)" in sql
+    assert "idx_email_deliveries_campaign_status" in sql
