+def _email_admin_icon(name):
+    path = EMAIL_ADMIN_ICON_PATHS.get(name, "")
+    return (
+        '<svg class="icon icon-'
+        + html.escape(str(name), quote=True)
+        + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" '
+        'stroke-width="2" stroke-linecap="round" stroke-linejoin="round" '
+        'aria-hidden="true">'
+        + path
+        + "</svg>"
+    )
+
+
+def _theme_toggle():
+    return (
+        '<button class="theme-toggle secondary" data-theme-toggle type="button" '
+        'aria-label="Switch to light mode" aria-pressed="false" '
+        'title="Switch to light mode"><span class="theme-icon theme-icon-sun">'
+        + _email_admin_icon("sun")
+        + '</span><span class="theme-icon theme-icon-moon">'
+        + _email_admin_icon("moon")
+        + '</span><span class="theme-toggle-label">Theme</span></button>'
+    )
+
+
+def _outreach_identity(class_name="identity"):
+    return (
+        '<div class="'
+        + html.escape(str(class_name), quote=True)
+        + '"><span class="brand-mark">'
+        + _email_admin_icon("network")
