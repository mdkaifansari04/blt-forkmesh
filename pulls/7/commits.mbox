@@ -20,6 +26,84 @@
   const EMAIL_LOCAL = /^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+$/;
   const EMAIL_DOMAIN_LABEL = /^[A-Za-z0-9-]+$/;
   const UNSAFE_TEXT = /[\p{C}\p{Zl}\p{Zp}]/u;
+  const DASHBOARD_THEME_KEY = "forkmesh.dashboard.theme";
+  const SITE_THEME_KEY = "forkmesh.theme";
+
+  function normalizeTheme(value) {
+    return value === "light" ? "light" : "dark";
+  }
+
+  function readTheme(storage) {
+    try {
+      if (!storage) return "dark";
+      return normalizeTheme(
+        storage.getItem(DASHBOARD_THEME_KEY) || storage.getItem(SITE_THEME_KEY)
+      );
+    } catch (_) {
+      return "dark";
+    }
+  }
+
+  function applyTheme(document, value) {
+    const theme = normalizeTheme(value);
+    if (!document || !document.documentElement) return theme;
+
+    document.documentElement.dataset.emailAdminTheme = theme;
+    document.documentElement.style.colorScheme = theme;
+
+    const meta = document.querySelector('meta[name="theme-color"]');
+    if (meta) {
+      meta.setAttribute(
+        "content",
+        theme === "light" ? "#f6f8fb" : "#090909"
+      );
+    }
+
+    const button = document.querySelector("[data-theme-toggle]");
+    if (button) {
+      const label =
+        theme === "light" ? "Switch to dark mode" : "Switch to light mode";
+      button.dataset.theme = theme;
+      button.setAttribute("aria-label", label);
+      button.setAttribute("aria-pressed", theme === "light" ? "true" : "false");
+      button.title = label;
+    }
+    return theme;
+  }
+
+  function saveTheme(storage, document, value) {
+    const theme = normalizeTheme(value);
+    try {
+      if (storage) {
+        storage.setItem(DASHBOARD_THEME_KEY, theme);
+        storage.setItem(SITE_THEME_KEY, theme);
+      }
+    } catch (_) {}
+    return applyTheme(document, theme);
+  }
+
+  function toggleTheme(storage, document) {
+    const current =
+      document && document.documentElement
+        ? normalizeTheme(document.documentElement.dataset.emailAdminTheme)
+        : readTheme(storage);
+    return saveTheme(
+      storage,
+      document,
+      current === "light" ? "dark" : "light"
+    );
+  }
+
+  function bindTheme(document, storage) {
+    if (!document || !document.documentElement) return false;
+    applyTheme(document, readTheme(storage));
+    const button = document.querySelector("[data-theme-toggle]");
+    if (!button) return false;
+    button.addEventListener("click", function () {
+      toggleTheme(storage, document);
+    });
+    return true;
+  }
 
   function normalizeEmail(value) {
     if (typeof value !== "string" || UNSAFE_TEXT.test(value)) return "";
@@ -388,6 +472,12 @@
