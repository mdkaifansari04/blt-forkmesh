@@ -0,0 +1,38 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:forkmesh/core/platform/app_directories.dart';
+import 'package:forkmesh/features/nodes/domain/node_identity.dart';
+import 'package:forkmesh/features/repositories/data/local_repository_runtime.dart';
+import 'package:forkmesh/features/repositories/domain/local_git_capabilities.dart';
+
+void main() {
+  test(
+    'bootstraps recovered local storage with remote capabilities disabled',
+    () async {
+      final root = await Directory.systemTemp.createTemp(
+        'forkmesh-phase2a-runtime-',
+      );
+      addTearDown(() => root.delete(recursive: true));
+      final runtime = await Phase2ALocalRuntime.bootstrap(
+        directories: FixedAppDirectories(root),
+        nodeIdentity: NodeIdentity(
+          nodeId:
+              'fmnode_${NodeIdentity.canonicalBase64Url(List<int>.filled(16, 1))}',
+          publicKey: NodeIdentity.canonicalBase64Url(List<int>.filled(32, 2)),
+        ),
+      );
+
+      expect(
+        runtime.capabilities
+            .statusFor(LocalGitCapability.localRepository)
+            .enabled,
+        isTrue,
+      );
+      expect(
+        runtime.capabilities.statusFor(LocalGitCapability.clone).reason,
+        LocalGitDisableReason.awaitingIndependentCryptographyReview,
+      );
+    },
+  );
+}
diff --git a/flutter_app/test/phase2a_owned_git_adapter_test.dart b/flutter_app/test/phase2a_owned_git_adapter_test.dart
new file mode 100644
index 00000000..dea2f56e
--- /dev/null
+++ b/flutter_app/test/phase2a_owned_git_adapter_test.dart
@@ -0,0 +1,96 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:forkmesh/core/platform/app_directories.dart';
+import 'package:forkmesh/features/nodes/domain/node_identity.dart';
+import 'package:forkmesh/features/repositories/data/local_repository_store.dart';
+import 'package:forkmesh/features/repositories/data/owned_git_engine_adapter.dart';
+import 'package:forkmesh/features/repositories/domain/local_git_capabilities.dart';
+
+void main() {
+  late Directory root;
+  late OwnedGitEngineAdapter adapter;
+
+  setUp(() async {
+    root = await Directory.systemTemp.createTemp('forkmesh-phase2a-git-');
+    adapter = OwnedGitEngineAdapter(
+      LocalRepositoryStore(
+        directories: FixedAppDirectories(root),
+        nodeIdentity: NodeIdentity(
+          nodeId:
+              'fmnode_${NodeIdentity.canonicalBase64Url(List<int>.filled(16, 1))}',
+          publicKey: NodeIdentity.canonicalBase64Url(List<int>.filled(32, 2)),
+        ),
+        repositoryIdGenerator: () =>
+            'fmrepo_${NodeIdentity.canonicalBase64Url(List<int>.filled(16, 3))}',
+        replicaIdGenerator: () =>
+            'fmreplica_${NodeIdentity.canonicalBase64Url(List<int>.filled(16, 4))}',
+        clock: () => 1,
+      ),
+    );
+  });
+
+  tearDown(() => root.delete(recursive: true));
+
+  test(
+    'authors and reopens text and binary history through the owned adapter',
+    () async {
+      final local = await adapter.initializeLocal(createdBy: 'ada');
+      await File(
+        '${local.worktree.path}${Platform.pathSeparator}note.txt',
+      ).writeAsString('local\n');
+      await File(
+        '${local.worktree.path}${Platform.pathSeparator}binary.bin',
+      ).writeAsBytes(<int>[0, 1, 255]);
+
+      await local.stage(<String>['note.txt', 'binary.bin']);
+      final commit = await local.commit(
+        message: 'Local-only commit\n',
+        authorName: 'Ada',
+        authorEmail: 'ada@example.test',
+        timestampSeconds: 0,
+      );
+      expect((await local.status()).isClean, isTrue);
+      await local.createBranch('feature');
+      await local.checkout('feature');
+      await local.dispose();
+
+      final reopened = await adapter.openLocal(local.repoId);
+      final history = await reopened.history();
+
+      expect(history.first.objectId, commit);
+      expect(history.first.message, 'Local-only commit\n');
+      expect(history, hasLength(2));
+      expect(await reopened.readBlobFromHead('binary.bin'), <int>[0, 1, 255]);
+      expect((await reopened.status()).isClean, isTrue);
+    },
+  );
+
+  test(
+    'denies every remote and untrusted operation below the UI boundary',
+    () async {
+      for (final operation in <Future<void> Function()>[
+        adapter.clone,
+        adapter.fetch,
+        adapter.push,
+        adapter.importRemoteRepository,
+        adapter.hostRemoteRepository,
+        adapter.installUntrustedSha1Object,
+      ]) {
+        await expectLater(
+          operation,
+          throwsA(
+            isA<LocalGitCapabilityException>().having(
+              (error) => error.reason,
+              'reason',
+              anyOf(
+                LocalGitDisableReason.awaitingIndependentCryptographyReview,
+                LocalGitDisableReason.phaseNotImplemented,
+              ),
+            ),
+          ),
+        );
+      }
+    },
+  );
+}
diff --git a/flutter_app/test/phase2a_secure_migration_test.dart b/flutter_app/test/phase2a_secure_migration_test.dart
new file mode 100644
index 00000000..ede516d6
--- /dev/null
+++ b/flutter_app/test/phase2a_secure_migration_test.dart
@@ -0,0 +1,167 @@
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:forkmesh/core/security/secure_store.dart';
+import 'package:forkmesh/features/nodes/data/node_identity_store.dart';
+import 'package:forkmesh/services/auth_service.dart';
+import 'package:forkmesh/services/identity.dart';
+import 'package:forkmesh/services/settings_service.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+void main() {
+  test(
+    'verified seed and token migration survive restart while logout preserves identity',
+    () async {
+      final seed = List<int>.generate(32, (index) => index);
+      SharedPreferences.setMockInitialValues(<String, Object>{
+        'identity/ed25519Seed': base64.encode(seed),
+        'auth/session': jsonEncode(<String, Object>{
+          'nodeName': 'ada',
+          'email': 'ada@example.test',
+          'sessionToken': 'account-session-secret',
+        }),
+      });
+      final preferences = await SharedPreferences.getInstance();
+      final secureStore = InMemorySecureStore();
+      final identityStore = NodeIdentityStore(
+        secureStore: secureStore,
+        preferences: preferences,
+      );
+
+      final first = await Identity.loadOrCreate(store: identityStore);
+      final settings = SettingsService(preferences);
+      final auth = await AuthService.create(
+        settings,
+        first,
+        secureStore: secureStore,
+      );
+
+      expect(await secureStore.read(SecureStoreKey.nodeSeed), seed);
+      expect(
+        await secureStore.read(SecureStoreKey.accountSessionToken),
+        utf8.encode('account-session-secret'),
+      );
+      expect(preferences.containsKey('identity/ed25519Seed'), isFalse);
+      final storedSession = jsonDecode(preferences.getString('auth/session')!);
+      expect(storedSession, isA<Map<String, dynamic>>());
+      expect(storedSession, isNot(contains('sessionToken')));
+      expect(auth.session!.sessionToken, 'account-session-secret');
+
+      final restarted = await Identity.loadOrCreate(
+        store: NodeIdentityStore(
+          secureStore: secureStore,
+          preferences: preferences,
+        ),
+      );
+      expect(restarted.nodeId, first.nodeId);
+      expect(restarted.publicKeyB64url, first.publicKeyB64url);
+
+      final restartedAuth = await AuthService.create(
+        SettingsService(preferences),
+        restarted,
+        secureStore: secureStore,
+      );
+      expect(restartedAuth.session!.nodeName, 'ada');
+      expect(restartedAuth.session!.sessionToken, 'account-session-secret');
+
+      await auth.logout();
+
+      expect(
+        await secureStore.read(SecureStoreKey.accountSessionToken),
+        isNull,
+      );
+      expect(await secureStore.read(SecureStoreKey.nodeSeed), seed);
+    },
+  );
+
+  test(
+    'mismatched secure and legacy seeds fail closed without rotation',
+    () async {
+      final secureStore = InMemorySecureStore();
+      await secureStore.write(
+        SecureStoreKey.nodeSeed,
+        List<int>.filled(32, 1),
+        accessibility: SecureStoreAccessibility.afterFirstUnlockThisDeviceOnly,
+      );
+      SharedPreferences.setMockInitialValues(<String, Object>{
+        'identity/ed25519Seed': base64.encode(List<int>.filled(32, 2)),
+      });
+      final preferences = await SharedPreferences.getInstance();
+
+      await expectLater(
+        () => Identity.loadOrCreate(
+          store: NodeIdentityStore(
+            secureStore: secureStore,
+            preferences: preferences,
+          ),
+        ),
+        throwsA(
+          isA<NodeIdentityStoreException>().having(
+            (error) => error.code,
+            'code',
+            NodeIdentityStoreErrorCode.seedConflict,
+          ),
+        ),
+      );
+      expect(
+        await secureStore.read(SecureStoreKey.nodeSeed),
+        List<int>.filled(32, 1),
+      );
+      expect(preferences.containsKey('identity/ed25519Seed'), isTrue);
+    },
+  );
+
+  test(
+    'does not rewrite a legacy session after a failed secure write',
+    () async {
+      final legacySession = jsonEncode(<String, Object>{
+        'nodeName': 'ada',
+        'email': 'ada@example.test',
+        'sessionToken': 'account-session-secret',
+      });
+      SharedPreferences.setMockInitialValues(<String, Object>{
+        'auth/session': legacySession,
+      });
+      final preferences = await SharedPreferences.getInstance();
+      final secureStore = _FailingWriteSecureStore();
+      final identity = await Identity.loadOrCreate(
+        store: NodeIdentityStore(
+          secureStore: InMemorySecureStore(),
+          preferences: preferences,
+        ),
+      );
+
+      await expectLater(
+        () => AuthService.create(
+          SettingsService(preferences),
+          identity,
+          secureStore: secureStore,
+        ),
+        throwsA(isA<SecureStoreException>()),
+      );
+      expect(preferences.getString('auth/session'), legacySession);
+    },
+  );
+}
+
