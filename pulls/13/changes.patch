diff --git a/flutter_app/test/phase2a_local_repository_store_test.dart b/flutter_app/test/phase2a_local_repository_store_test.dart
new file mode 100644
index 00000000..0cdbba3f
--- /dev/null
+++ b/flutter_app/test/phase2a_local_repository_store_test.dart
@@ -0,0 +1,168 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:forkmesh/core/platform/app_directories.dart';
+import 'package:forkmesh/features/nodes/domain/node_identity.dart';
+import 'package:forkmesh/features/repositories/data/local_repository_store.dart';
+
+void main() {
+  late Directory root;
+  late LocalRepositoryStore store;
+
+  setUp(() async {
+    root = await Directory.systemTemp.createTemp('forkmesh-phase2a-store-');
+    final node = NodeIdentity(
+      nodeId:
+          'fmnode_${NodeIdentity.canonicalBase64Url(List<int>.filled(16, 1))}',
+      publicKey: NodeIdentity.canonicalBase64Url(List<int>.filled(32, 2)),
+    );
+    store = LocalRepositoryStore(
+      directories: FixedAppDirectories(root),
+      nodeIdentity: node,
+      repositoryIdGenerator: () =>
+          'fmrepo_${NodeIdentity.canonicalBase64Url(List<int>.filled(16, 3))}',
+      replicaIdGenerator: () =>
+          'fmreplica_${NodeIdentity.canonicalBase64Url(List<int>.filled(16, 4))}',
+      clock: () => 1,
+    );
+  });
+
+  tearDown(() => root.delete(recursive: true));
+
+  test(
+    'creates and reopens an app-owned manifest and one local replica',
+    () async {
+      final created = await store.create(createdBy: 'ada');
+      final manifestFile = File(
+        '${created.worktree.path}${Platform.pathSeparator}.forkmesh'
+        '${Platform.pathSeparator}repository.json',
+      );
+      final manifest = jsonDecode(await manifestFile.readAsString());
+
+      expect(manifest, <String, Object>{
+        'version': 1,
+        'repoId': created.repository.repoId,
+        'createdBy': 'ada',
+        'createdAt': 1,
+        'defaultBranch': 'main',
+      });
+      expect(created.replica.repoId, created.repository.repoId);
+      expect(created.replica.nodeId, created.nodeIdentity.nodeId);
+
+      final reopened = await store.open(created.repository.repoId);
+
+      expect(reopened.repository.repoId, created.repository.repoId);
+      expect(reopened.replica.replicaId, created.replica.replicaId);
+      expect(reopened.worktree.path, created.worktree.path);
+    },
+  );
+
+  test('rejects a duplicate creation without replacing the manifest', () async {
+    final created = await store.create(createdBy: 'ada');
+    final manifestFile = File(
+      '${created.worktree.path}${Platform.pathSeparator}.forkmesh'
+      '${Platform.pathSeparator}repository.json',
+    );
+    final before = await manifestFile.readAsString();
+
+    await expectLater(
+      () => store.create(createdBy: 'ada'),
+      throwsA(isA<LocalRepositoryStoreException>()),
+    );
+
+    expect(await manifestFile.readAsString(), before);
+  });
+
+  test('fails closed for malformed manifests and path traversal', () async {
+    final created = await store.create(createdBy: 'ada');
+    final manifestFile = File(
+      '${created.worktree.path}${Platform.pathSeparator}.forkmesh'
+      '${Platform.pathSeparator}repository.json',
+    );
+    await manifestFile.writeAsString('{"repoId":"different"}');
+    final before = await manifestFile.readAsString();
+
+    await expectLater(
+      () => store.open(created.repository.repoId),
+      throwsA(isA<LocalRepositoryStoreException>()),
+    );
+    expect(await manifestFile.readAsString(), before);
+    await expectLater(
+      () => FixedAppDirectories(root).repositoryRootFor('../outside'),
+      throwsA(isA<AppDirectoryException>()),
+    );
+  });
+
+  test('rejects a repository-root symlink escape without opening it', () async {
+    const repoId = 'fmrepo_AwMDAwMDAwMDAwMDAwMDAw';
+    final directories = FixedAppDirectories(root);
+    final repositoryRoot = await directories.repositoryRootFor(repoId);
+    await repositoryRoot.delete(recursive: true);
+    final outside = await Directory.systemTemp.createTemp(
+      'forkmesh-phase2a-outside-',
+    );
+    addTearDown(() => outside.delete(recursive: true));
+    await Link(repositoryRoot.path).create(outside.path);
+
+    await expectLater(
+      () => store.open(repoId),
+      throwsA(isA<AppDirectoryException>()),
+    );
+  });
+
+  test(
+    'recovers an interrupted local repository creation before use',
+    () async {
+      const repoId = 'fmrepo_AwMDAwMDAwMDAwMDAwMDAw';
+      final partialRoot = await FixedAppDirectories(
+        root,
+      ).repositoryRootFor(repoId);
+      final journal = File(
+        '${partialRoot.path}${Platform.pathSeparator}operation.json',
+      );
+      await journal.writeAsString(
+        jsonEncode(<String, Object>{
+          'version': 1,
+          'operation': 'create',
+          'repoId': repoId,
+        }),
+        flush: true,
+      );
+
+      await store.recover();
+
+      expect(await partialRoot.exists(), isFalse);
+    },
+  );
+
+  test('removes a local replica only after explicit local intent', () async {
+    final created = await store.create(createdBy: 'ada');
+
+    await store.removeLocalReplica(
+      created,
+      intent: LocalReplicaDeletionIntent.removeLocalReplica,
+    );
+
+    expect(await created.root.exists(), isFalse);
+  });
+
+  test('recovers an interrupted local replica deletion before use', () async {
+    final created = await store.create(createdBy: 'ada');
+    final journal = File(
+      '${created.root.path}${Platform.pathSeparator}operation.json',
+    );
+    await journal.writeAsString(
+      jsonEncode(<String, Object>{
+        'version': 1,
+        'operation': 'delete',
+        'repoId': created.repository.repoId,
+      }),
+      flush: true,
+    );
+
+    await store.recover();
+
+    expect(await created.root.exists(), isFalse);
+  });
+}
