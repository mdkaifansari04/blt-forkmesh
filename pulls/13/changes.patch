@@ -0,0 +1,46 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:forkmesh/core/platform/app_directories.dart';
+import 'package:forkmesh/core/security/secure_store.dart';
+import 'package:integration_test/integration_test.dart';
+
+void main() {
+  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+
+  testWidgets(
+    'uses iOS Keychain and Application Support without persistence leaks',
+    (tester) async {
+      expect(Platform.isIOS, isTrue);
+      final secureStore = MethodChannelSecureStore.forCurrentPlatform();
+
+      await secureStore.write(
+        SecureStoreKey.accountSessionToken,
+        <int>[1, 2, 3, 4],
+        accessibility: SecureStoreAccessibility.afterFirstUnlockThisDeviceOnly,
+      );
+      expect(
+        await secureStore.contains(SecureStoreKey.accountSessionToken),
+        isTrue,
+      );
+      expect(await secureStore.read(SecureStoreKey.accountSessionToken), <int>[
+        1,
+        2,
+        3,
+        4,
+      ]);
+      await secureStore.delete(SecureStoreKey.accountSessionToken);
+      expect(
+        await secureStore.read(SecureStoreKey.accountSessionToken),
+        isNull,
+      );
+
+      final directories = await AppDirectories.forCurrentPlatform();
+      final repositoryRoot = await directories.repositoryRootFor(
+        'fmrepo_AAAAAAAAAAAAAAAAAAAAAA',
+      );
+      expect(await repositoryRoot.exists(), isTrue);
+      expect(repositoryRoot.path.contains('/Documents/'), isFalse);
+    },
+  );
+}
diff --git a/flutter_app/integration_test/phase2a_ios_local_repository_probe_test.dart b/flutter_app/integration_test/phase2a_ios_local_repository_probe_test.dart
new file mode 100644
index 00000000..e72d6df2
--- /dev/null
+++ b/flutter_app/integration_test/phase2a_ios_local_repository_probe_test.dart
@@ -0,0 +1,129 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:forkmesh/core/platform/app_directories.dart';
+import 'package:forkmesh/core/security/secure_store.dart';
+import 'package:forkmesh/features/nodes/data/node_identity_store.dart';
+import 'package:forkmesh/features/repositories/data/local_repository_runtime.dart';
+import 'package:forkmesh/features/repositories/data/local_repository_store.dart';
+import 'package:forkmesh/features/repositories/domain/local_git_capabilities.dart';
+import 'package:forkmesh/services/auth_service.dart';
+import 'package:forkmesh/services/identity.dart';
+import 'package:forkmesh/services/settings_service.dart';
+import 'package:integration_test/integration_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+void main() {
+  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+
+  testWidgets(
+    'migrates local identity and authors an offline repository on iOS',
+    (tester) async {
+      expect(Platform.isIOS, isTrue);
+      final secureStore = MethodChannelSecureStore.forCurrentPlatform();
+      final preferences = await SharedPreferences.getInstance();
+      addTearDown(() async {
+        await secureStore.delete(SecureStoreKey.nodeSeed);
+        await secureStore.delete(SecureStoreKey.accountSessionToken);
+        await preferences.remove(NodeIdentityStore.legacySeedKey);
+        await preferences.remove(NodeIdentityStore.metadataKey);
+        await preferences.remove('auth/session');
+      });
+      await secureStore.delete(SecureStoreKey.nodeSeed);
+      await secureStore.delete(SecureStoreKey.accountSessionToken);
+      await preferences.remove(NodeIdentityStore.metadataKey);
+      final seed = List<int>.generate(32, (index) => index);
+      await preferences.setString(
+        NodeIdentityStore.legacySeedKey,
+        base64.encode(seed),
+      );
+      await preferences.setString(
+        'auth/session',
+        jsonEncode(<String, Object>{
+          'nodeName': 'ios-probe',
+          'email': 'ios-probe@example.test',
+          'sessionToken': 'simulator-session-token',
+        }),
+      );
+
+      final identity = await Identity.loadOrCreate(
+        store: NodeIdentityStore(
+          secureStore: secureStore,
+          preferences: preferences,
+        ),
+      );
+      final auth = await AuthService.create(
+        SettingsService(preferences),
+        identity,
+        secureStore: secureStore,
+      );
+      expect(identity.nodeId, startsWith('fmnode_'));
+      expect(auth.session!.sessionToken, 'simulator-session-token');
+      expect(preferences.containsKey(NodeIdentityStore.legacySeedKey), isFalse);
+      expect(
+        jsonDecode(preferences.getString('auth/session')!),
+        isNot(contains('sessionToken')),
+      );
+
+      final restarted = await Identity.loadOrCreate(
+        store: NodeIdentityStore(
+          secureStore: secureStore,
+          preferences: preferences,
+        ),
+      );
+      expect(restarted.nodeId, identity.nodeId);
+      expect(restarted.publicKeyB64url, identity.publicKeyB64url);
+
+      final runtime = await Phase2ALocalRuntime.bootstrap(
+        directories: await AppDirectories.forCurrentPlatform(),
+        nodeIdentity: identity.nodeIdentity,
+      );
+      final local = await runtime.git.initializeLocal(createdBy: 'ios-probe');
+      await File(
+        '${local.worktree.path}${Platform.pathSeparator}note.txt',
+      ).writeAsString('offline iOS authoring\n');
+      await File(
+        '${local.worktree.path}${Platform.pathSeparator}binary.bin',
+      ).writeAsBytes(<int>[0, 1, 255]);
+      await local.stage(<String>['note.txt', 'binary.bin']);
+      final commit = await local.commit(
+        message: 'iOS local commit\n',
+        authorName: 'iOS Probe',
+        authorEmail: 'ios-probe@example.test',
+        timestampSeconds: 0,
+      );
+      await local.createBranch('offline');
+      await local.checkout('offline');
+      await local.dispose();
+
+      final reopened = await runtime.git.openLocal(local.repoId);
+      expect((await reopened.history()).first.objectId, commit);
+      expect(await reopened.readBlobFromHead('binary.bin'), <int>[0, 1, 255]);
+      expect((await reopened.status()).isClean, isTrue);
+      for (final operation in <Future<void> Function()>[
+        runtime.git.clone,
+        runtime.git.fetch,
+        runtime.git.push,
+        runtime.git.importRemoteRepository,
+        runtime.git.hostRemoteRepository,
+        runtime.git.installUntrustedSha1Object,
+      ]) {
+        await expectLater(
+          operation,
+          throwsA(isA<LocalGitCapabilityException>()),
+        );
+      }
+      await reopened.dispose();
+      await reopened.removeLocalReplica(
+        intent: LocalReplicaDeletionIntent.removeLocalReplica,
+      );
+      await auth.logout();
+      expect(
+        await secureStore.read(SecureStoreKey.accountSessionToken),
+        isNull,
+      );
+      expect((await secureStore.read(SecureStoreKey.nodeSeed))!.length, 32);
+    },
+  );
+}
