@@ -0,0 +1,32 @@
+import Flutter
+import Foundation
+
+enum ForkMeshAppDirectories {
+  private static let channelName = "dev.forkmesh.platform/directories-v1"
+
+  static func register(with messenger: FlutterBinaryMessenger) {
+    let channel = FlutterMethodChannel(name: channelName, binaryMessenger: messenger)
+    channel.setMethodCallHandler { call, result in
+      guard call.method == "appDirectories.applicationSupport" else {
+        result(FlutterMethodNotImplemented)
+        return
+      }
+      guard let directory = FileManager.default.urls(
+        for: .applicationSupportDirectory,
+        in: .userDomainMask
+      ).first else {
+        result(FlutterError(code: "unavailable", message: "Application Support is unavailable.", details: nil))
+        return
+      }
+      do {
+        try FileManager.default.createDirectory(
+          at: directory,
+          withIntermediateDirectories: true
+        )
+        result(directory.path)
+      } catch {
+        result(FlutterError(code: "unavailable", message: "Application Support is unavailable.", details: nil))
+      }
+    }
+  }
+}
diff --git a/flutter_app/ios/Runner/ForkMeshSecureStore.swift b/flutter_app/ios/Runner/ForkMeshSecureStore.swift
new file mode 100644
index 00000000..a7591121
--- /dev/null
+++ b/flutter_app/ios/Runner/ForkMeshSecureStore.swift
@@ -0,0 +1,142 @@
+import Flutter
+import Security
+
+enum ForkMeshSecureStore {
+  private static let channelName = "dev.forkmesh.platform/security-v1"
+  private static let service = "dev.forkmesh.secure-store.v1"
+  private static let allowedAccounts: Set<String> = [
+    "identity.ed25519.seed.v1",
+    "auth.account-session-token.v1",
+  ]
+
+  static func register(with messenger: FlutterBinaryMessenger) {
+    let channel = FlutterMethodChannel(name: channelName, binaryMessenger: messenger)
+    channel.setMethodCallHandler { call, result in
+      switch call.method {
+      case "secureStore.read":
+        read(call, result: result)
+      case "secureStore.write":
+        write(call, result: result)
+      case "secureStore.delete":
+        delete(call, result: result)
+      case "secureStore.contains":
+        contains(call, result: result)
+      default:
+        result(FlutterMethodNotImplemented)
+      }
+    }
+  }
+
+  private static func account(_ call: FlutterMethodCall, result: FlutterResult) -> String? {
+    guard let arguments = call.arguments as? [String: Any],
+          let account = arguments["key"] as? String,
+          allowedAccounts.contains(account) else {
+      result(FlutterError(code: "malformed", message: "Invalid secure-store request.", details: nil))
+      return nil
+    }
+    return account
+  }
+
+  private static func baseQuery(_ account: String) -> [String: Any] {
+    return [
+      kSecClass as String: kSecClassGenericPassword,
+      kSecAttrService as String: service,
+      kSecAttrAccount as String: account,
+      kSecAttrSynchronizable as String: kCFBooleanFalse as Any,
+    ]
+  }
+
+  private static func read(_ call: FlutterMethodCall, result: @escaping FlutterResult) {
+    guard let account = account(call, result: result) else { return }
+    var query = baseQuery(account)
+    query[kSecReturnData as String] = kCFBooleanTrue
+    query[kSecMatchLimit as String] = kSecMatchLimitOne
+    var output: CFTypeRef?
+    let status = SecItemCopyMatching(query as CFDictionary, &output)
+    if status == errSecItemNotFound {
+      result(["state": "missing"])
+      return
+    }
+    guard status == errSecSuccess, let data = output as? Data else {
+      result(error(for: status))
+      return
+    }
+    result(["state": "found", "value": FlutterStandardTypedData(bytes: data)])
+  }
+
+  private static func write(_ call: FlutterMethodCall, result: @escaping FlutterResult) {
+    guard let account = account(call, result: result),
+          let arguments = call.arguments as? [String: Any],
+          let typedData = arguments["value"] as? FlutterStandardTypedData,
+          typedData.data.count > 0,
+          typedData.data.count <= 4096,
+          arguments["accessibility"] as? String == "afterFirstUnlockThisDeviceOnly" else {
+      result(FlutterError(code: "malformed", message: "Invalid secure-store write.", details: nil))
+      return
+    }
+    let attributes: [String: Any] = [
+      kSecValueData as String: typedData.data,
+      kSecAttrAccessible as String: kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly,
+    ]
+    let updateStatus = SecItemUpdate(baseQuery(account) as CFDictionary, attributes as CFDictionary)
+    if updateStatus == errSecSuccess {
+      result(nil)
+      return
+    }
+    guard updateStatus == errSecItemNotFound else {
+      result(error(for: updateStatus))
+      return
+    }
+    var addQuery = baseQuery(account)
+    for (key, value) in attributes {
+      addQuery[key] = value
+    }
+    let addStatus = SecItemAdd(addQuery as CFDictionary, nil)
+    if addStatus == errSecSuccess {
+      result(nil)
+    } else if addStatus == errSecDuplicateItem {
+      let retryStatus = SecItemUpdate(baseQuery(account) as CFDictionary, attributes as CFDictionary)
+      retryStatus == errSecSuccess ? result(nil) : result(error(for: retryStatus))
+    } else {
+      result(error(for: addStatus))
+    }
+  }
+
+  private static func delete(_ call: FlutterMethodCall, result: @escaping FlutterResult) {
+    guard let account = account(call, result: result) else { return }
+    let status = SecItemDelete(baseQuery(account) as CFDictionary)
+    if status == errSecSuccess || status == errSecItemNotFound {
+      result(nil)
+    } else {
+      result(error(for: status))
+    }
+  }
+
+  private static func contains(_ call: FlutterMethodCall, result: @escaping FlutterResult) {
+    guard let account = account(call, result: result) else { return }
+    var query = baseQuery(account)
+    query[kSecReturnAttributes as String] = kCFBooleanTrue
+    query[kSecMatchLimit as String] = kSecMatchLimitOne
+    let status = SecItemCopyMatching(query as CFDictionary, nil)
+    if status == errSecSuccess {
+      result(true)
+    } else if status == errSecItemNotFound {
+      result(false)
+    } else {
+      result(error(for: status))
+    }
+  }
+
+  private static func error(for status: OSStatus) -> FlutterError {
+    let code: String
+    switch status {
+    case errSecInteractionNotAllowed:
+      code = "locked"
+    case errSecParam, errSecDecode:
+      code = "malformed"
+    default:
+      code = "osStatus"
+    }
+    return FlutterError(code: code, message: "Secure-store operation failed.", details: nil)
+  }
+}
diff --git a/flutter_app/lib/core/platform/app_directories.dart b/flutter_app/lib/core/platform/app_directories.dart
new file mode 100644
index 00000000..fe60c43f
--- /dev/null
+++ b/flutter_app/lib/core/platform/app_directories.dart
@@ -0,0 +1,165 @@
+import 'dart:io';
+
+import 'package:flutter/services.dart';
+
+enum AppDirectoryErrorCode {
+  platformUnsupported,
+  malformedPlatformPath,
+  unsafePath,
+}
+
+final class AppDirectoryException implements Exception {
+  const AppDirectoryException(this.code);
+
+  final AppDirectoryErrorCode code;
+
+  @override
+  String toString() => 'AppDirectoryException(${code.name})';
+}
+
+abstract interface class AppDirectories {
+  Future<Directory> repositoriesDirectory();
+
+  Future<Directory> repositoryRootFor(String repoId);
+
+  Future<Directory?> existingRepositoryRootFor(String repoId);
+
+  Future<Directory> worktreeFor(String repoId);
+
+  static Future<AppDirectories> forCurrentPlatform() async {
+    if (!Platform.isIOS) {
+      throw const AppDirectoryException(
+        AppDirectoryErrorCode.platformUnsupported,
+      );
+    }
+    const channel = MethodChannel('dev.forkmesh.platform/directories-v1');
+    try {
+      final path = await channel.invokeMethod<String>(
+        'appDirectories.applicationSupport',
+      );
+      if (path == null) {
+        throw const AppDirectoryException(
+          AppDirectoryErrorCode.malformedPlatformPath,
+        );
+      }
+      return MethodChannelAppDirectories(Directory(path));
+    } on PlatformException {
+      throw const AppDirectoryException(
+        AppDirectoryErrorCode.malformedPlatformPath,
+      );
+    } on MissingPluginException {
+      throw const AppDirectoryException(
+        AppDirectoryErrorCode.platformUnsupported,
+      );
+    }
+  }
+}
+
+final class MethodChannelAppDirectories implements AppDirectories {
+  MethodChannelAppDirectories(this._applicationSupport);
+
+  final Directory _applicationSupport;
+
+  @override
+  Future<Directory> repositoriesDirectory() async {
+    final support = await _safeDirectory(_applicationSupport, create: true);
+    final forkMesh = await _safeChild(support, 'ForkMesh');
+    return _safeChild(forkMesh, 'repositories');
+  }
+
+  @override
+  Future<Directory> repositoryRootFor(String repoId) async {
+    _validateRepoId(repoId);
+    return _safeChild(await repositoriesDirectory(), repoId);
+  }
+
+  @override
+  Future<Directory?> existingRepositoryRootFor(String repoId) async {
+    _validateRepoId(repoId);
+    return _existingSafeChild(await repositoriesDirectory(), repoId);
+  }
+
+  @override
+  Future<Directory> worktreeFor(String repoId) async =>
+      _safeChild(await repositoryRootFor(repoId), 'worktree');
+
+  Future<Directory> _safeChild(Directory parent, String name) async {
+    _validatePathComponent(name);
+    return _safeDirectory(
+      Directory('${parent.path}${Platform.pathSeparator}$name'),
+      create: true,
+    );
+  }
+
+  Future<Directory?> _existingSafeChild(Directory parent, String name) async {
+    _validatePathComponent(name);
+    final child = Directory('${parent.path}${Platform.pathSeparator}$name');
+    final type = await FileSystemEntity.type(child.path, followLinks: false);
+    if (type == FileSystemEntityType.notFound) return null;
+    if (type != FileSystemEntityType.directory) {
+      throw const AppDirectoryException(AppDirectoryErrorCode.unsafePath);
+    }
+    return _safeDirectory(child, create: false);
+  }
+
+  void _validatePathComponent(String name) {
+    if (name.isEmpty ||
+        name.contains('/') ||
+        name.contains('\\') ||
+        name.contains('\u0000') ||
+        name == '.' ||
+        name == '..') {
+      throw const AppDirectoryException(AppDirectoryErrorCode.unsafePath);
+    }
+  }
+
+  Future<Directory> _safeDirectory(
+    Directory directory, {
+    required bool create,
+  }) async {
+    final absolute = directory.absolute;
+    if (!absolute.path.startsWith(Platform.pathSeparator)) {
+      throw const AppDirectoryException(AppDirectoryErrorCode.unsafePath);
+    }
+    final type = await FileSystemEntity.type(absolute.path, followLinks: false);
+    if (type == FileSystemEntityType.link) {
+      throw const AppDirectoryException(AppDirectoryErrorCode.unsafePath);
+    }
+    if (type == FileSystemEntityType.notFound && create) {
+      await absolute.create();
+    }
+    if (await FileSystemEntity.type(absolute.path, followLinks: false) !=
+        FileSystemEntityType.directory) {
+      throw const AppDirectoryException(AppDirectoryErrorCode.unsafePath);
+    }
+    return absolute;
+  }
+}
+
+final class FixedAppDirectories implements AppDirectories {
+  FixedAppDirectories(Directory applicationSupport)
+    : _delegate = MethodChannelAppDirectories(applicationSupport);
+
+  final MethodChannelAppDirectories _delegate;
+
+  @override
+  Future<Directory> repositoriesDirectory() =>
+      _delegate.repositoriesDirectory();
+
+  @override
+  Future<Directory> repositoryRootFor(String repoId) =>
+      _delegate.repositoryRootFor(repoId);
+
+  @override
+  Future<Directory?> existingRepositoryRootFor(String repoId) =>
+      _delegate.existingRepositoryRootFor(repoId);
+
+  @override
+  Future<Directory> worktreeFor(String repoId) => _delegate.worktreeFor(repoId);
+}
+
+void _validateRepoId(String repoId) {
+  if (!RegExp(r'^fmrepo_[A-Za-z0-9_-]{21}[AQgw]$').hasMatch(repoId)) {
+    throw const AppDirectoryException(AppDirectoryErrorCode.unsafePath);
+  }
+}
diff --git a/flutter_app/lib/core/security/secure_store.dart b/flutter_app/lib/core/security/secure_store.dart
new file mode 100644
index 00000000..be74582b
--- /dev/null
+++ b/flutter_app/lib/core/security/secure_store.dart
@@ -0,0 +1,205 @@
+import 'dart:io';
+
+import 'package:flutter/services.dart';
+
+enum SecureStoreKey {
+  nodeSeed('identity.ed25519.seed.v1'),
+  accountSessionToken('auth.account-session-token.v1');
+
+  const SecureStoreKey(this.accountName);
+
+  final String accountName;
+}
+
+enum SecureStoreAccessibility { afterFirstUnlockThisDeviceOnly }
+
+enum SecureStoreErrorCode { platformUnsupported, locked, malformed, osStatus }
+
+final class SecureStoreException implements Exception {
+  const SecureStoreException(this.code, this.message);
+
+  final SecureStoreErrorCode code;
+  final String message;
+
+  @override
+  String toString() => 'SecureStoreException(${code.name})';
+}
+
+abstract interface class SecureStore {
+  Future<Uint8List?> read(SecureStoreKey key);
+
+  Future<void> write(
+    SecureStoreKey key,
+    List<int> value, {
+    required SecureStoreAccessibility accessibility,
+  });
+
+  Future<void> delete(SecureStoreKey key);
+
+  Future<bool> contains(SecureStoreKey key);
+}
+
+final class MethodChannelSecureStore implements SecureStore {
+  MethodChannelSecureStore._(this._channel);
+
+  static const channelName = 'dev.forkmesh.platform/security-v1';
+
+  final MethodChannel _channel;
+
+  static SecureStore forCurrentPlatform() {
+    if (!Platform.isIOS) {
+      throw const SecureStoreException(
+        SecureStoreErrorCode.platformUnsupported,
+        'secure storage is unavailable on this platform',
+      );
+    }
+    return MethodChannelSecureStore._(const MethodChannel(channelName));
+  }
+
+  @override
+  Future<Uint8List?> read(SecureStoreKey key) async {
+    try {
+      final result = await _channel.invokeMapMethod<String, dynamic>(
+        'secureStore.read',
+        <String, Object>{'key': key.accountName},
+      );
+      final state = result?['state'];
+      if (state == 'missing') return null;
+      final value = result?['value'];
+      if (state != 'found' || value is! Uint8List) {
+        throw const SecureStoreException(
+          SecureStoreErrorCode.malformed,
+          'secure storage returned malformed data',
+        );
+      }
+      return Uint8List.fromList(value);
+    } on PlatformException catch (error) {
+      throw _platformError(error);
+    } on MissingPluginException {
+      throw const SecureStoreException(
+        SecureStoreErrorCode.platformUnsupported,
+        'secure storage plugin is unavailable',
+      );
+    }
+  }
+
+  @override
+  Future<void> write(
+    SecureStoreKey key,
+    List<int> value, {
+    required SecureStoreAccessibility accessibility,
+  }) async {
+    if (value.isEmpty || value.length > 4096) {
+      throw const SecureStoreException(
+        SecureStoreErrorCode.malformed,
+        'secure storage value has an invalid length',
+      );
+    }
+    try {
+      await _channel.invokeMethod<void>('secureStore.write', <String, Object>{
+        'key': key.accountName,
+        'value': Uint8List.fromList(value),
+        'accessibility': accessibility.name,
+      });
+    } on PlatformException catch (error) {
+      throw _platformError(error);
+    } on MissingPluginException {
+      throw const SecureStoreException(
+        SecureStoreErrorCode.platformUnsupported,
+        'secure storage plugin is unavailable',
+      );
+    }
+  }
+
+  @override
+  Future<void> delete(SecureStoreKey key) async {
+    try {
+      await _channel.invokeMethod<void>('secureStore.delete', <String, Object>{
+        'key': key.accountName,
+      });
+    } on PlatformException catch (error) {
+      throw _platformError(error);
+    } on MissingPluginException {
+      throw const SecureStoreException(
+        SecureStoreErrorCode.platformUnsupported,
+        'secure storage plugin is unavailable',
+      );
+    }
+  }
+
+  @override
+  Future<bool> contains(SecureStoreKey key) async {
+    try {
+      return await _channel.invokeMethod<bool>(
+            'secureStore.contains',
+            <String, Object>{'key': key.accountName},
+          ) ??
+          false;
+    } on PlatformException catch (error) {
+      throw _platformError(error);
+    } on MissingPluginException {
+      throw const SecureStoreException(
+        SecureStoreErrorCode.platformUnsupported,
+        'secure storage plugin is unavailable',
+      );
+    }
+  }
+
+  SecureStoreException _platformError(PlatformException error) {
+    final code = switch (error.code) {
+      'locked' => SecureStoreErrorCode.locked,
+      'malformed' => SecureStoreErrorCode.malformed,
+      'platformUnsupported' => SecureStoreErrorCode.platformUnsupported,
+      _ => SecureStoreErrorCode.osStatus,
+    };
+    return SecureStoreException(code, 'secure storage operation failed');
+  }
+}
+
+final class InMemorySecureStore implements SecureStore {
+  final Map<SecureStoreKey, Uint8List> _values = <SecureStoreKey, Uint8List>{};
+
+  @override
+  Future<bool> contains(SecureStoreKey key) async => _values.containsKey(key);
+
+  @override
+  Future<void> delete(SecureStoreKey key) async {
+    _values.remove(key);
+  }
+
+  @override
+  Future<Uint8List?> read(SecureStoreKey key) async {
+    final value = _values[key];
+    return value == null ? null : Uint8List.fromList(value);
+  }
+
+  @override
+  Future<void> write(
+    SecureStoreKey key,
+    List<int> value, {
+    required SecureStoreAccessibility accessibility,
+  }) async {
+    _values[key] = Uint8List.fromList(value);
+  }
+}
+
+final class SecureStoreTestBinding {
+  SecureStoreTestBinding._();
+
+  static SecureStore? _store;
+
+  static void install(SecureStore store) {
+    _store = store;
+  }
+
+  static SecureStore requireStore() {
+    final store = _store;
+    if (store == null) {
+      throw const SecureStoreException(
+        SecureStoreErrorCode.platformUnsupported,
+        'a secure store must be supplied outside iOS production startup',
+      );
+    }
+    return store;
+  }
+}
diff --git a/flutter_app/lib/features/nodes/data/node_identity_store.dart b/flutter_app/lib/features/nodes/data/node_identity_store.dart
new file mode 100644
index 00000000..e924e29d
--- /dev/null
+++ b/flutter_app/lib/features/nodes/data/node_identity_store.dart
@@ -0,0 +1,141 @@
+import 'dart:convert';
+import 'dart:math';
+import 'dart:typed_data';
+
+import 'package:forkmesh/core/security/secure_store.dart';
+import 'package:forkmesh/features/nodes/domain/node_identity.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+enum NodeIdentityStoreErrorCode {
+  seedConflict,
+  malformedSeed,
+  malformedMetadata,
+}
+
+final class NodeIdentityStoreException implements Exception {
+  const NodeIdentityStoreException(this.code);
+
+  final NodeIdentityStoreErrorCode code;
+
+  @override
+  String toString() => 'NodeIdentityStoreException(${code.name})';
+}
+
+final class NodeIdentityStore {
+  NodeIdentityStore({
+    required this.secureStore,
+    required this.preferences,
+    Random? random,
+  }) : _random = random ?? Random.secure();
+
+  static const legacySeedKey = 'identity/ed25519Seed';
+  static const metadataKey = 'identity/nodeMetadata';
+
+  final SecureStore secureStore;
+  final SharedPreferences preferences;
+  final Random _random;
+
+  Future<Uint8List> loadOrCreateSeed() async {
+    final secured = await secureStore.read(SecureStoreKey.nodeSeed);
+    final legacy = _legacySeed();
+    if (secured != null && secured.length != 32) {
+      throw const NodeIdentityStoreException(
+        NodeIdentityStoreErrorCode.malformedSeed,
+      );
+    }
+    if (secured != null) {
+      if (legacy != null && !_sameBytes(secured, legacy)) {
+        throw const NodeIdentityStoreException(
+          NodeIdentityStoreErrorCode.seedConflict,
+        );
+      }
+      if (legacy != null) await preferences.remove(legacySeedKey);
+      return Uint8List.fromList(secured);
+    }
+    if (legacy != null) {
+      await _writeAndVerify(legacy);
+      await preferences.remove(legacySeedKey);
+      return legacy;
+    }
+    if (preferences.containsKey(legacySeedKey)) {
+      throw const NodeIdentityStoreException(
+        NodeIdentityStoreErrorCode.malformedSeed,
+      );
+    }
+    final generated = Uint8List.fromList(
+      List<int>.generate(32, (_) => _random.nextInt(256)),
+    );
+    await _writeAndVerify(generated);
+    return generated;
+  }
+
+  Future<NodeIdentity> loadOrCreateNodeIdentity(String publicKey) async {
+    final raw = preferences.getString(metadataKey);
+    if (raw == null || raw.isEmpty) {
+      final identity = NodeIdentity(
+        nodeId: 'fmnode_${NodeIdentity.canonicalBase64Url(_randomBytes(16))}',
+        publicKey: publicKey,
+      );
+      await preferences.setString(metadataKey, jsonEncode(identity.toJson()));
+      return identity;
+    }
+    try {
+      final decoded = jsonDecode(raw);
+      if (decoded is! Map) throw const FormatException();
+      final identity = NodeIdentity.fromJson(
+        Map<String, Object?>.from(decoded),
+      );
+      if (identity.publicKey != publicKey) {
+        throw const NodeIdentityStoreException(
+          NodeIdentityStoreErrorCode.seedConflict,
+        );
+      }
+      return identity;
+    } on NodeIdentityStoreException {
+      rethrow;
+    } on Object {
+      throw const NodeIdentityStoreException(
+        NodeIdentityStoreErrorCode.malformedMetadata,
+      );
+    }
+  }
+
+  Uint8List? _legacySeed() {
+    final raw = preferences.getString(legacySeedKey);
+    if (raw == null || raw.isEmpty) return null;
+    try {
+      final value = Uint8List.fromList(base64.decode(raw));
+      if (value.length != 32 || base64.encode(value) != raw) return null;
+      return value;
+    } on FormatException {
+      return null;
+    }
+  }
+
+  Future<void> _writeAndVerify(List<int> seed) async {
+    await secureStore.write(
+      SecureStoreKey.nodeSeed,
+      seed,
+      accessibility: SecureStoreAccessibility.afterFirstUnlockThisDeviceOnly,
+    );
+    final readBack = await secureStore.read(SecureStoreKey.nodeSeed);
+    if (readBack == null || !_sameBytes(readBack, seed)) {
+      throw const NodeIdentityStoreException(
+        NodeIdentityStoreErrorCode.malformedSeed,
+      );
+    }
+  }
+
+  Uint8List _randomBytes(int length) => Uint8List.fromList(
+    List<int>.generate(length, (_) => _random.nextInt(256)),
+  );
+}
+
+bool _sameBytes(List<int> left, List<int> right) {
+  if (left.length != right.length) return false;
+  var difference = 0;
+  for (var index = 0; index < left.length; index += 1) {
+    difference |= left[index] ^ right[index];
+  }
+  return difference == 0;
+}
diff --git a/flutter_app/lib/features/nodes/domain/node_identity.dart b/flutter_app/lib/features/nodes/domain/node_identity.dart
new file mode 100644
index 00000000..df7421d3
--- /dev/null
+++ b/flutter_app/lib/features/nodes/domain/node_identity.dart
@@ -0,0 +1,37 @@
+import 'dart:convert';
+
+final class NodeIdentity {
+  NodeIdentity({required this.nodeId, required this.publicKey}) {
+    if (!RegExp(r'^fmnode_[A-Za-z0-9_-]{21}[AQgw]$').hasMatch(nodeId)) {
+      throw ArgumentError.value(nodeId, 'nodeId');
+    }
+    if (!RegExp(r'^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$').hasMatch(publicKey)) {
+      throw ArgumentError.value(publicKey, 'publicKey');
+    }
+  }
+
+  final String nodeId;
+  final String publicKey;
+
+  Map<String, Object> toJson() => <String, Object>{
+    'version': 1,
+    'nodeId': nodeId,
+    'publicKey': publicKey,
+  };
+
+  factory NodeIdentity.fromJson(Map<String, Object?> json) {
+    if (json.length != 3 ||
+        json['version'] != 1 ||
+        json['nodeId'] is! String ||
+        json['publicKey'] is! String) {
+      throw const FormatException('node identity metadata is invalid');
+    }
+    return NodeIdentity(
+      nodeId: json['nodeId']! as String,
+      publicKey: json['publicKey']! as String,
+    );
+  }
+
+  static String canonicalBase64Url(List<int> bytes) =>
+      base64UrlEncode(bytes).replaceAll('=', '');
+}
diff --git a/flutter_app/lib/features/repositories/data/local_repository_runtime.dart b/flutter_app/lib/features/repositories/data/local_repository_runtime.dart
new file mode 100644
index 00000000..6412f2c1
--- /dev/null
+++ b/flutter_app/lib/features/repositories/data/local_repository_runtime.dart
@@ -0,0 +1,36 @@
+import 'package:forkmesh/core/platform/app_directories.dart';
+import 'package:forkmesh/features/nodes/domain/node_identity.dart';
+import 'package:forkmesh/features/repositories/data/local_repository_store.dart';
+import 'package:forkmesh/features/repositories/data/owned_git_engine_adapter.dart';
+import 'package:forkmesh/features/repositories/domain/local_git_capabilities.dart';
+
+/// The local-only repository boundary available during Phase 2A.
+///
+/// It owns no network transport and only opens repositories created beneath the
+/// app's Application Support sandbox.
+final class Phase2ALocalRuntime {
+  const Phase2ALocalRuntime._({
+    required this.repositoryStore,
+    required this.git,
+  });
+
+  final LocalRepositoryStore repositoryStore;
+  final OwnedGitEngineAdapter git;
+
+  LocalGitCapabilities get capabilities => git.capabilities;
+
+  static Future<Phase2ALocalRuntime> bootstrap({
+    required AppDirectories directories,
+    required NodeIdentity nodeIdentity,
+  }) async {
+    final repositoryStore = LocalRepositoryStore(
+      directories: directories,
+      nodeIdentity: nodeIdentity,
+    );
+    await repositoryStore.recover();
+    return Phase2ALocalRuntime._(
+      repositoryStore: repositoryStore,
+      git: OwnedGitEngineAdapter(repositoryStore),
+    );
+  }
+}
diff --git a/flutter_app/lib/features/repositories/data/local_repository_store.dart b/flutter_app/lib/features/repositories/data/local_repository_store.dart
new file mode 100644
index 00000000..e4df6464
--- /dev/null
+++ b/flutter_app/lib/features/repositories/data/local_repository_store.dart
@@ -0,0 +1,419 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:math';
+
+import 'package:forkmesh/core/platform/app_directories.dart';
+import 'package:forkmesh/features/nodes/domain/node_identity.dart';
+import 'package:forkmesh/features/repositories/domain/repository_identity.dart';
+import 'package:forkmesh/features/repositories/domain/repository_replica.dart';
+import 'package:forkmesh_git/forkmesh_git.dart';
+
+enum LocalRepositoryStoreErrorCode {
+  alreadyExists,
+  notFound,
+  malformedManifest,
+  malformedReplica,
+  mismatchedIdentity,
+  interruptedOperation,
+}
+
+enum LocalReplicaDeletionIntent { removeLocalReplica }
+
+final class LocalRepositoryStoreException implements Exception {
+  const LocalRepositoryStoreException(this.code);
+
+  final LocalRepositoryStoreErrorCode code;
+
+  @override
+  String toString() => 'LocalRepositoryStoreException(${code.name})';
+}
+
+final class LocalRepositoryRecord {
+  const LocalRepositoryRecord({
+    required this.repository,
+    required this.replica,
+    required this.nodeIdentity,
+    required this.root,
+    required this.worktree,
+  });
+
+  final RepositoryIdentity repository;
+  final RepositoryReplica replica;
+  final NodeIdentity nodeIdentity;
+  final Directory root;
+  final Directory worktree;
+}
+
+final class LocalRepositoryStore {
+  LocalRepositoryStore({
+    required this.directories,
+    required this.nodeIdentity,
+    String Function()? repositoryIdGenerator,
+    String Function()? replicaIdGenerator,
+    int Function()? clock,
+  }) : _repositoryIdGenerator = repositoryIdGenerator ?? _newRepositoryId,
+       _replicaIdGenerator = replicaIdGenerator ?? _newReplicaId,
+       _clock = clock ?? (() => DateTime.now().millisecondsSinceEpoch);
+
+  final AppDirectories directories;
+  final NodeIdentity nodeIdentity;
+  final String Function() _repositoryIdGenerator;
+  final String Function() _replicaIdGenerator;
+  final int Function() _clock;
+
+  Future<LocalRepositoryRecord> create({
+    required String createdBy,
+    String defaultBranch = 'main',
+  }) async {
+    final repository = RepositoryIdentity(
+      repoId: _repositoryIdGenerator(),
+      createdBy: createdBy,
+      createdAt: _clock(),
+      defaultBranch: defaultBranch,
+    );
+    final root = await directories.repositoryRootFor(repository.repoId);
+    if (!await root.list(followLinks: false).isEmpty) {
+      throw const LocalRepositoryStoreException(
+        LocalRepositoryStoreErrorCode.alreadyExists,
+      );
+    }
+    final journal = File('${root.path}${Platform.pathSeparator}operation.json');
+    await _writeNewAtomically(journal, <String, Object>{
+      'version': 1,
+      'operation': 'create',
+      'repoId': repository.repoId,
+    });
+    final worktree = await directories.worktreeFor(repository.repoId);
+    final gitRepository = await GitRepository.init(GitRepositoryInit(worktree));
+    try {
+      await _writeNewAtomically(_manifestFile(worktree), repository.toJson());
+      final writtenManifest = await _readManifest(_manifestFile(worktree));
+      if (!_sameRepositoryIdentity(writtenManifest, repository)) {
+        throw const LocalRepositoryStoreException(
+          LocalRepositoryStoreErrorCode.malformedManifest,
+        );
+      }
+      await gitRepository.add(<GitWorktreePath>[
+        GitWorktreePath('.forkmesh/repository.json'),
+      ]);
+      final bootstrapCommit = await gitRepository.commit(
+        GitCommitRequest(
+          message: 'Initialize ForkMesh repository identity\n',
+          author: GitIdentity(
+            name: repository.createdBy,
+            email: '${repository.createdBy}@forkmesh.local',
+            timestampSeconds: repository.createdAt ~/ 1000,
+            timezoneOffsetMinutes: 0,
+          ),
+          committer: GitIdentity(
+            name: repository.createdBy,
+            email: '${repository.createdBy}@forkmesh.local',
+            timestampSeconds: repository.createdAt ~/ 1000,
+            timezoneOffsetMinutes: 0,
+          ),
+        ),
+      );
+      final replica = RepositoryReplica(
+        replicaId: _replicaIdGenerator(),
+        repoId: repository.repoId,
+        nodeId: nodeIdentity.nodeId,
+        storageBytes: await _directoryBytes(root),
+        canonicalHead: <String, String>{
+          'ref': 'refs/heads/${repository.defaultBranch}',
+          'sha': bootstrapCommit.hex,
+        },
+      );
+      await _writeNewAtomically(_replicaFile(root), replica.toJson());
+      final writtenReplica = await _readReplica(_replicaFile(root));
+      if (!_sameReplicaIdentity(writtenReplica, replica)) {
+        throw const LocalRepositoryStoreException(
+          LocalRepositoryStoreErrorCode.malformedReplica,
+        );
+      }
+      await journal.delete();
+      return LocalRepositoryRecord(
+        repository: repository,
+        replica: replica,
+        nodeIdentity: nodeIdentity,
+        root: root,
+        worktree: worktree,
+      );
+    } finally {
+      await gitRepository.dispose();
+    }
+  }
+
+  Future<LocalRepositoryRecord> open(String repoId) async {
+    final root = await directories.existingRepositoryRootFor(repoId);
+    if (root == null) {
+      throw const LocalRepositoryStoreException(
+        LocalRepositoryStoreErrorCode.notFound,
+      );
+    }
+    await _recoverCreate(root, repoId);
+    if (!await root.exists()) {
+      throw const LocalRepositoryStoreException(
+        LocalRepositoryStoreErrorCode.notFound,
+      );
+    }
+    final worktree = Directory('${root.path}${Platform.pathSeparator}worktree');
+    final repository = await _readManifest(_manifestFile(worktree));
+    if (repository.repoId != repoId) {
+      throw const LocalRepositoryStoreException(
+        LocalRepositoryStoreErrorCode.mismatchedIdentity,
+      );
+    }
+    final replica = await _readReplica(_replicaFile(root));
+    if (replica.repoId != repoId || replica.nodeId != nodeIdentity.nodeId) {
+      throw const LocalRepositoryStoreException(
+        LocalRepositoryStoreErrorCode.mismatchedIdentity,
+      );
+    }
+    try {
+      final validationRepository = await GitRepository.open(
+        GitRepositoryOpen(worktree),
+      );
+      await validationRepository.dispose();
+    } on GitException {
+      throw const LocalRepositoryStoreException(
+        LocalRepositoryStoreErrorCode.interruptedOperation,
+      );
+    }
+    return LocalRepositoryRecord(
+      repository: repository,
+      replica: replica,
+      nodeIdentity: nodeIdentity,
+      root: root,
+      worktree: worktree,
+    );
+  }
+
+  Future<void> recover() async {
+    final repositories = await directories.repositoriesDirectory();
+    await for (final entity in repositories.list(followLinks: false)) {
+      if (entity is! Directory) {
+        throw const LocalRepositoryStoreException(
+          LocalRepositoryStoreErrorCode.interruptedOperation,
+        );
+      }
+      final repoId = entity.uri.pathSegments
+          .where((segment) => segment.isNotEmpty)
+          .last;
+      if (!RegExp(r'^fmrepo_[A-Za-z0-9_-]{21}[AQgw]$').hasMatch(repoId)) {
+        throw const LocalRepositoryStoreException(
+          LocalRepositoryStoreErrorCode.interruptedOperation,
+        );
+      }
+      await _recoverOperation(entity, repoId);
+    }
+  }
+
+  Future<RepositoryReplica> recordLocalHead(
+    LocalRepositoryRecord record, {
+    required String ref,
+    required String objectId,
+  }) async {
+    final replica = RepositoryReplica(
+      replicaId: record.replica.replicaId,
+      repoId: record.repository.repoId,
+      nodeId: record.nodeIdentity.nodeId,
+      storageBytes: await _directoryBytes(record.root),
+      canonicalHead: <String, String>{'ref': ref, 'sha': objectId},
+      fetchedHead: record.replica.fetchedHead,
+      lastSyncedAt: record.replica.lastSyncedAt,
+      lastServedAt: record.replica.lastServedAt,
+    );
+    await _replaceAtomically(_replicaFile(record.root), replica.toJson());
+    return replica;
+  }
+
+  Future<void> removeLocalReplica(
+    LocalRepositoryRecord record, {
+    required LocalReplicaDeletionIntent intent,
+  }) async {
+    switch (intent) {
+      case LocalReplicaDeletionIntent.removeLocalReplica:
+        break;
+    }
+    final expectedRoot = await directories.existingRepositoryRootFor(
+      record.repository.repoId,
+    );
+    if (expectedRoot == null ||
+        expectedRoot.absolute.path != record.root.absolute.path) {
+      throw const LocalRepositoryStoreException(
+        LocalRepositoryStoreErrorCode.notFound,
+      );
+    }
+    final journal = File(
+      '${expectedRoot.path}${Platform.pathSeparator}operation.json',
+    );
+    await _writeNewAtomically(journal, <String, Object>{
+      'version': 1,
+      'operation': 'delete',
+      'repoId': record.repository.repoId,
+    });
+    await expectedRoot.delete(recursive: true);
+  }
+
+  Future<void> _recoverOperation(Directory root, String repoId) async {
+    final journal = File('${root.path}${Platform.pathSeparator}operation.json');
+    if (!await journal.exists()) return;
+    final operation = await _readJournal(journal, repoId);
+    if (operation == 'delete') {
+      await root.delete(recursive: true);
+      return;
+    }
+    await _recoverCreate(root, repoId);
+  }
+
+  Future<void> _recoverCreate(Directory root, String repoId) async {
+    final journal = File('${root.path}${Platform.pathSeparator}operation.json');
+    if (!await journal.exists()) return;
+    final operation = await _readJournal(journal, repoId);
+    if (operation != 'create') {
+      throw const LocalRepositoryStoreException(
+        LocalRepositoryStoreErrorCode.interruptedOperation,
+      );
+    }
+    final manifest = _manifestFile(
+      Directory('${root.path}${Platform.pathSeparator}worktree'),
+    );
+    final replica = _replicaFile(root);
+    if (await manifest.exists() && await replica.exists()) {
+      await journal.delete();
+      return;
+    }
+    await root.delete(recursive: true);
+  }
+
+  Future<String> _readJournal(File journal, String repoId) async {
+    try {
+      final decoded = jsonDecode(await journal.readAsString());
+      if (decoded is! Map ||
+          decoded.length != 3 ||
+          decoded['version'] != 1 ||
+          (decoded['operation'] != 'create' &&
+              decoded['operation'] != 'delete') ||
+          decoded['repoId'] != repoId) {
+        throw const FormatException();
+      }
+      return decoded['operation']! as String;
+    } on Object {
+      throw const LocalRepositoryStoreException(
+        LocalRepositoryStoreErrorCode.interruptedOperation,
+      );
+    }
+  }
+}
+
+File _manifestFile(Directory worktree) => File(
+  '${worktree.path}${Platform.pathSeparator}.forkmesh'
+  '${Platform.pathSeparator}repository.json',
+);
+
+File _replicaFile(Directory root) =>
+    File('${root.path}${Platform.pathSeparator}replica.json');
+
+Future<RepositoryIdentity> _readManifest(File file) async {
+  try {
+    final value = jsonDecode(await file.readAsString());
+    if (value is! Map) throw const FormatException();
+    return RepositoryIdentity.fromJson(Map<String, Object?>.from(value));
+  } on Object {
+    throw const LocalRepositoryStoreException(
+      LocalRepositoryStoreErrorCode.malformedManifest,
+    );
+  }
+}
+
+Future<RepositoryReplica> _readReplica(File file) async {
+  try {
+    final value = jsonDecode(await file.readAsString());
+    if (value is! Map) throw const FormatException();
+    return RepositoryReplica.fromJson(Map<String, Object?>.from(value));
+  } on Object {
+    throw const LocalRepositoryStoreException(
+      LocalRepositoryStoreErrorCode.malformedReplica,
+    );
+  }
+}
+
+bool _sameRepositoryIdentity(
+  RepositoryIdentity left,
+  RepositoryIdentity right,
+) =>
+    left.repoId == right.repoId &&
+    left.createdBy == right.createdBy &&
+    left.createdAt == right.createdAt &&
+    left.defaultBranch == right.defaultBranch;
+
+bool _sameReplicaIdentity(RepositoryReplica left, RepositoryReplica right) =>
+    left.replicaId == right.replicaId &&
+    left.repoId == right.repoId &&
+    left.nodeId == right.nodeId &&
+    left.storageBytes == right.storageBytes &&
+    _sameHead(left.canonicalHead, right.canonicalHead) &&
+    _sameHead(left.fetchedHead, right.fetchedHead) &&
+    left.lastSyncedAt == right.lastSyncedAt &&
+    left.lastServedAt == right.lastServedAt;
+
+bool _sameHead(Map<String, String>? left, Map<String, String>? right) =>
+    left?['ref'] == right?['ref'] && left?['sha'] == right?['sha'];
+
+Future<void> _writeNewAtomically(
+  File destination,
+  Map<String, Object?> json,
+) async {
+  await destination.parent.create(recursive: true);
+  if (await destination.exists()) {
+    throw const LocalRepositoryStoreException(
+      LocalRepositoryStoreErrorCode.alreadyExists,
+    );
+  }
+  final temporary = File(
+    '${destination.path}.tmp-${DateTime.now().microsecondsSinceEpoch}',
+  );
+  try {
+    await temporary.writeAsString(jsonEncode(json), flush: true);
+    await temporary.rename(destination.path);
+  } finally {
+    if (await temporary.exists()) await temporary.delete();
+  }
+}
+
+Future<void> _replaceAtomically(
+  File destination,
+  Map<String, Object?> json,
+) async {
+  final temporary = File(
+    '${destination.path}.tmp-${DateTime.now().microsecondsSinceEpoch}',
+  );
+  try {
+    await temporary.writeAsString(jsonEncode(json), flush: true);
+    await temporary.rename(destination.path);
+  } finally {
+    if (await temporary.exists()) await temporary.delete();
+  }
+}
+
+Future<int> _directoryBytes(Directory directory) async {
+  var total = 0;
+  await for (final entity in directory.list(
+    recursive: true,
+    followLinks: false,
+  )) {
+    if (entity is File) total += await entity.length();
+  }
+  return total;
+}
+
+String _newRepositoryId() => 'fmrepo_${_randomIdentifier()}';
+
+String _newReplicaId() => 'fmreplica_${_randomIdentifier()}';
+
+String _randomIdentifier() {
+  final random = Random.secure();
+  return NodeIdentity.canonicalBase64Url(
+    List<int>.generate(16, (_) => random.nextInt(256)),
+  );
+}
diff --git a/flutter_app/lib/features/repositories/data/owned_git_engine_adapter.dart b/flutter_app/lib/features/repositories/data/owned_git_engine_adapter.dart
new file mode 100644
index 00000000..dbcb800e
--- /dev/null
+++ b/flutter_app/lib/features/repositories/data/owned_git_engine_adapter.dart
@@ -0,0 +1,238 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:forkmesh/features/repositories/domain/local_git_capabilities.dart';
+import 'package:forkmesh_git/forkmesh_git.dart';
+
+import 'local_repository_store.dart';
+
+final class LocalGitStatus {
+  const LocalGitStatus({
+    required this.stagedPaths,
+    required this.worktreePaths,
+  });
+
+  final List<String> stagedPaths;
+  final List<String> worktreePaths;
+
+  bool get isClean => stagedPaths.isEmpty && worktreePaths.isEmpty;
+}
+
+final class LocalGitHistoryEntry {
+  const LocalGitHistoryEntry({required this.objectId, required this.message});
+
+  final String objectId;
+  final String message;
+}
+
+final class LocalGitTreeEntry {
+  const LocalGitTreeEntry({
+    required this.name,
+    required this.objectId,
+    required this.kind,
+  });
+
+  final String name;
+  final String objectId;
+  final String kind;
+}
+
+final class OwnedGitEngineAdapter {
+  OwnedGitEngineAdapter(this._store)
+    : capabilities = LocalGitCapabilities.phase2A();
+
+  final LocalRepositoryStore _store;
+  final LocalGitCapabilities capabilities;
+
+  Future<OwnedLocalRepository> initializeLocal({
+    required String createdBy,
+  }) async => _openRecord(await _store.create(createdBy: createdBy));
+
+  Future<OwnedLocalRepository> openLocal(String repoId) async =>
+      _openRecord(await _store.open(repoId));
+
+  Future<void> clone() => _deny(LocalGitCapability.clone);
+
+  Future<void> fetch() => _deny(LocalGitCapability.fetch);
+
+  Future<void> push() => _deny(LocalGitCapability.push);
+
+  Future<void> importRemoteRepository() =>
+      _deny(LocalGitCapability.untrustedSha1Import);
+
+  Future<void> hostRemoteRepository() =>
+      _deny(LocalGitCapability.remoteHosting);
+
+  Future<void> installUntrustedSha1Object() =>
+      _deny(LocalGitCapability.untrustedSha1Import);
+
+  Future<OwnedLocalRepository> _openRecord(LocalRepositoryRecord record) async {
+    final repository = await GitRepository.open(
+      GitRepositoryOpen(record.worktree),
+    );
+    return OwnedLocalRepository._(_store, record, repository);
+  }
+
+  Future<void> _deny(LocalGitCapability capability) {
+    final status = capabilities.statusFor(capability);
+    return Future<void>.error(
+      LocalGitCapabilityException(capability, status.reason!),
+    );
+  }
+}
+
+final class OwnedLocalRepository {
+  OwnedLocalRepository._(this._store, this._record, this._repository);
+
+  final LocalRepositoryStore _store;
+  LocalRepositoryRecord _record;
+  final GitRepository _repository;
+
+  String get repoId => _record.repository.repoId;
+  Directory get worktree => _record.worktree;
+
+  Future<LocalGitStatus> status() async {
+    final status = await _repository.status();
+    return LocalGitStatus(
+      stagedPaths: List<String>.unmodifiable(
+        status.staged.map((entry) => entry.path.value),
+      ),
+      worktreePaths: List<String>.unmodifiable(
+        status.worktree.map((entry) => entry.path.value),
+      ),
+    );
+  }
+
+  Future<void> stage(Iterable<String> paths) =>
+      _repository.add(paths.map(GitWorktreePath.new));
+
+  Future<void> remove(Iterable<String> paths) =>
+      _repository.remove(paths.map(GitWorktreePath.new));
+
+  Future<String> commit({
+    required String message,
+    required String authorName,
+    required String authorEmail,
+    required int timestampSeconds,
+  }) async {
+    final identity = GitIdentity(
+      name: authorName,
+      email: authorEmail,
+      timestampSeconds: timestampSeconds,
+      timezoneOffsetMinutes: 0,
+    );
+    final objectId = await _repository.commit(
+      GitCommitRequest(message: message, author: identity, committer: identity),
+    );
+    final head = await _repository.readHead();
+    final replica = await _store.recordLocalHead(
+      _record,
+      ref: head.target,
+      objectId: objectId.hex,
+    );
+    _record = LocalRepositoryRecord(
+      repository: _record.repository,
+      replica: replica,
+      nodeIdentity: _record.nodeIdentity,
+      root: _record.root,
+      worktree: _record.worktree,
+    );
+    return objectId.hex;
+  }
+
+  Future<void> createBranch(String name) =>
+      _repository.createBranch(GitBranchName(name));
+
+  Future<void> checkout(String name) =>
+      _repository.checkout(GitCheckoutRequest.branch(GitBranchName(name)));
+
+  Future<Uint8List> readBlob(String objectId) =>
+      _repository.readBlob(GitObjectId.parseSha1(objectId));
+
+  Future<List<LocalGitTreeEntry>> readTree(String objectId) async {
+    final tree = await _repository.readTree(GitObjectId.parseSha1(objectId));
+    return List<LocalGitTreeEntry>.unmodifiable(
+      tree.entries.map(
+        (entry) => LocalGitTreeEntry(
+          name: utf8.decode(entry.name),
+          objectId: entry.objectId.hex,
+          kind: entry.mode.name,
+        ),
+      ),
+    );
+  }
+
+  Future<Uint8List> readBlobFromHead(String path) async {
+    final worktreePath = GitWorktreePath(path);
+    final head = await _repository.readHeadObjectId();
+    if (head == null) {
+      throw const GitException(
+        GitErrorCode.invalidObject,
+        'repository is empty',
+      );
+    }
+    final commit = await _repository.readCommit(head);
+    return _readBlobAt(commit.tree, worktreePath.components, 0);
+  }
+
+  Future<Uint8List> _readBlobAt(
+    GitObjectId treeId,
+    List<String> components,
+    int index,
+  ) async {
+    final tree = await _repository.readTree(treeId);
+    final entry = tree.entries.firstWhere(
+      (candidate) => utf8.decode(candidate.name) == components[index],
+      orElse: () => throw const GitException(
+        GitErrorCode.invalidObject,
+        'path is absent from HEAD',
+      ),
+    );
+    if (index == components.length - 1) {
+      if (entry.mode == GitTreeMode.directory) {
+        throw const GitException(
+          GitErrorCode.invalidObject,
+          'path is a directory',
+        );
+      }
+      return _repository.readBlob(entry.objectId);
+    }
+    if (entry.mode != GitTreeMode.directory) {
+      throw const GitException(
+        GitErrorCode.invalidObject,
+        'path is not a directory',
+      );
+    }
+    return _readBlobAt(entry.objectId, components, index + 1);
+  }
+
+  Future<List<LocalGitHistoryEntry>> history({int maximumEntries = 100}) async {
+    if (maximumEntries <= 0 || maximumEntries > 1000) {
+      throw ArgumentError.value(maximumEntries, 'maximumEntries');
+    }
+    final entries = <LocalGitHistoryEntry>[];
+    var current = await _repository.readHeadObjectId();
+    while (current != null && entries.length < maximumEntries) {
+      final commit = await _repository.readCommit(current);
+      entries.add(
+        LocalGitHistoryEntry(
+          objectId: current.hex,
+          message: utf8.decode(commit.message, allowMalformed: false),
+        ),
+      );
+      current = commit.parents.isEmpty ? null : commit.parents.first;
+    }
+    return List<LocalGitHistoryEntry>.unmodifiable(entries);
+  }
+
+  /// Removes only this device's local replica after an explicit caller intent.
+  ///
+  /// It neither changes a remote catalog nor implies deletion of the logical
+  /// repository outside this app sandbox.
+  Future<void> removeLocalReplica({
+    required LocalReplicaDeletionIntent intent,
+  }) => _store.removeLocalReplica(_record, intent: intent);
+
+  Future<void> dispose() => _repository.dispose();
+}
diff --git a/flutter_app/lib/features/repositories/domain/local_git_capabilities.dart b/flutter_app/lib/features/repositories/domain/local_git_capabilities.dart
new file mode 100644
index 00000000..4fd8b8d4
--- /dev/null
+++ b/flutter_app/lib/features/repositories/domain/local_git_capabilities.dart
@@ -0,0 +1,98 @@
+enum LocalGitCapability {
+  localRepository('git.localRepository'),
+  localAuthoring('git.localAuthoring'),
+  offlineBrowse('git.offlineBrowse'),
+  localBranch('git.localBranch'),
+  localCommit('git.localCommit'),
+  clone('git.clone'),
+  fetch('git.fetch'),
+  push('git.push'),
+  remoteHosting('git.remoteHosting'),
+  untrustedSha1Import('git.untrustedSha1Import'),
+  androidRuntime('git.androidRuntime');
+
+  const LocalGitCapability(this.id);
+
+  final String id;
+}
+
+enum LocalGitDisableReason {
+  awaitingIndependentCryptographyReview,
+  androidSdkUnavailable,
+  physicalDeviceValidationPending,
+  phaseNotImplemented,
+}
+
+final class LocalGitCapabilityStatus {
+  const LocalGitCapabilityStatus.enabled(this.capability)
+    : enabled = true,
+      reason = null;
+
+  const LocalGitCapabilityStatus.disabled(this.capability, this.reason)
+    : enabled = false;
+
+  final LocalGitCapability capability;
+  final bool enabled;
+  final LocalGitDisableReason? reason;
+}
+
+final class LocalGitCapabilities {
+  const LocalGitCapabilities._(this._statuses);
+
+  final Map<LocalGitCapability, LocalGitCapabilityStatus> _statuses;
+
+  factory LocalGitCapabilities.phase2A() => LocalGitCapabilities._(
+    <LocalGitCapability, LocalGitCapabilityStatus>{
+      for (final capability in <LocalGitCapability>[
+        LocalGitCapability.localRepository,
+        LocalGitCapability.localAuthoring,
+        LocalGitCapability.offlineBrowse,
+        LocalGitCapability.localBranch,
+        LocalGitCapability.localCommit,
+      ])
+        capability: LocalGitCapabilityStatus.enabled(capability),
+      LocalGitCapability.clone: LocalGitCapabilityStatus.disabled(
+        LocalGitCapability.clone,
+        LocalGitDisableReason.awaitingIndependentCryptographyReview,
+      ),
+      LocalGitCapability.fetch: LocalGitCapabilityStatus.disabled(
+        LocalGitCapability.fetch,
+        LocalGitDisableReason.awaitingIndependentCryptographyReview,
+      ),
+      LocalGitCapability.push: LocalGitCapabilityStatus.disabled(
+        LocalGitCapability.push,
+        LocalGitDisableReason.awaitingIndependentCryptographyReview,
+      ),
+      LocalGitCapability.remoteHosting: LocalGitCapabilityStatus.disabled(
+        LocalGitCapability.remoteHosting,
+        LocalGitDisableReason.phaseNotImplemented,
+      ),
+      LocalGitCapability.untrustedSha1Import: LocalGitCapabilityStatus.disabled(
+        LocalGitCapability.untrustedSha1Import,
+        LocalGitDisableReason.awaitingIndependentCryptographyReview,
+      ),
+      LocalGitCapability.androidRuntime: LocalGitCapabilityStatus.disabled(
+        LocalGitCapability.androidRuntime,
+        LocalGitDisableReason.androidSdkUnavailable,
+      ),
+    },
+  );
+
+  LocalGitCapabilityStatus statusFor(LocalGitCapability capability) =>
+      _statuses[capability]!;
+
+  List<LocalGitDisableReason> get validationBlockers =>
+      const <LocalGitDisableReason>[
+        LocalGitDisableReason.physicalDeviceValidationPending,
+      ];
+}
+
+final class LocalGitCapabilityException implements Exception {
+  const LocalGitCapabilityException(this.capability, this.reason);
+
+  final LocalGitCapability capability;
+  final LocalGitDisableReason reason;
+
+  @override
+  String toString() => 'LocalGitCapabilityException(${capability.id})';
+}
diff --git a/flutter_app/lib/features/repositories/domain/repository_identity.dart b/flutter_app/lib/features/repositories/domain/repository_identity.dart
new file mode 100644
index 00000000..fda141a7
--- /dev/null
+++ b/flutter_app/lib/features/repositories/domain/repository_identity.dart
@@ -0,0 +1,52 @@
+import 'dart:convert';
+
+final class RepositoryIdentity {
+  RepositoryIdentity({
+    required this.repoId,
+    required this.createdBy,
+    required this.createdAt,
+    required this.defaultBranch,
+  }) {
+    if (!RegExp(r'^fmrepo_[A-Za-z0-9_-]{21}[AQgw]$').hasMatch(repoId) ||
+        !RegExp(r'^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$').hasMatch(createdBy) ||
+        createdAt < 0 ||
+        createdAt > 253402300799999 ||
+        !RegExp(
+          r'^(?!.*\.\.)(?!.*\.lock$)[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9_-])?$',
+        ).hasMatch(defaultBranch)) {
+      throw ArgumentError('repository identity is invalid');
+    }
+  }
+
+  final String repoId;
+  final String createdBy;
+  final int createdAt;
+  final String defaultBranch;
+
+  Map<String, Object> toJson() => <String, Object>{
+    'version': 1,
+    'repoId': repoId,
+    'createdBy': createdBy,
+    'createdAt': createdAt,
+    'defaultBranch': defaultBranch,
+  };
+
+  factory RepositoryIdentity.fromJson(Map<String, Object?> value) {
+    if (value.length != 5 ||
+        value['version'] != 1 ||
+        value['repoId'] is! String ||
+        value['createdBy'] is! String ||
+        value['createdAt'] is! int ||
+        value['defaultBranch'] is! String) {
+      throw const FormatException('repository manifest is invalid');
+    }
+    return RepositoryIdentity(
+      repoId: value['repoId']! as String,
+      createdBy: value['createdBy']! as String,
+      createdAt: value['createdAt']! as int,
+      defaultBranch: value['defaultBranch']! as String,
+    );
+  }
+
+  String encode() => jsonEncode(toJson());
+}
diff --git a/flutter_app/lib/features/repositories/domain/repository_replica.dart b/flutter_app/lib/features/repositories/domain/repository_replica.dart
new file mode 100644
index 00000000..9cc45e52
--- /dev/null
+++ b/flutter_app/lib/features/repositories/domain/repository_replica.dart
@@ -0,0 +1,116 @@
+import 'dart:convert';
+
+final class RepositoryReplica {
+  RepositoryReplica({
+    required this.replicaId,
+    required this.repoId,
+    required this.nodeId,
+    required this.storageBytes,
+    this.canonicalHead,
+    this.fetchedHead,
+    this.lastSyncedAt,
+    this.lastServedAt,
+  }) {
+    if (!RegExp(r'^fmreplica_[A-Za-z0-9_-]{21}[AQgw]$').hasMatch(replicaId) ||
+        !RegExp(r'^fmrepo_[A-Za-z0-9_-]{21}[AQgw]$').hasMatch(repoId) ||
+        !RegExp(r'^fmnode_[A-Za-z0-9_-]{21}[AQgw]$').hasMatch(nodeId) ||
+        storageBytes < 0 ||
+        storageBytes > 9007199254740991) {
+      throw ArgumentError('repository replica is invalid');
+    }
+  }
+
+  final String replicaId;
+  final String repoId;
+  final String nodeId;
+  final int storageBytes;
+  final Map<String, String>? canonicalHead;
+  final Map<String, String>? fetchedHead;
+  final int? lastSyncedAt;
+  final int? lastServedAt;
+
+  Map<String, Object?> toJson() => <String, Object?>{
+    'version': 1,
+    'replicaId': replicaId,
+    'repoId': repoId,
+    'nodeId': nodeId,
+    'completeness': 'full',
+    'availability': 'offline',
+    'canonicalHead': canonicalHead,
+    'fetchedHead': fetchedHead,
+    'lastSyncedAt': lastSyncedAt,
+    'lastServedAt': lastServedAt,
+    'storageBytes': storageBytes,
+    'servingCapabilities': const <String>[],
