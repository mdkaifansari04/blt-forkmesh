@@ -0,0 +1,31 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('Android and iOS compile the identical pinned SHA1DC source set', () async {
+    final root = Directory.current;
+    final cmake = await File(
+      '${root.path}${Platform.pathSeparator}src'
+      '${Platform.pathSeparator}CMakeLists.txt',
+    ).readAsString();
+    final iosForwarder = await File(
+      '${root.path}${Platform.pathSeparator}ios${Platform.pathSeparator}Classes'
+      '${Platform.pathSeparator}forkmesh_sha1dc.c',
+    ).readAsString();
+    final android = await File(
+      '${root.path}${Platform.pathSeparator}android${Platform.pathSeparator}build.gradle',
+    ).readAsString();
+
+    for (final source in <String>[
+      'forkmesh_sha1dc_shim.c',
+      'third_party/sha1collisiondetection/lib/sha1.c',
+      'third_party/sha1collisiondetection/lib/ubc_check.c',
+    ]) {
+      expect(cmake, contains(source));
+      expect(iosForwarder, contains(source));
+    }
+    expect(cmake, contains('max-page-size=16384'));
+    expect(android, contains('path = "../src/CMakeLists.txt"'));
+  });
+}
