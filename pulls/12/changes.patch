+++ b/flutter_app/packages/forkmesh_sha1dc/lib/src/shattered_fixture_verifier.dart
@@ -0,0 +1,141 @@
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:forkmesh_git/forkmesh_git.dart';
+
+final List<ShatteredFixture> shatteredFixtures = <ShatteredFixture>[
+  ShatteredFixture(
+    name: 'shattered-1.pdf',
+    uri: Uri.parse('https://shattered.io/static/shattered-1.pdf'),
+    sha256: '2bb787a73e37352f92383abe7e2902936d1059ad9f1ba6daaa9c1e58ee6970d0',
+  ),
+  ShatteredFixture(
+    name: 'shattered-2.pdf',
+    uri: Uri.parse('https://shattered.io/static/shattered-2.pdf'),
+    sha256: 'd4488775d29bdef7993367d541064dbdda50d383f89f0aa13a6ff2e0894ba5ff',
+  ),
+];
+
+final class ShatteredFixture {
+  const ShatteredFixture({
+    required this.name,
+    required this.uri,
+    required this.sha256,
+  });
+
+  final String name;
+  final Uri uri;
+  final String sha256;
+}
+
+final class ShatteredVerificationOptions {
+  const ShatteredVerificationOptions._(this.nativeLibraryPath);
+
+  final String nativeLibraryPath;
+
+  static ShatteredVerificationOptions? tryParse(List<String> arguments) {
+    const optInFlag = '--accept-download';
+    final libraryArgument = arguments.where(
+      (argument) => argument.startsWith('--native-library='),
+    );
+    if (arguments.length != 2 ||
+        !arguments.contains(optInFlag) ||
+        libraryArgument.length != 1) {
+      return null;
+    }
+    final nativeLibraryPath = libraryArgument.single.substring(
+      '--native-library='.length,
+    );
+    if (nativeLibraryPath.isEmpty || !File(nativeLibraryPath).isAbsolute) {
+      return null;
+    }
+    return ShatteredVerificationOptions._(nativeLibraryPath);
+  }
+}
+
+final class ShatteredVerificationResult {
+  const ShatteredVerificationResult(this.rejectedFixtures);
+
+  final List<String> rejectedFixtures;
+}
+
+typedef ShatteredFixtureDownload = Future<Uint8List> Function(Uri uri);
+
+Future<ShatteredVerificationResult> verifyShatteredFixtures({
+  required GitSha1CollisionDetector detector,
+  required ShatteredFixtureDownload download,
+  List<ShatteredFixture>? fixtures,
+  Directory? temporaryParent,
+}) async {
+  final parent = temporaryParent ?? Directory.systemTemp;
+  final temporaryDirectory = await parent.createTemp('forkmesh-shattered-');
+  try {
+    final rejectedFixtures = <String>[];
+    for (final fixture in fixtures ?? shatteredFixtures) {
+      _validateFixtureSpec(fixture);
+      final bytes = await download(fixture.uri);
+      final fixtureFile = File(
+        '${temporaryDirectory.path}${Platform.pathSeparator}${fixture.name}',
+      );
+      await fixtureFile.writeAsBytes(bytes, flush: true);
+      final completeFixtureBytes = await fixtureFile.readAsBytes();
+      if (_sha256(completeFixtureBytes) != fixture.sha256) {
+        throw StateError('SHA-256 mismatch for ${fixture.name}');
+      }
+      final status = _screenCompleteBytes(detector, completeFixtureBytes);
+      if (status != GitSha1CollisionDetectorStatus.detected) {
+        throw StateError(
+          'SHA1DC did not reject ${fixture.name}: ${status.name}',
+        );
+      }
+      rejectedFixtures.add(fixture.name);
+    }
+    return ShatteredVerificationResult(
+      List<String>.unmodifiable(rejectedFixtures),
+    );
+  } finally {
+    if (await temporaryDirectory.exists()) {
+      await temporaryDirectory.delete(recursive: true);
+    }
+  }
+}
+
+String _sha256(List<int> bytes) {
+  final digest = ForkMeshSha256()..add(bytes);
+  return encodeLowerHex(digest.close());
+}
+
+GitSha1CollisionDetectorStatus _screenCompleteBytes(
+  GitSha1CollisionDetector detector,
+  List<int> bytes,
+) {
+  final session = detector.start();
+  try {
+    session.add(bytes);
+    return session.close();
+  } finally {
+    session.dispose();
+  }
+}
+
+void _validateFixtureSpec(ShatteredFixture fixture) {
+  if (!fixture.uri.isScheme('https') || fixture.uri.host != 'shattered.io') {
+    throw ArgumentError.value(
+      fixture.uri,
+      'fixture.uri',
+      'fixture URL must be an official HTTPS shattered.io URL',
+    );
+  }
+  if (!RegExp(r'^[a-f0-9]{64}$').hasMatch(fixture.sha256)) {
+    throw ArgumentError.value(
+      fixture.sha256,
+      'fixture.sha256',
+      'fixture SHA-256 must be lowercase hexadecimal',
+    );
+  }
+  if (fixture.name.isEmpty ||
+      fixture.name.contains('/') ||
+      fixture.name.contains('\\')) {
+    throw ArgumentError.value(fixture.name, 'fixture.name');
+  }
+}
