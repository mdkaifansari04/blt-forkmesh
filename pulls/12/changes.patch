+#!/usr/bin/env python3
+"""Relay federation source contract checks.
+
+The Worker depends on the Cloudflare Python runtime, so these tests pin the
+federation contract by reading the source files directly. They cover the pieces
+that let a second relay exist without accidentally sharing the main relay's D1
+state or weakening the relay approval gate.
+"""
+
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+ENTRY = ROOT / "src" / "entry.py"
+MIGRATION = ROOT / "migrations" / "0012_federation.sql"
+WRANGLER = ROOT / "wrangler.toml"
+DEPLOY = ROOT / "deploy.sh"
+MIGRATE = ROOT / "migrate.sh"
+ENV_EXAMPLE = ROOT / ".env.production.example"
+README = ROOT / "README.md"
+
+ENTRY_TEXT = ENTRY.read_text(encoding="utf-8")
+MIGRATION_TEXT = MIGRATION.read_text(encoding="utf-8")
+WRANGLER_TEXT = WRANGLER.read_text(encoding="utf-8")
+DEPLOY_TEXT = DEPLOY.read_text(encoding="utf-8")
+MIGRATE_TEXT = MIGRATE.read_text(encoding="utf-8")
+ENV_TEXT = ENV_EXAMPLE.read_text(encoding="utf-8")
+README_TEXT = README.read_text(encoding="utf-8")
+
+
+def test_federation_role_switch_is_main_relay_url_only():
+    assert "def _main_relay_url(env):" in ENTRY_TEXT
+    assert 'getattr(env, "MAIN_RELAY_URL", "")' in ENTRY_TEXT
+    assert "def _is_main_relay(env):" in ENTRY_TEXT
+    assert "return not _main_relay_url(env)" in ENTRY_TEXT
+
+
+def test_federation_canonical_contract_is_pinned():
+    assert 'FEDERATION_CANON = "forkmesh-federation-v1"' in ENTRY_TEXT
+    assert (
+        'FEDERATION_CANON + "\\n" + pubkey + "\\n" + str(ts) + "\\n" +'
+        in ENTRY_TEXT
+    )
+    assert "body_hash).encode()" in ENTRY_TEXT
+    assert "X-Relay-Pubkey" in ENTRY_TEXT
+    assert "X-Relay-Ts" in ENTRY_TEXT
+    assert "X-Relay-Sig" in ENTRY_TEXT
+
+
+def test_main_relay_federation_routes_are_wired():
+    for path in (
+        "/api/federation/register",
+        "/api/federation/donation-address",
+        "/api/federation/donation-status",
+        "/api/federation/nodes",
+        "/api/federation/treasury-address",
+    ):
+        assert path in ENTRY_TEXT
+    assert 'if url.path.startswith("/api/federation/"):' in ENTRY_TEXT
+    assert "return await federation_handler(self.env, request)" in ENTRY_TEXT
+
+
+def test_approval_gate_protects_custody_and_presence():
+    assert "async def _relay_authorized(env, request, body_str):" in ENTRY_TEXT
+    assert 'row.get("status") != "approved"' in ENTRY_TEXT
+    assert (
+        'return json_response({"error": "relay_not_approved"}, status=401)'
+        in ENTRY_TEXT
+    )
+    assert ENTRY_TEXT.count("relay_not_approved") >= 3
+
+
+def test_federated_relay_does_not_store_signup_deposit_secret():
+    assert "return await _federated_donation_address(env, request)" in ENTRY_TEXT
+    assert 'rec["fed_reference"] = reply.get("reference", "")' in ENTRY_TEXT
+    assert 'rec.pop("donation_secret", None)' in ENTRY_TEXT
+
+
+def test_federation_schema_exists_in_code_and_migration():
+    for table in ("relays", "federated_presence", "federated_signup", "relay_self"):
+        assert f"CREATE TABLE IF NOT EXISTS {table}" in ENTRY_TEXT
+    for table in ("relays", "federated_presence", "federated_signup"):
+        assert f"CREATE TABLE IF NOT EXISTS {table}" in MIGRATION_TEXT
+
+
+def test_health_exposes_relay_role_metadata():
+    assert '"relayRole":' in ENTRY_TEXT
+    assert '"federation":' in ENTRY_TEXT
+    assert '"mainRelayConfigured":' in ENTRY_TEXT
+    assert '"relayLabel":' in ENTRY_TEXT
+    assert '"publicBaseUrl":' in ENTRY_TEXT
+
+
+def test_second_relay_config_is_documented_and_guarded():
+    for token in (
+        "FORKMESH_WORKER_NAME",
+        "FORKMESH_D1_NAME",
+        "FORKMESH_D1_DATABASE_ID",
+        "MAIN_RELAY_URL",
+        "RELAY_LABEL",
+        "PUBLIC_BASE_URL",
+    ):
+        assert token in ENV_TEXT
+        assert token in DEPLOY_TEXT or token in MIGRATE_TEXT or token in README_TEXT
+    assert "require_safe_federated_target" in DEPLOY_TEXT
+    assert "PRIMARY_D1_DATABASE_ID" in DEPLOY_TEXT
+    assert "FORKMESH_D1_NAME" in MIGRATE_TEXT
+    assert "Second Relay Federation" in README_TEXT
+    assert "relayRole" in README_TEXT
