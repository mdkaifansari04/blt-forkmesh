new file mode 100644
index 00000000..6d8dd3cc
--- /dev/null
+++ b/flutter_app/spikes/mobile_git/ios_probe/test/probe_configuration_test.dart
@@ -0,0 +1,26 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('uses the SHA1DC adapter and an iOS 15 probe-only target', () async {
+    final root = Directory.current;
+    final pubspec = await File(
+      '${root.path}${Platform.pathSeparator}pubspec.yaml',
+    ).readAsString();
+    final project = await File(
+      '${root.path}${Platform.pathSeparator}ios${Platform.pathSeparator}'
+      'Runner.xcodeproj${Platform.pathSeparator}project.pbxproj',
+    ).readAsString();
+    final podfile = await File(
+      '${root.path}${Platform.pathSeparator}ios${Platform.pathSeparator}Podfile',
+    ).readAsString();
+
+    expect(pubspec, contains('forkmesh_sha1dc:'));
+    expect(pubspec, contains('path: ../../../packages/forkmesh_sha1dc'));
+    expect(project, isNot(contains('IPHONEOS_DEPLOYMENT_TARGET = 13.0;')));
+    expect(project, contains('IPHONEOS_DEPLOYMENT_TARGET = 15.0;'));
+    expect(podfile, contains("platform :ios, '15.0'"));
+    expect(podfile, isNot(contains("target 'RunnerTests'")));
+  });
+}
