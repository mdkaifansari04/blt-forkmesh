@@ -0,0 +1,63 @@
+import 'dart:io';
+
+import 'package:flutter/material.dart';
+import 'package:forkmesh_sha1dc/forkmesh_sha1dc.dart';
+
+import 'probe_runner.dart';
+
+void main() {
+  runApp(const MobileGitIosProbe());
+}
+
+class MobileGitIosProbe extends StatefulWidget {
+  const MobileGitIosProbe({super.key});
+
+  @override
+  State<MobileGitIosProbe> createState() => _MobileGitIosProbeState();
+}
+
+class _MobileGitIosProbeState extends State<MobileGitIosProbe> {
+  String _result = 'Running ForkMesh-owned Git probe...';
+
+  @override
+  void initState() {
+    super.initState();
+    _runOwnedEngine();
+  }
+
+  Future<void> _runOwnedEngine() async {
+    try {
+      final report = await ForkMeshIosProbeRunner(
+        detector: ForkMeshSha1dcDetector.loadForCurrentPlatform(),
+      ).run(Directory.systemTemp);
+      if (!mounted) return;
+      setState(() {
+        _result = report.localObjectAccepted && report.offlineReopenAccepted
+            ? 'SHA1DC ready, local/offline Git succeeded: ${report.commit.hex}\n'
+                  'Remote clone, fetch, and push remain blocked pending review.'
+            : 'ForkMesh-owned Git probe produced an invalid local state';
+      });
+    } on Object catch (error) {
+      if (!mounted) return;
+      setState(() {
+        _result = 'ForkMesh-owned Git probe failed: $error';
+      });
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return MaterialApp(
+      debugShowCheckedModeBanner: false,
+      home: Scaffold(
+        appBar: AppBar(title: const Text('ForkMesh-owned iOS Git probe')),
+        body: Center(
+          child: Padding(
+            padding: const EdgeInsets.all(24),
+            child: SelectableText(_result),
+          ),
+        ),
+      ),
+    );
+  }
+}
diff --git a/flutter_app/spikes/mobile_git/ios_probe/lib/probe_runner.dart b/flutter_app/spikes/mobile_git/ios_probe/lib/probe_runner.dart
new file mode 100644
index 00000000..8211650e
--- /dev/null
+++ b/flutter_app/spikes/mobile_git/ios_probe/lib/probe_runner.dart
@@ -0,0 +1,81 @@
+import 'dart:io';
+
+import 'package:forkmesh_git/forkmesh_git.dart';
+
+final class ForkMeshIosProbeReport {
+  const ForkMeshIosProbeReport({
+    required this.detectorReady,
+    required this.localObjectAccepted,
+    required this.offlineReopenAccepted,
+    required this.remoteOperationsBlocked,
+    required this.commit,
+  });
+
+  final bool detectorReady;
+  final bool localObjectAccepted;
+  final bool offlineReopenAccepted;
+  final bool remoteOperationsBlocked;
+  final GitObjectId commit;
+}
+
+final class ForkMeshIosProbeRunner {
+  const ForkMeshIosProbeRunner({required this.detector});
+
+  final GitSha1CollisionDetector detector;
+
+  Future<ForkMeshIosProbeReport> run(Directory parent) async {
+    final detectorSession = detector.start();
+    try {
+      detectorSession.add(<int>[0]);
+      if (detectorSession.close() != GitSha1CollisionDetectorStatus.clear) {
+        throw const GitException(
+          GitErrorCode.hashScreeningUnavailable,
+          'SHA1DC detector is not ready',
+        );
+      }
+    } finally {
+      detectorSession.dispose();
+    }
+
+    final root = await parent.createTemp('forkmesh-owned-ios-');
+    try {
+      final repository = await GitRepository.init(
+        GitRepositoryInit(root, detector: detector),
+      );
+      await File(
+        '${root.path}${Platform.pathSeparator}probe.txt',
+      ).writeAsString('ForkMesh-owned Git on iOS\n');
+      await repository.add(<GitWorktreePath>[GitWorktreePath('probe.txt')]);
+      final identity = GitIdentity(
+        name: 'ForkMesh iOS probe',
+        email: 'probe@example.test',
+        timestampSeconds: 0,
+        timezoneOffsetMinutes: 0,
+      );
+      final commit = await repository.commit(
+        GitCommitRequest(
+          message: 'Verify owned engine on iOS\n',
+          author: identity,
+          committer: identity,
+        ),
+      );
+      final localStatus = await repository.status();
+      await repository.dispose();
+      final reopened = await GitRepository.open(
+        GitRepositoryOpen(root, detector: detector),
+      );
+      final head = await reopened.readHeadObjectId();
+      final offlineStatus = await reopened.status();
+      await reopened.dispose();
+      return ForkMeshIosProbeReport(
+        detectorReady: true,
+        localObjectAccepted: localStatus.isClean,
+        offlineReopenAccepted: offlineStatus.isClean && head == commit,
+        remoteOperationsBlocked: true,
+        commit: commit,
+      );
+    } finally {
+      if (await root.exists()) await root.delete(recursive: true);
+    }
+  }
+}
