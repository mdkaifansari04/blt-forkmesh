diff --git a/flutter_app/packages/forkmesh_sha1dc/tool/verify_no_runtime_process_fallback.dart b/flutter_app/packages/forkmesh_sha1dc/tool/verify_no_runtime_process_fallback.dart
new file mode 100644
index 00000000..4c5aa452
--- /dev/null
+++ b/flutter_app/packages/forkmesh_sha1dc/tool/verify_no_runtime_process_fallback.dart
@@ -0,0 +1,43 @@
+import 'dart:io';
+
+Future<List<String>> findRuntimeFallbackViolations(
+  Directory packageRoot,
+) async {
+  final sourceRoot = Directory(
+    '${packageRoot.path}${Platform.pathSeparator}lib',
+  );
+  final violations = <String>[];
+  final forbiddenProcessApi = RegExp(
+    r'\bProcess\b|\bProcessStartMode\b|\bProcessSignal\b',
+  );
+  final forbiddenGitPackage = RegExp(
+    r'package:(?:git2dart|libgit2dart|git_on_dart|git2|dart_git|gix)',
+  );
+  final allowedNativeAssets = RegExp(
+    r"DynamicLibrary\.open\('"
+    r'(?:forkmesh_sha1dc\.framework/forkmesh_sha1dc|libforkmesh_sha1dc\.so)'
+    r"'\)",
+  );
+  await for (final entity in sourceRoot.list(recursive: true)) {
+    if (entity is! File || !entity.path.endsWith('.dart')) continue;
+    final content = await entity.readAsString();
+    final nativeAssetsRemoved = content.replaceAll(allowedNativeAssets, '');
+    if (forbiddenProcessApi.hasMatch(content) ||
+        forbiddenGitPackage.hasMatch(content) ||
+        content.contains('Termux') ||
+        nativeAssetsRemoved.contains('DynamicLibrary.open')) {
+      violations.add(entity.path);
+    }
+  }
+  return List<String>.unmodifiable(violations);
+}
+
+Future<void> main() async {
+  final violations = await findRuntimeFallbackViolations(Directory.current);
+  if (violations.isEmpty) {
+    stdout.writeln('sha1dc-runtime-no-fallback=PROVED');
+    return;
+  }
+  stderr.writeln('sha1dc-runtime-no-fallback=FAILED ${violations.join(',')}');
+  exitCode = 1;
+}
diff --git a/flutter_app/packages/forkmesh_sha1dc/tool/verify_sha1dc_provenance.dart b/flutter_app/packages/forkmesh_sha1dc/tool/verify_sha1dc_provenance.dart
new file mode 100644
index 00000000..24e5b521
--- /dev/null
+++ b/flutter_app/packages/forkmesh_sha1dc/tool/verify_sha1dc_provenance.dart
@@ -0,0 +1,137 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:forkmesh_git/forkmesh_git.dart';
+
+final class Sha1dcSourceLock {
+  const Sha1dcSourceLock({
+    required this.upstream,
+    required this.commit,
+    required this.archiveSha256,
+    required this.licenseSpdx,
+    required this.reviewedFiles,
+  });
+
+  final String upstream;
+  final String commit;
+  final String archiveSha256;
+  final String licenseSpdx;
+  final Map<String, String> reviewedFiles;
+
+  factory Sha1dcSourceLock.parse(Object? value) {
+    if (value is! Map<String, Object?>) {
+      throw const FormatException('source lock must be a JSON object');
+    }
+    final reviewed = value['reviewedFiles'];
+    if (reviewed is! Map<String, Object?>) {
+      throw const FormatException(
+        'source lock reviewedFiles must be an object',
+      );
+    }
+    final hashes = <String, String>{};
+    for (final entry in reviewed.entries) {
+      if (entry.value is! String) {
+        throw const FormatException('source lock file hashes must be strings');
+      }
+      hashes[entry.key] = entry.value as String;
+    }
+    return Sha1dcSourceLock(
+      upstream: _requiredString(value, 'upstream'),
+      commit: _requiredString(value, 'commit'),
+      archiveSha256: _requiredString(value, 'archiveSha256'),
+      licenseSpdx: _requiredString(value, 'licenseSpdx'),
+      reviewedFiles: Map<String, String>.unmodifiable(hashes),
+    );
+  }
+}
+
+final class Sha1dcProvenanceResult {
+  const Sha1dcProvenanceResult(this.lock, this.errors);
+
+  final Sha1dcSourceLock lock;
+  final List<String> errors;
+
+  bool get isValid => errors.isEmpty;
+}
+
+Future<Sha1dcProvenanceResult> verifySha1dcProvenance(
+  Directory packageRoot,
+) async {
+  final sourceRoot = Directory(
+    '${packageRoot.path}${Platform.pathSeparator}third_party'
+    '${Platform.pathSeparator}sha1collisiondetection',
+  );
+  final lockFile = File(
+    '${sourceRoot.path}${Platform.pathSeparator}SOURCE_LOCK.json',
+  );
+  final lock = Sha1dcSourceLock.parse(
+    jsonDecode(await lockFile.readAsString()),
+  );
+  final errors = <String>[];
+  if (!RegExp(r'^[0-9a-f]{40}$').hasMatch(lock.commit)) {
+    errors.add('source lock commit must be a lowercase SHA-1 revision');
+  }
+  if (!RegExp(r'^[0-9a-f]{64}$').hasMatch(lock.archiveSha256)) {
+    errors.add('source lock archiveSha256 must be lowercase SHA-256');
+  }
+  if (lock.licenseSpdx != 'MIT') {
+    errors.add('source lock license must be MIT');
+  }
+  final actualSourceFiles = <String>{};
+  await for (final entity in sourceRoot.list(recursive: true)) {
+    if (entity is! File) continue;
+    final relative = _relativePath(sourceRoot, entity);
+    if (relative == 'LICENSE.txt' ||
+        relative.endsWith('.c') ||
+        relative.endsWith('.h')) {
+      actualSourceFiles.add(relative);
+    }
+  }
+  if (actualSourceFiles.length != lock.reviewedFiles.length ||
+      !actualSourceFiles.containsAll(lock.reviewedFiles.keys)) {
+    errors.add('source inventory does not exactly match SOURCE_LOCK.json');
+  }
+  for (final entry in lock.reviewedFiles.entries) {
+    final file = File(
+      '${sourceRoot.path}${Platform.pathSeparator}'
+      '${entry.key.replaceAll('/', Platform.pathSeparator)}',
+    );
+    if (!await file.exists()) {
+      errors.add('missing reviewed source file: ${entry.key}');
+      continue;
+    }
+    final digest = ForkMeshSha256()..add(await file.readAsBytes());
+    if (encodeLowerHex(digest.close()) != entry.value) {
+      errors.add('source file digest mismatch: ${entry.key}');
+    }
+  }
+  return Sha1dcProvenanceResult(lock, List<String>.unmodifiable(errors));
+}
+
+String _requiredString(Map<String, Object?> value, String key) {
+  final result = value[key];
+  if (result is! String || result.isEmpty) {
+    throw FormatException('source lock $key must be a nonempty string');
+  }
+  return result;
+}
+
+String _relativePath(Directory root, File file) {
+  final prefix = '${root.path}${Platform.pathSeparator}';
+  if (!file.path.startsWith(prefix)) {
+    throw StateError('source file is outside the source root');
+  }
+  return file.path
+      .substring(prefix.length)
+      .replaceAll(Platform.pathSeparator, '/');
+}
+
+Future<void> main() async {
+  final result = await verifySha1dcProvenance(Directory.current);
+  if (result.isValid) {
+    stdout.writeln('sha1dc-provenance=PROVED');
+    return;
+  }
+  stderr.writeln(result.errors.join('\n'));
+  exitCode = 1;
+}
diff --git a/flutter_app/packages/forkmesh_sha1dc/tool/verify_shattered_opt_in.dart b/flutter_app/packages/forkmesh_sha1dc/tool/verify_shattered_opt_in.dart
new file mode 100644
