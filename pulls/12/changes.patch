@@ -0,0 +1,67 @@
+import 'dart:ffi';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:forkmesh_sha1dc/forkmesh_sha1dc.dart';
+import 'package:forkmesh_sha1dc/src/shattered_fixture_verifier.dart';
+
+Future<void> main(List<String> arguments) async {
+  final options = ShatteredVerificationOptions.tryParse(arguments);
+  if (options == null) {
+    stderr.writeln(
+      'Usage: dart run tool/verify_shattered_opt_in.dart '
+      '--accept-download --native-library=/absolute/path/to/library',
+    );
+    stderr.writeln(
+      'This opt-in tool temporarily downloads official Shattered fixtures, '
+      'verifies SHA-256, screens them with SHA1DC, and deletes them.',
+    );
+    exitCode = 2;
+    return;
+  }
+
+  try {
+    final detector = ForkMeshSha1dcDetector.fromLibrary(
+      DynamicLibrary.open(options.nativeLibraryPath),
+    );
+    final result = await verifyShatteredFixtures(
+      detector: detector,
+      download: _downloadOfficialFixture,
+    );
+    stdout.writeln(
+      'sha1dc-shattered=REJECTED fixtures=${result.rejectedFixtures.join(',')}',
+    );
+  } on Object catch (error, stackTrace) {
+    stderr.writeln('sha1dc-shattered=FAILED $error');
+    stderr.writeln(stackTrace);
+    exitCode = 1;
+  }
+}
+
+Future<Uint8List> _downloadOfficialFixture(Uri uri) async {
+  if (!uri.isScheme('https') || uri.host != 'shattered.io') {
+    throw ArgumentError.value(
+      uri,
+      'uri',
+      'only official HTTPS URLs are allowed',
+    );
+  }
+  final client = HttpClient();
+  try {
+    final request = await client.getUrl(uri);
+    final response = await request.close();
+    if (response.statusCode != HttpStatus.ok) {
+      throw HttpException(
+        'fixture download failed with HTTP ${response.statusCode}',
+        uri: uri,
+      );
+    }
+    final bytes = BytesBuilder(copy: false);
+    await for (final chunk in response) {
+      bytes.add(chunk);
+    }
+    return bytes.takeBytes();
+  } finally {
+    client.close(force: true);
+  }
+}
