@@ -0,0 +1,72 @@
+import 'dart:convert';
+import 'dart:ffi';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:forkmesh_git/forkmesh_git.dart';
+import 'package:forkmesh_sha1dc/forkmesh_sha1dc.dart';
+
+void main() {
+  late Directory buildDirectory;
+  late DynamicLibrary library;
+
+  setUpAll(() async {
+    buildDirectory = await Directory.systemTemp.createTemp('forkmesh-sha1dc-');
+    final output = File(
+      '${buildDirectory.path}${Platform.pathSeparator}libforkmesh_sha1dc.dylib',
+    );
+    final result = await Process.run('/usr/bin/cc', <String>[
+      '-dynamiclib',
+      '-std=c99',
+      '-fvisibility=hidden',
+      '-DSHA1DC_INIT_SAFE_HASH_DEFAULT=0',
+      '-I',
+      'src',
+      '-I',
+      'third_party/sha1collisiondetection/lib',
+      'src/forkmesh_sha1dc_shim.c',
+      'third_party/sha1collisiondetection/lib/sha1.c',
+      'third_party/sha1collisiondetection/lib/ubc_check.c',
+      '-o',
+      output.path,
+    ], workingDirectory: Directory.current.path);
+    expect(result.exitCode, 0, reason: result.stderr.toString());
+    library = DynamicLibrary.open(output.path);
+  });
+
+  tearDownAll(() => buildDirectory.delete(recursive: true));
+
+  test('reports clear SHA-1 input and preserves the canonical digest', () {
+    final detector = ForkMeshSha1dcDetector.fromLibrary(library);
+    final session = detector.start();
+    session.add(Uint8List.fromList(ascii.encode('blob 1\u0000x')));
+    final result = session.close();
+
+    expect(result, GitSha1CollisionDetectorStatus.clear);
+    expect(
+      GitObjectId.sha1Of(ascii.encode('blob 1\u0000x')).hex,
+      'c1b0730e0133447badcfd47fd144e254807b06e1',
+    );
+  });
+
+  test(
+    'approves a complete untrusted Git frame only after native screening',
+    () {
+      final frame = GitObjectFrame.encode(GitObjectType.blob, <int>[1, 2, 3]);
+      final result =
+          Sha1CollisionScreen(
+            detector: ForkMeshSha1dcDetector.fromLibrary(library),
+          ).screenFrame(
+            frame: frame,
+            objectType: GitObjectType.blob,
+            declaredBodySize: 3,
+            origin: GitSha1ObjectOrigin.untrustedTransport,
+            limits: GitResourceLimits(),
+          );
+
+      expect(result.decision, GitSha1ScreeningDecision.approved);
+      expect(result.digest, GitObjectId.sha1Of(frame).bytes);
+    },
+  );
+}
