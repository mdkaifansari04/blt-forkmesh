diff --git a/flutter_app/packages/forkmesh_sha1dc/src/forkmesh_sha1dc_shim.c b/flutter_app/packages/forkmesh_sha1dc/src/forkmesh_sha1dc_shim.c
new file mode 100644
index 00000000..e979280e
--- /dev/null
+++ b/flutter_app/packages/forkmesh_sha1dc/src/forkmesh_sha1dc_shim.c
@@ -0,0 +1,53 @@
+#include "forkmesh_sha1dc_shim.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "../third_party/sha1collisiondetection/lib/sha1.h"
+
+struct forkmesh_sha1dc_context {
+  SHA1_CTX sha1dc;
+  int finalized;
+};
+
+forkmesh_sha1dc_context *forkmesh_sha1dc_create(void) {
+  forkmesh_sha1dc_context *context = calloc(1, sizeof(*context));
+  if (context == NULL) {
+    return NULL;
+  }
+  SHA1DCInit(&context->sha1dc);
+  SHA1DCSetSafeHash(&context->sha1dc, 0);
+  return context;
+}
+
+int forkmesh_sha1dc_update(
+    forkmesh_sha1dc_context *context,
+    const uint8_t *bytes,
+    uint32_t length) {
+  if (context == NULL || context->finalized || (length != 0 && bytes == NULL)) {
+    return 1;
+  }
+  SHA1DCUpdate(&context->sha1dc, (const char *)bytes, length);
+  return 0;
+}
+
+int forkmesh_sha1dc_finish(
+    forkmesh_sha1dc_context *context,
+    uint8_t digest[20],
+    int *collision_detected) {
+  if (context == NULL || context->finalized || digest == NULL ||
+      collision_detected == NULL) {
+    return 1;
+  }
+  *collision_detected = SHA1DCFinal(digest, &context->sha1dc) != 0;
+  context->finalized = 1;
+  return 0;
+}
+
+void forkmesh_sha1dc_destroy(forkmesh_sha1dc_context *context) {
+  if (context == NULL) {
+    return;
+  }
+  memset(context, 0, sizeof(*context));
+  free(context);
+}
