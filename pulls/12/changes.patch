+++ b/flutter_app/packages/forkmesh_sha1dc/test/shattered_fixture_verifier_test.dart
@@ -0,0 +1,103 @@
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:forkmesh_git/forkmesh_git.dart';
+import 'package:forkmesh_sha1dc/src/shattered_fixture_verifier.dart';
+
+void main() {
+  test('pins the official Shattered URLs and SHA-256 values', () {
+    expect(shatteredFixtures.map((fixture) => fixture.uri.toString()), <String>[
+      'https://shattered.io/static/shattered-1.pdf',
+      'https://shattered.io/static/shattered-2.pdf',
+    ]);
+    expect(shatteredFixtures.map((fixture) => fixture.sha256), <String>[
+      '2bb787a73e37352f92383abe7e2902936d1059ad9f1ba6daaa9c1e58ee6970d0',
+      'd4488775d29bdef7993367d541064dbdda50d383f89f0aa13a6ff2e0894ba5ff',
+    ]);
+  });
+
+  test('requires an explicit download opt-in and native library path', () {
+    expect(ShatteredVerificationOptions.tryParse(<String>[]), isNull);
+    expect(
+      ShatteredVerificationOptions.tryParse(<String>['--accept-download']),
+      isNull,
+    );
+    expect(
+      ShatteredVerificationOptions.tryParse(<String>[
+        '--accept-download',
+        '--native-library=/tmp/libforkmesh_sha1dc.dylib',
+      ])!.nativeLibraryPath,
+      '/tmp/libforkmesh_sha1dc.dylib',
+    );
+  });
+
+  test(
+    'screens complete fixture bytes and leaves no temporary fixture files',
+    () async {
+      final temporaryParent = await createTemporaryDirectory();
+      addTearDown(() => temporaryParent.delete(recursive: true));
+      final first = Uint8List.fromList(<int>[1, 2, 3]);
+      final second = Uint8List.fromList(<int>[4, 5, 6]);
+      final fixtures = <ShatteredFixture>[
+        ShatteredFixture(
+          name: 'first.bin',
+          uri: Uri.parse('https://shattered.io/static/first.bin'),
+          sha256: sha256Of(first),
+        ),
+        ShatteredFixture(
+          name: 'second.bin',
+          uri: Uri.parse('https://shattered.io/static/second.bin'),
+          sha256: sha256Of(second),
+        ),
+      ];
+      final detector = _DetectedBytesDetector();
+
+      final result = await verifyShatteredFixtures(
+        detector: detector,
+        download: (uri) async =>
+            uri.path.endsWith('first.bin') ? first : second,
+        fixtures: fixtures,
+        temporaryParent: temporaryParent,
+      );
+
+      expect(result.rejectedFixtures, <String>['first.bin', 'second.bin']);
+      expect(detector.inputs, <List<int>>[first, second]);
+      expect(await temporaryParent.list().isEmpty, isTrue);
+    },
+  );
+}
+
+Future<Directory> createTemporaryDirectory() async =>
+    Directory.systemTemp.createTemp('forkmesh-shattered-test-');
+
+String sha256Of(List<int> bytes) {
+  final digest = ForkMeshSha256()..add(bytes);
+  return encodeLowerHex(digest.close());
+}
+
+final class _DetectedBytesDetector implements GitSha1CollisionDetector {
+  final List<List<int>> inputs = <List<int>>[];
+
+  @override
+  GitSha1CollisionDetectorSession start() => _DetectedBytesSession(inputs);
+}
+
+final class _DetectedBytesSession implements GitSha1CollisionDetectorSession {
+  _DetectedBytesSession(this._inputs);
+
+  final List<List<int>> _inputs;
+  final List<int> _bytes = <int>[];
+
+  @override
+  void add(List<int> bytes) => _bytes.addAll(bytes);
+
+  @override
+  GitSha1CollisionDetectorStatus close() {
+    _inputs.add(List<int>.unmodifiable(_bytes));
+    return GitSha1CollisionDetectorStatus.detected;
+  }
+
+  @override
+  void dispose() {}
+}
