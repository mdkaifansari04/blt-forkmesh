+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:forkmesh_git/forkmesh_git.dart';
+import 'package:forkmesh_owned_git_ios_probe/probe_runner.dart';
+
+void main() {
+  test(
+    'proves detector-backed local and offline behavior while remote stays blocked',
+    () async {
+      final root = await Directory.systemTemp.createTemp('forkmesh-ios-probe-');
+      addTearDown(() => root.delete(recursive: true));
+      final report = await ForkMeshIosProbeRunner(
+        detector: _ClearDetector(),
+      ).run(root);
+
+      expect(report.detectorReady, isTrue);
+      expect(report.localObjectAccepted, isTrue);
+      expect(report.offlineReopenAccepted, isTrue);
+      expect(report.remoteOperationsBlocked, isTrue);
+    },
+  );
+}
+
+final class _ClearDetector implements GitSha1CollisionDetector {
+  @override
+  GitSha1CollisionDetectorSession start() => _ClearDetectorSession();
+}
+
+final class _ClearDetectorSession implements GitSha1CollisionDetectorSession {
+  @override
+  void add(List<int> bytes) {}
+
+  @override
+  GitSha1CollisionDetectorStatus close() =>
+      GitSha1CollisionDetectorStatus.clear;
+
+  @override
+  void dispose() {}
