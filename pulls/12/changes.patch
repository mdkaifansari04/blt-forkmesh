@@ -0,0 +1,66 @@
+import 'dart:ffi';
+
+final class ForkMeshSha1dcContext extends Opaque {}
+
+final class ForkMeshSha1dcBindings {
+  ForkMeshSha1dcBindings(DynamicLibrary library)
+    : _create = library
+          .lookup<NativeFunction<Pointer<ForkMeshSha1dcContext> Function()>>(
+            'forkmesh_sha1dc_create',
+          )
+          .asFunction(),
+      _update = library
+          .lookup<
+            NativeFunction<
+              Int32 Function(
+                Pointer<ForkMeshSha1dcContext>,
+                Pointer<Uint8>,
+                Uint32,
+              )
+            >
+          >('forkmesh_sha1dc_update')
+          .asFunction(),
+      _finish = library
+          .lookup<
+            NativeFunction<
+              Int32 Function(
+                Pointer<ForkMeshSha1dcContext>,
+                Pointer<Uint8>,
+                Pointer<Int32>,
+              )
+            >
+          >('forkmesh_sha1dc_finish')
+          .asFunction(),
+      _destroy = library
+          .lookup<
+            NativeFunction<Void Function(Pointer<ForkMeshSha1dcContext>)>
+          >('forkmesh_sha1dc_destroy')
+          .asFunction();
+
+  final Pointer<ForkMeshSha1dcContext> Function() _create;
+  final int Function(Pointer<ForkMeshSha1dcContext>, Pointer<Uint8>, int)
+  _update;
+  final int Function(
+    Pointer<ForkMeshSha1dcContext>,
+    Pointer<Uint8>,
+    Pointer<Int32>,
+  )
+  _finish;
+  final void Function(Pointer<ForkMeshSha1dcContext>) _destroy;
+
+  Pointer<ForkMeshSha1dcContext> create() => _create();
+
+  int update(
+    Pointer<ForkMeshSha1dcContext> context,
+    Pointer<Uint8> bytes,
+    int length,
+  ) => _update(context, bytes, length);
+
+  int finish(
+    Pointer<ForkMeshSha1dcContext> context,
+    Pointer<Uint8> digest,
+    Pointer<Int32> collisionDetected,
+  ) => _finish(context, digest, collisionDetected);
+
+  void destroy(Pointer<ForkMeshSha1dcContext> context) => _destroy(context);
+}
diff --git a/flutter_app/packages/forkmesh_sha1dc/lib/src/sha1dc_detector.dart b/flutter_app/packages/forkmesh_sha1dc/lib/src/sha1dc_detector.dart
new file mode 100644
index 00000000..0d489d52
--- /dev/null
+++ b/flutter_app/packages/forkmesh_sha1dc/lib/src/sha1dc_detector.dart
@@ -0,0 +1,115 @@
+import 'dart:ffi';
+import 'dart:io';
+
+import 'package:ffi/ffi.dart';
+import 'package:forkmesh_git/forkmesh_git.dart';
+
+import 'sha1dc_bindings.dart';
+
+final class ForkMeshSha1dcDetector implements GitSha1CollisionDetector {
+  ForkMeshSha1dcDetector._(this._bindings);
+
+  final ForkMeshSha1dcBindings? _bindings;
+
+  factory ForkMeshSha1dcDetector.loadForCurrentPlatform() {
+    try {
+      return ForkMeshSha1dcDetector._(
+        ForkMeshSha1dcBindings(_openForkMeshSha1dcLibrary()),
+      );
+    } on Object {
+      return ForkMeshSha1dcDetector._(null);
+    }
+  }
+
+  factory ForkMeshSha1dcDetector.fromLibrary(DynamicLibrary library) =>
+      ForkMeshSha1dcDetector._(ForkMeshSha1dcBindings(library));
+
+  @override
+  GitSha1CollisionDetectorSession start() {
+    final bindings = _bindings;
+    if (bindings == null) return _UnavailableSha1dcSession();
+    final context = bindings.create();
+    if (context == nullptr) return _UnavailableSha1dcSession();
+    return _ForkMeshSha1dcSession(bindings, context);
+  }
+}
+
+final class _ForkMeshSha1dcSession implements GitSha1CollisionDetectorSession {
+  _ForkMeshSha1dcSession(this._bindings, this._context);
+
+  final ForkMeshSha1dcBindings _bindings;
+  final Pointer<ForkMeshSha1dcContext> _context;
+  var _finished = false;
+  var _disposed = false;
+  var _failed = false;
+
+  @override
+  void add(List<int> bytes) {
+    if (_finished || _disposed) {
+      throw StateError('collision detector session is closed');
+    }
+    if (_failed || bytes.isEmpty) return;
+    if (bytes.length > 0xffffffff) {
+      _failed = true;
+      return;
+    }
+    using((arena) {
+      final nativeBytes = arena<Uint8>(bytes.length);
+      nativeBytes.asTypedList(bytes.length).setAll(0, bytes);
+      if (_bindings.update(_context, nativeBytes, bytes.length) != 0) {
+        _failed = true;
+      }
+    });
+  }
+
+  @override
+  GitSha1CollisionDetectorStatus close() {
+    if (_finished || _disposed) return GitSha1CollisionDetectorStatus.failed;
+    _finished = true;
+    try {
+      if (_failed) return GitSha1CollisionDetectorStatus.failed;
+      return using((arena) {
+        final digest = arena<Uint8>(20);
+        final collisionDetected = arena<Int32>();
+        if (_bindings.finish(_context, digest, collisionDetected) != 0) {
+          return GitSha1CollisionDetectorStatus.failed;
+        }
+        return collisionDetected.value == 0
+            ? GitSha1CollisionDetectorStatus.clear
+            : GitSha1CollisionDetectorStatus.detected;
+      });
+    } finally {
+      dispose();
+    }
+  }
+
+  @override
+  void dispose() {
+    if (_disposed) return;
+    _disposed = true;
+    _bindings.destroy(_context);
+  }
+}
+
+final class _UnavailableSha1dcSession
+    implements GitSha1CollisionDetectorSession {
+  @override
+  void add(List<int> bytes) {}
+
+  @override
+  GitSha1CollisionDetectorStatus close() =>
+      GitSha1CollisionDetectorStatus.unavailable;
+
+  @override
+  void dispose() {}
+}
+
+DynamicLibrary _openForkMeshSha1dcLibrary() {
+  if (Platform.isIOS || Platform.isMacOS) {
+    return DynamicLibrary.open('forkmesh_sha1dc.framework/forkmesh_sha1dc');
+  }
+  if (Platform.isAndroid || Platform.isLinux) {
+    return DynamicLibrary.open('libforkmesh_sha1dc.so');
+  }
+  throw UnsupportedError('unsupported platform: ${Platform.operatingSystem}');
+}
