index 00000000..b528a322
--- /dev/null
+++ b/flutter_app/spikes/mobile_git/ios_probe/integration_test/sha1dc_ios_probe_test.dart
@@ -0,0 +1,138 @@
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:forkmesh_git/forkmesh_git.dart';
+import 'package:forkmesh_owned_git_ios_probe/probe_runner.dart';
+import 'package:forkmesh_sha1dc/forkmesh_sha1dc.dart';
+import 'package:forkmesh_sha1dc/src/shattered_fixture_verifier.dart';
+import 'package:integration_test/integration_test.dart';
+
+const _acceptFixtureDownload = bool.fromEnvironment(
+  'FORKMESH_ACCEPT_SHATTERED_DOWNLOAD',
+);
+
+void main() {
+  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+
+  testWidgets(
+    'uses the iOS SHA1DC artifact for local, collision, and cancellation gates',
+    (tester) async {
+      final detector = ForkMeshSha1dcDetector.loadForCurrentPlatform();
+      final ready = detector.start();
+      try {
+        ready.add(<int>[0]);
+        expect(ready.close(), GitSha1CollisionDetectorStatus.clear);
+      } finally {
+        ready.dispose();
+      }
+
+      final localReport = await ForkMeshIosProbeRunner(
+        detector: detector,
+      ).run(Directory.systemTemp);
+      expect(localReport.detectorReady, isTrue);
+      expect(localReport.localObjectAccepted, isTrue);
+      expect(localReport.offlineReopenAccepted, isTrue);
+      expect(localReport.remoteOperationsBlocked, isTrue);
+
+      final normalFrame = GitObjectFrame.encode(GitObjectType.blob, <int>[
+        1,
+        2,
+        3,
+      ]);
+      final normalScreening = Sha1CollisionScreen(detector: detector)
+          .screenFrame(
+            frame: normalFrame,
+            objectType: GitObjectType.blob,
+            declaredBodySize: 3,
+            origin: GitSha1ObjectOrigin.untrustedTransport,
+            limits: GitResourceLimits(),
+          );
+      expect(normalScreening.decision, GitSha1ScreeningDecision.approved);
+
+      final collisionReport = await verifyShatteredFixtures(
+        detector: detector,
+        download: _downloadOfficialFixture,
+      );
+      expect(collisionReport.rejectedFixtures, <String>[
+        'shattered-1.pdf',
+        'shattered-2.pdf',
+      ]);
+
+      final cancellation = GitCancellationToken()..cancel();
+      final cancellationResult = Sha1CollisionScreen(detector: detector)
+          .screenFrame(
+            frame: GitObjectFrame.encode(GitObjectType.blob, <int>[1]),
+            objectType: GitObjectType.blob,
+            declaredBodySize: 1,
+            origin: GitSha1ObjectOrigin.untrustedTransport,
+            limits: GitResourceLimits(),
+            cancellation: cancellation,
+          );
+      expect(cancellationResult.decision, GitSha1ScreeningDecision.cancelled);
+
+      final repositoryRoot = await Directory.systemTemp.createTemp(
+        'forkmesh-ios-cancellation-',
+      );
+      try {
+        final repository = await GitRepository.init(
+          GitRepositoryInit(repositoryRoot, detector: detector),
+        );
+        final head = File(
+          '${repository.gitDirectory.path}${Platform.pathSeparator}HEAD',
+        );
+        final headBefore = await head.readAsString();
+        final quarantine = await GitObjectQuarantine.begin(
+          repository.gitDirectory,
+          cancellation: cancellation,
+        );
+
+        await expectLater(
+          () => quarantine.stage('incoming.pack', <int>[1]),
+          throwsA(
+            isA<GitException>().having(
+              (error) => error.code,
+              'code',
+              GitErrorCode.cancelled,
+            ),
+          ),
+        );
+        await GitObjectQuarantine.recover(repository.gitDirectory);
+        expect(await quarantine.directory.exists(), isFalse);
+        expect(await head.readAsString(), headBefore);
+        await repository.dispose();
+      } finally {
+        await repositoryRoot.delete(recursive: true);
+      }
+    },
+    skip: !_acceptFixtureDownload,
+  );
+}
+
+Future<Uint8List> _downloadOfficialFixture(Uri uri) async {
+  if (!uri.isScheme('https') || uri.host != 'shattered.io') {
+    throw ArgumentError.value(
+      uri,
+      'uri',
+      'only official HTTPS URLs are allowed',
+    );
+  }
+  final client = HttpClient();
+  try {
+    final request = await client.getUrl(uri);
+    final response = await request.close();
+    if (response.statusCode != HttpStatus.ok) {
+      throw HttpException(
+        'fixture download failed with HTTP ${response.statusCode}',
+        uri: uri,
+      );
+    }
+    final bytes = BytesBuilder(copy: false);
+    await for (final chunk in response) {
+      bytes.add(chunk);
+    }
+    return bytes.takeBytes();
+  } finally {
+    client.close(force: true);
+  }
+}
