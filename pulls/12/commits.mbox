+                  _Chip(icon: Icons.info_outline, label: session.statusLabel),
+                  if (session.model.isNotEmpty)
+                    _Chip(icon: Icons.memory_outlined, label: session.model),
+                  if (session.issueNumber > 0)
+                    _Chip(
+                      icon: Icons.error_outline,
