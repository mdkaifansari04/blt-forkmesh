+def _clean_profile_timezone(raw):
+    value = clean_string(raw, MAX_PROFILE_TIMEZONE).strip()
+    if not value:
+        return ""
+    if not re.match(r"^[A-Za-z0-9_./+-]{1,80}$", value):
+        return ""
+    return value
+
+
+async def _profile_catalog_owner_names(env, name):
+    name = clean_string(name, MAX_NODE_NAME).lower()
+    names = [name] if valid_node_name(name) else []
+    _, rec = await _account_row(env, name) if name else ("", None)
+    if rec:
+        for node in _owned_nodes(rec):
+            clean = clean_string(node, MAX_NODE_NAME).lower()
+            if valid_node_name(clean) and clean not in names:
+                names.append(clean)
+    return names
+
+
+async def _account_mirror_count(env, name):
+    total = 0
+    for owner in await _profile_catalog_owner_names(env, name):
+        owner_bi = await blind_index(env, owner)
+        row = await d1_first(
+            env,
+            "SELECT COUNT(*) AS n FROM repositories WHERE owner_bi=? AND is_private = 0",
+            owner_bi,
+        )
+        try:
+            total += int((row or {}).get("n", 0) or 0)
+        except (TypeError, ValueError):
+            pass
+    return total
+
+
+async def _account_social_counts(env, name, viewer_name=""):
+    name = clean_string(name, MAX_NODE_NAME).lower()
+    if not valid_node_name(name):
+        return {
+            "followers": 0,
+            "following": 0,
+            "mirrorCount": 0,
+            "isFollowing": False,
+        }
+    target_bi = await blind_index(env, name)
+    followers_row = await d1_first(
+        env, "SELECT COUNT(*) AS n FROM profile_follows WHERE target_bi=?",
+        target_bi)
+    following_row = await d1_first(
+        env, "SELECT COUNT(*) AS n FROM profile_follows WHERE follower_bi=?",
+        target_bi)
+    is_following = False
+    viewer = clean_string(viewer_name, MAX_NODE_NAME).lower()
+    if valid_node_name(viewer) and viewer != name:
+        viewer_bi = await blind_index(env, viewer)
+        row = await d1_first(
+            env,
+            "SELECT 1 AS yes FROM profile_follows WHERE follower_bi=? AND target_bi=?",
+            viewer_bi, target_bi)
+        is_following = bool(row)
+    return {
+        "followers": int((followers_row or {}).get("n", 0) or 0),
+        "following": int((following_row or {}).get("n", 0) or 0),
+        "mirrorCount": await _account_mirror_count(env, name),
+        "isFollowing": is_following,
+    }
+
