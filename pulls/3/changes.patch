+def test_confirmation_requires_test_and_publishes_only_once():
+    campaign_id = "b" * 24
+    runs = []
+    publishes = []
+    state = {"status": "draft", "tested": False}
+
+    async def d1_first(_env, sql, *_args):
+        if sql.startswith("SELECT id,status,data"):
+            return {
+                "id": campaign_id,
+                "status": state["status"],
+                "data": {"test_sent_at": 10 if state["tested"] else 0},
+            }
+        if sql.startswith("UPDATE email_campaigns"):
+            if state["status"] != "draft":
+                return None
+            state["status"] = "queued"
+            return {"id": campaign_id}
+        if sql.startswith("SELECT id FROM email_campaigns"):
+            return {"id": campaign_id}
+        raise AssertionError(sql)
+
+    async def d1_run(_env, sql, *args):
+        runs.append((sql, args))
+
+    async def decrypt_row(_env, value):
+        return dict(value)
+
+    async def publish(_env, value):
+        publishes.append(value)
+        return 2
+
+    campaigns = _load_email_admin_campaigns(
+        {
+            "d1_first": d1_first,
+            "d1_run": d1_run,
+            "decrypt_row": decrypt_row,
+            "_email_admin_publish_deliveries": publish,
+        }
+    )
+    env = SimpleNamespace(EMAIL_QUEUE=object())
+
+    with pytest.raises(ValueError, match="successful test"):
+        asyncio.run(
+            campaigns["_email_admin_confirm_campaign"](env, campaign_id)
+        )
+    assert runs == []
+    assert publishes == []
+
+    state["tested"] = True
+    with pytest.raises(ValueError, match="queue is not configured"):
+        asyncio.run(
+            campaigns["_email_admin_confirm_campaign"](
+                SimpleNamespace(), campaign_id
+            )
+        )
+    assert state["status"] == "draft"
+    assert runs == []
+    assert publishes == []
+
+    assert asyncio.run(
+        campaigns["_email_admin_confirm_campaign"](env, campaign_id)
+    ) is True
+    assert asyncio.run(
+        campaigns["_email_admin_confirm_campaign"](env, campaign_id)
+    ) is False
+    assert len(publishes) == 1
+    assert publishes == [campaign_id]
+    assert len(runs) == 1
+    assert "UPDATE email_deliveries" in runs[0][0]
