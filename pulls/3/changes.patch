+        EMAIL_ADMIN_PATH
+        + "?view="
+        + quote(active, safe="")
+        + "&notice="
+        + quote(str(notice)[:240], safe="")
+    )
+    if campaign_id:
+        location += "&campaign=" + quote(str(campaign_id), safe="")
+    return location
