+        _email_admin_id(row.get("id"), "category"): normalize_category_name(
+            row.get("name")
+        )
+        for row in live
+    }
+    if any(category_id not in category_names for category_id in selected):
+        raise ValueError("unknown category")
+
+    template_record_id = _email_admin_id(template_id, "template")
+    template = await d1_first(
+        env,
+        "SELECT id,name,data FROM email_templates WHERE id=?",
+        template_record_id,
+    )
+    if not template:
+        raise ValueError("template not found")
+    stored = await decrypt_row(env, template.get("data"))
+    if not isinstance(stored, dict):
+        raise ValueError("template content is unavailable")
+    submitted_subject = str(subject or "").strip()
+    submitted_body = str(body or "").strip()
+    _template_name, final_subject, final_body = normalize_template_values(
+        template.get("name"),
+        submitted_subject or stored.get("subject"),
+        submitted_body or stored.get("body"),
+    )
+
+    selected_row = await d1_first(
+        env,
+        "SELECT COUNT(*) AS n FROM email_category_memberships "
+        "WHERE category_id IN ("
+        + placeholders
+        + ")",
