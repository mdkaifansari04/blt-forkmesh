+def normalize_category_name(value):
+    if not isinstance(value, str) or _has_unsafe_text_character(value):
+        raise ValueError("category name contains invalid characters")
+    name = unicodedata.normalize("NFC", value).strip()
+    if not name:
+        raise ValueError("category name is required")
+    if len(name) > 80:
+        raise ValueError("category name must be 80 characters or fewer")
+    return name
+
+
+def normalize_recipient_record(email, name="", company=""):
+    normalized_email = normalize_email(email)
+    if not normalized_email:
+        raise ValueError("valid recipient email is required")
+    if not _valid_metadata(name):
+        raise ValueError("recipient name contains invalid characters")
+    if not _valid_metadata(company):
+        raise ValueError("recipient company contains invalid characters")
+    return {
+        "email": normalized_email,
+        "name": _clean_field(name, 120),
+        "company": _clean_field(company, 160),
+    }
+
+
+def _has_unsafe_multiline_character(value):
+    for character in value:
+        if character in "\r\n\t":
+            continue
+        category = unicodedata.category(character)
+        if category.startswith("C") or category in UNSAFE_SEPARATOR_CATEGORIES:
+            return True
+    return False
+
+
+def normalize_template_values(name, subject, body):
+    if not all(isinstance(value, str) for value in (name, subject, body)):
+        raise ValueError("template name, subject, and body are required")
+    clean_name = unicodedata.normalize("NFC", name).strip()
+    clean_subject = subject.strip()
+    clean_body = body.strip()
+    if not clean_name or not clean_subject or not clean_body:
+        raise ValueError("template name, subject, and body are required")
+    if len(clean_name) > 120:
+        raise ValueError("template name must be 120 characters or fewer")
+    if len(clean_subject) > 240:
+        raise ValueError("template subject must be 240 characters or fewer")
+    if len(clean_body) > 32_000:
+        raise ValueError("template body must be 32000 characters or fewer")
+    if _has_unsafe_text_character(clean_name):
+        raise ValueError("template name contains invalid characters")
+    if _has_unsafe_multiline_character(clean_body):
+        raise ValueError("template body contains invalid characters")
+    render_message(
+        clean_subject,
+        clean_body,
+        {
+            "email": "preview@example.com",
+            "name": "Preview",
+            "company": "ForkMesh",
+        },
+    )
+    return clean_name, clean_subject, clean_body
