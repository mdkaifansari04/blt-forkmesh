+    <script>
+      (() => {
+        const root = document.getElementById("leaderboards");
+        if (!root) return;
+        if (location.protocol === "file:") {
+          root.innerHTML = '<div class="board-empty">Preview only.</div>';
+          return;
+        }
+        const fmtMinutes = (m) => {
+          m = Number(m) || 0;
+          const h = Math.floor(m / 60);
+          const min = m % 60;
+          if (h && min) return `${h}h ${min}m`;
+          if (h) return `${h}h`;
+          return `${min}m`;
+        };
+        const plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
+        function board(title, sub, rows, render) {
+          const box = document.createElement("div");
+          box.className = "board";
+          const h = document.createElement("h3");
+          h.textContent = title;
+          box.appendChild(h);
+          const s = document.createElement("p");
+          s.className = "board-sub";
+          s.textContent = sub;
+          box.appendChild(s);
+          if (!rows.length) {
+            const empty = document.createElement("div");
+            empty.className = "board-empty";
+            empty.textContent = "No data yet.";
+            box.appendChild(empty);
+            return box;
+          }
+          rows.forEach((row, i) => {
+            const r = document.createElement("div");
+            r.className = "board-row";
+            const rank = document.createElement("span");
+            rank.className = "board-rank";
+            rank.textContent = `${i + 1}`;
+            const name = document.createElement("span");
+            name.className = "board-name";
+            name.textContent = row.name || "node";
+            const value = document.createElement("span");
+            value.className = "board-value";
+            value.textContent = render(row);
+            r.append(rank, name, value);
+            box.appendChild(r);
+          });
+          return box;
+        }
+        async function render() {
+          let data;
+          try {
+            const res = await fetch("/api/network/leaderboards", {
+              headers: { accept: "application/json" },
+            });
+            if (!res.ok) throw new Error("HTTP " + res.status);
+            data = await res.json();
+          } catch (_) {
+            root.innerHTML =
+              '<div class="board-empty">Leaderboards unavailable right now.</div>';
+            return;
+          }
+          const arr = (k) => (Array.isArray(data[k]) ? data[k] : []);
+          const hours = Number(data.windowHours) || 48;
+          const fmtAge = (ms) => {
+            const d = Math.floor((Number(ms) || 0) / 86400000);
+            if (d >= 1) return plural(d, "day");
+            const h = Math.floor((Number(ms) || 0) / 3600000);
+            return plural(h, "hour");
+          };
+          const fmtSol = (row) => {
+            const sol = Number(row.sol) || (Number(row.lamports) || 0) / 1e9;
+            return `${sol.toFixed(sol >= 1 ? 2 : 4)} SOL`;
+          };
+          const fmtBytes = (b) => {
+            b = Number(b) || 0;
+            const units = ["B", "KB", "MB", "GB", "TB"];
+            let u = 0;
+            while (b >= 1024 && u < units.length - 1) { b /= 1024; u++; }
+            return `${u === 0 ? b : b.toFixed(1)} ${units[u]}`;
+          };
+          root.innerHTML = "";
+          root.appendChild(board(
+            "Mainnode uptime", `Most minutes online · last ${hours}h`,
+            arr("uptime"), (row) => fmtMinutes(row.minutes)));
+          root.appendChild(board(
+            "Top owners", "Most public repositories",
+            arr("repos"), (row) => plural(Number(row.repos) || 0, "repo")));
+          root.appendChild(board(
+            "Most mirrored", "Repositories hosted under the most owners",
+            arr("mirrors"), (row) => plural(Number(row.mirrors) || 0, "owner")));
+          root.appendChild(board(
+            "Longest hosted", "Repositories online the longest",
+            arr("hosted"), (row) => fmtAge(row.ageMs)));
+          root.appendChild(board(
+            "Largest repos", "Most mirror data per repository",
+            arr("largest"), (row) => fmtBytes(row.bytes)));
+          root.appendChild(board(
+            "Most data hosted", "Mirror data hosted per owner",
+            arr("dataHosted"), (row) => fmtBytes(row.bytes)));
+          root.appendChild(board(
+            "Contributor activity", "Issues + pull requests + commits",
+            arr("contributors"), (row) => plural(Number(row.total) || 0, "contribution")));
+          root.appendChild(board(
+            "Funds · mainnodes", "Most received from the node split",
+            arr("fundsMainnodes"), fmtSol));
+          root.appendChild(board(
+            "Funds · contributors", "Most received from bounties",
+            arr("fundsContributors"), fmtSol));
+          root.appendChild(board(
+            "Funds · projects", "Most bounty funds earned",
+            arr("fundsProjects"), fmtSol));
+        }
+        render();
+        setInterval(render, 60000);
+      })();
+    </script>
