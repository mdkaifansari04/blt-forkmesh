+  Future<String> blob(String owner, String name, String path) async {
+    final uri = _base('/api/repo/$owner/$name/blob').replace(
+        queryParameters: {'path': path});
+    final resp = await http
+        .get(uri, headers: {'Accept': 'text/plain, application/json'})
+        .timeout(const Duration(seconds: 20));
+    if (resp.statusCode >= 200 && resp.statusCode < 300) return resp.body;
+    throw Exception('HTTP ${resp.statusCode} for ${uri.path}');
+  }
