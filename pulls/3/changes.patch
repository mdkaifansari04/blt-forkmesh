diff --git a/cloudflare_worker/tests/test_d1_helpers.py b/cloudflare_worker/tests/test_d1_helpers.py
new file mode 100644
index 0000000..b7a22a1
--- /dev/null
+++ b/cloudflare_worker/tests/test_d1_helpers.py
@@ -0,0 +1,89 @@
+import ast
+import asyncio
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+
+ENTRY = Path(__file__).resolve().parents[1] / "src" / "entry.py"
+
+
+def load_d1_helpers():
+    tree = ast.parse(ENTRY.read_text(encoding="utf-8"))
+    names = {"_d1_is_nullish", "d1_row_to_py", "d1_first", "d1_all"}
+    nodes = [
+        node
+        for node in tree.body
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        and node.name in names
+    ]
+    module = ast.Module(body=nodes, type_ignores=[])
+    ast.fix_missing_locations(module)
+    namespace = {}
+    exec(compile(module, str(ENTRY), "exec"), namespace)
+    return namespace
+
+
+class JsNull:
+    def __iter__(self):
+        raise TypeError("'JsNull' object is not iterable")
+
+
+class FakeStatement:
+    def __init__(self, first_result=None, all_results=None):
+        self.first_result = first_result
+        self.all_results = all_results or []
+        self.bound_args = None
+
+    def bind(self, *args):
+        self.bound_args = args
+        return self
+
+    async def first(self):
+        return self.first_result
+
+    async def all(self):
+        return SimpleNamespace(results=self.all_results)
+
+
+class FakeDB:
+    def __init__(self, statement):
+        self.statement = statement
+
+    def prepare(self, _sql):
+        return self.statement
+
+
+class FakeEnv:
+    def __init__(self, statement):
+        self.DB = FakeDB(statement)
+
+
+class D1HelperTest(unittest.TestCase):
+    def test_d1_first_treats_pyodide_jsnull_as_no_row(self):
+        helpers = load_d1_helpers()
+        statement = FakeStatement(first_result=JsNull())
+
+        row = asyncio.run(helpers["d1_first"](FakeEnv(statement), "SELECT 1", "arg"))
+
+        self.assertIsNone(row)
+        self.assertEqual(statement.bound_args, ("arg",))
+
+    def test_d1_all_ignores_nullish_rows_but_keeps_mappings(self):
+        helpers = load_d1_helpers()
+        statement = FakeStatement(all_results=[JsNull(), {"n": 1}])
+
+        rows = asyncio.run(helpers["d1_all"](FakeEnv(statement), "SELECT 1"))
+
+        self.assertEqual(rows, [{"n": 1}])
+
+    def test_d1_first_rejects_malformed_non_null_rows(self):
+        helpers = load_d1_helpers()
+        statement = FakeStatement(first_result=object())
+
+        with self.assertRaises(TypeError):
+            asyncio.run(helpers["d1_first"](FakeEnv(statement), "SELECT 1"))
+
+
+if __name__ == "__main__":
+    unittest.main()
