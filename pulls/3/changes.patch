+def _email_admin_import_error_banner(errors):
+    labels = {
+        "invalid_json": "invalid JSON",
+        "array_required": "a JSON array is required",
+        "payload_too_large": "the JSON payload is too large",
+        "recipient_limit_exceeded": "the recipient limit was exceeded",
+        "recipient_must_be_string_or_object": "use an email string or object",
+        "invalid_email": "invalid email",
+        "invalid_name": "invalid name",
+        "invalid_company": "invalid company",
+    }
+    details = []
+    for error in errors[:8]:
+        try:
+            index = int(error.get("index", -1))
+        except (AttributeError, TypeError, ValueError):
+            index = -1
+        code = error.get("error", "invalid recipient") if isinstance(
+            error, dict
+        ) else "invalid recipient"
+        location = "request" if index < 0 else "item " + str(index + 1)
+        details.append(location + ": " + labels.get(code, "invalid recipient"))
+    remaining = max(0, len(errors) - len(details))
+    suffix = (
+        "; plus " + str(remaining) + " more error(s)" if remaining else ""
+    )
+    return "Import blocked. " + "; ".join(details) + suffix + "."
+
