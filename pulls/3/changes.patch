+async def _email_admin_load_draft(env, campaign_id):
+    record_id = _email_admin_campaign_id(campaign_id)
+    row = await d1_first(
+        env,
+        "SELECT id,status,data,created_at,reviewed_at,queued_at "
+        "FROM email_campaigns WHERE id=?",
+        record_id,
+    )
+    if not row:
+        raise ValueError("campaign not found")
+    snapshot = await decrypt_row(env, row.get("data"))
+    if not isinstance(snapshot, dict):
+        raise ValueError("campaign content is unavailable")
+
+    def safe_count(key):
+        try:
+            return max(0, int(snapshot.get(key) or 0))
+        except (TypeError, ValueError):
+            return 0
+
+    _name, subject, body = normalize_template_values(
+        "Campaign", snapshot.get("subject"), snapshot.get("body")
+    )
+    preview_recipient = {
+        "email": "preview@example.com",
+        "name": "Preview",
+        "company": "ForkMesh",
+    }
+    delivery = await d1_first(
+        env,
+        "SELECT data FROM email_deliveries WHERE campaign_id=? ORDER BY id LIMIT 1",
+        record_id,
+    )
+    if delivery:
+        delivery_snapshot = await decrypt_row(env, delivery.get("data"))
+        if isinstance(delivery_snapshot, dict):
+            try:
+                preview_recipient = normalize_recipient_record(
+                    delivery_snapshot.get("email"),
+                    delivery_snapshot.get("name", ""),
+                    delivery_snapshot.get("company", ""),
+                )
+            except ValueError:
+                pass
+    preview = render_message(subject, body, preview_recipient)
+    category_names = []
+    stored_category_names = snapshot.get("category_names", [])
+    if not isinstance(stored_category_names, list):
+        stored_category_names = []
+    for value in stored_category_names:
+        try:
+            category_names.append(normalize_category_name(value))
+        except ValueError:
+            continue
+    return {
+        "id": record_id,
+        "status": str(row.get("status") or "draft"),
+        "category_names": category_names,
+        "selected_count": safe_count("selected_count"),
+        "unique_count": safe_count("unique_count"),
+        "duplicate_count": safe_count("duplicate_count"),
+        "invalid_count": safe_count("invalid_count"),
+        "subject": subject,
+        "body": body,
+        "test_sent_at": safe_count("test_sent_at"),
+        "test_email": normalize_email(snapshot.get("test_email")),
+        "preview": {"subject": preview["subject"], "html": preview["html"]},
+    }
+
