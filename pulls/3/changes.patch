+async def _email_admin_confirm_campaign(env, campaign_id):
+    record_id = _email_admin_campaign_id(campaign_id)
+    row = await d1_first(
+        env,
+        "SELECT id,status,data FROM email_campaigns WHERE id=?",
+        record_id,
+    )
+    if not row:
+        raise ValueError("campaign not found")
+    if row.get("status") != "draft":
+        return False
+    snapshot = await decrypt_row(env, row.get("data"))
+    try:
+        test_sent_at = int(snapshot.get("test_sent_at") or 0)
+    except (AttributeError, TypeError, ValueError):
+        test_sent_at = 0
+    if not isinstance(snapshot, dict) or test_sent_at <= 0:
+        raise ValueError("send a successful test before confirming the campaign")
+    if not getattr(env, "EMAIL_QUEUE", None):
+        raise ValueError("Email queue is not configured.")
+    now = int(Date.now())
+    claimed = await d1_first(
+        env,
+        "UPDATE email_campaigns SET status='queued',queued_at=? "
+        "WHERE id=? AND status='draft' RETURNING id",
+        now,
+        record_id,
+    )
+    if not claimed:
+        existing = await d1_first(
+            env, "SELECT id FROM email_campaigns WHERE id=?", record_id
+        )
+        if not existing:
+            raise ValueError("campaign not found")
+        return False
+    await d1_run(
+        env,
+        "UPDATE email_deliveries SET status='queued',queued_at=?,updated_at=? "
+        "WHERE campaign_id=? AND status='draft'",
+        now,
+        now,
+        record_id,
+    )
+    await _email_admin_publish_deliveries(env, record_id)
+    return True
+
