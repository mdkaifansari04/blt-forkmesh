+        "sender": OUTREACH_SENDER_EMAIL,
+        "subject": final_subject,
+        "body": final_body,
+        "selected_count": selected_count,
+        "unique_count": len(recipients),
+        "duplicate_count": overlap_duplicates + normalized_duplicate_count,
+        "invalid_count": invalid_count,
+        "test_sent_at": 0,
+        "test_email": "",
+    }
+    delivery_sql = (
+        "INSERT INTO email_deliveries "
