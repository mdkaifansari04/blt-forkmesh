+        env,
+        "UPDATE email_recipients SET email_bi=?,data=?,updated_at=? WHERE id=?",
+        email_bi,
+        await encrypt_row(env, record),
+        int(Date.now()),
+        record_id,
+    )
+    return "Updated recipient."
