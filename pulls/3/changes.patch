+async def _email_admin_set_memberships(env, recipient_id, submitted_ids):
+    record_id = _email_admin_id(recipient_id, "recipient")
+    current = await d1_first(
+        env, "SELECT id FROM email_recipients WHERE id=?", record_id
+    )
+    if not current:
+        raise ValueError("recipient not found")
+    selected_ids = await _email_admin_validate_category_ids(env, submitted_ids)
+    await d1_run(
+        env,
+        "DELETE FROM email_category_memberships WHERE recipient_id=?",
