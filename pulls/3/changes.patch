+async def _email_admin_create_category(env, value):
+    name = normalize_category_name(value)
+    existing = await d1_first(
+        env,
+        "SELECT id FROM email_categories WHERE name=? COLLATE NOCASE",
+        name,
+    )
+    if existing:
+        raise ValueError("category already exists")
+    now = int(Date.now())
+    await d1_run(
+        env,
+        "INSERT INTO email_categories (name,created_at,updated_at) VALUES (?,?,?)",
+        name,
+        now,
+        now,
+    )
+    return "Created category '" + name + "'."
+
+
+async def _email_admin_rename_category(env, category_id, value):
+    record_id = _email_admin_id(category_id, "category")
+    name = normalize_category_name(value)
+    current = await d1_first(
+        env, "SELECT id FROM email_categories WHERE id=?", record_id
+    )
+    if not current:
+        raise ValueError("category not found")
+    existing = await d1_first(
+        env,
+        "SELECT id FROM email_categories WHERE name=? COLLATE NOCASE",
+        name,
+    )
+    if existing and int(existing["id"]) != record_id:
+        raise ValueError("category already exists")
+    await d1_run(
+        env,
+        "UPDATE email_categories SET name=?,updated_at=? WHERE id=?",
+        name,
+        int(Date.now()),
+        record_id,
+    )
+    return "Renamed category to '" + name + "'."
+
