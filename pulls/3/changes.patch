+async def _email_admin_load_model(
+    env, category_id=None, campaign_id=None
+):
+    categories_raw = await d1_all(
+        env,
+        "SELECT c.id,c.name,COUNT(m.recipient_id) AS count "
+        "FROM email_categories c "
+        "LEFT JOIN email_category_memberships m ON m.category_id=c.id "
+        "GROUP BY c.id,c.name ORDER BY lower(c.name),c.id",
+    )
+    categories = []
+    category_by_id = {}
+    for raw in categories_raw:
+        try:
+            item = {
+                "id": _email_admin_id(raw.get("id"), "category"),
+                "name": normalize_category_name(raw.get("name")),
+                "count": max(0, int(raw.get("count") or 0)),
+            }
+        except (TypeError, ValueError):
+            continue
+        categories.append(item)
+        category_by_id[item["id"]] = item
+
+    memberships_raw = await d1_all(
+        env,
+        "SELECT recipient_id,category_id "
+        "FROM email_category_memberships "
+        "ORDER BY recipient_id,category_id",
+    )
+    memberships = {}
+    for raw in memberships_raw:
+        try:
+            recipient_id = _email_admin_id(raw.get("recipient_id"), "recipient")
+            membership_id = _email_admin_id(raw.get("category_id"), "category")
+        except ValueError:
+            continue
+        if membership_id in category_by_id:
+            memberships.setdefault(recipient_id, set()).add(membership_id)
+
+    selected_category = None
+    if category_id is not None:
+        selected_category = _email_admin_id(category_id, "category")
+    recipients_raw = await d1_all(
+        env,
+        "SELECT id,data,updated_at FROM email_recipients "
+        "ORDER BY updated_at DESC,id DESC",
+    )
+    recipients = []
+    for raw in recipients_raw:
+        try:
+            recipient_id = _email_admin_id(raw.get("id"), "recipient")
+        except ValueError:
+            continue
+        recipient_categories = memberships.get(recipient_id, set())
+        if (
+            selected_category is not None
+            and selected_category not in recipient_categories
+        ):
+            continue
+        decrypted = await decrypt_row(env, raw.get("data"))
+        if not isinstance(decrypted, dict):
+            continue
+        try:
+            record = normalize_recipient_record(
+                decrypted.get("email"),
+                decrypted.get("name", ""),
+                decrypted.get("company", ""),
+            )
+            updated_at = max(0, int(raw.get("updated_at") or 0))
+        except (TypeError, ValueError):
+            continue
+        ordered_category_ids = [
+            category["id"]
+            for category in categories
+            if category["id"] in recipient_categories
+        ]
+        recipients.append(
+            {
+                "id": recipient_id,
+                "email": record["email"],
+                "name": record["name"],
+                "company": record["company"],
+                "categories": [
+                    category_by_id[item]["name"]
+                    for item in ordered_category_ids
+                ],
+                "category_ids": ordered_category_ids,
+                "updated_at": updated_at,
+            }
+        )
+
+    templates_raw = await d1_all(
+        env,
+        "SELECT id,name,data,is_seeded,updated_at FROM email_templates "
+        "ORDER BY lower(name),id",
+    )
+    templates = []
+    for raw in templates_raw:
+        decrypted = await decrypt_row(env, raw.get("data"))
+        if not isinstance(decrypted, dict):
+            continue
+        try:
+            template_id = _email_admin_id(raw.get("id"), "template")
+            name, subject, body = normalize_template_values(
+                raw.get("name"),
+                decrypted.get("subject"),
+                decrypted.get("body"),
+            )
+            is_seeded = int(raw.get("is_seeded") or 0) == 1
+            updated_at = max(0, int(raw.get("updated_at") or 0))
+        except (TypeError, ValueError):
+            continue
+        templates.append(
+            {
+                "id": template_id,
+                "name": name,
+                "subject": subject,
+                "body": body,
+                "is_seeded": is_seeded,
+                "updated_at": updated_at,
+            }
+        )
+    model = {
+        "recipients": recipients,
+        "categories": categories,
+        "templates": templates,
+        "campaigns": [],
+    }
+    if campaign_id is not None:
+        model["draft"] = await _email_admin_load_draft(env, campaign_id)
+    return model
+
