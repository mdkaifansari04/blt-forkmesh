+QString cleanFilesystemPath(QString path)
+{
+    path = path.trimmed();
+    path.replace('\\', '/');
+    return path.isEmpty() ? QString() : QDir::cleanPath(path);
+}
+
+bool pathIsGitRepository(const QString &path)
+{
+    const QString clean = cleanFilesystemPath(path);
+    if (clean.isEmpty())
+        return false;
+    const QFileInfo info(clean);
+    if (!info.exists() || !info.isDir())
+        return false;
+    const QDir dir(clean);
+    if (QFileInfo(dir.filePath(".git")).exists())
+        return true;
+    return QFileInfo(dir.filePath("HEAD")).isFile() &&
+           QFileInfo(dir.filePath("objects")).isDir();
+}
+
+bool mirrorPathIsUsableBareRepo(const QString &path)
+{
+    const QString clean = cleanFilesystemPath(path);
+    if (clean.isEmpty())
+        return false;
+    const QFileInfo info(clean);
+    if (!info.exists() || !info.isDir())
+        return false;
+    const QDir dir(clean);
+    return QFileInfo(dir.filePath("HEAD")).isFile() &&
+           QFileInfo(dir.filePath("objects")).isDir();
+}
+
+bool directoryIsEmpty(const QString &path)
+{
+    const QDir dir(cleanFilesystemPath(path));
+    return dir.exists() &&
+           dir.entryList(QDir::NoDotAndDotDot | QDir::AllEntries).isEmpty();
+}
+
+bool pathBlocksMirrorClone(const QString &path)
+{
+    const QFileInfo info(cleanFilesystemPath(path));
+    if (!info.exists())
+        return false;
+    if (mirrorPathIsUsableBareRepo(path))
+        return false;
+    return !directoryIsEmpty(path);
+}
+
+QString mirrorPathFor(const QString &root, const QString &owner, const QString &name)
+{
+    return QDir(cleanFilesystemPath(root))
+        .filePath(repoSegment(owner, QStringLiteral("owner")) + "-" +
+                  repoSegment(name, QStringLiteral("repository")) + ".git");
+}
+
+QString uniqueMirrorPathFor(const QString &root, const QString &owner,
+                            const QString &name, const QSet<QString> &used)
+{
+    const QString ownerSegment = repoSegment(owner, QStringLiteral("owner"));
+    const QString nameSegment = repoSegment(name, QStringLiteral("repository"));
+    const QString base = mirrorPathFor(root, ownerSegment, nameSegment);
+    for (int suffix = 1; suffix < 1000; ++suffix) {
+        const QString candidate =
+            suffix == 1
+                ? base
+                : QDir(cleanFilesystemPath(root))
+                      .filePath(ownerSegment + "-" + nameSegment + "-" +
+                                QString::number(suffix) + ".git");
+        if (used.contains(candidate) || pathBlocksMirrorClone(candidate))
+            continue;
+        return candidate;
+    }
+    return {};
+}
+
+QString repoKey(const RepositoryRecord &repo)
+{
+    return repoSegment(repo.owner, QStringLiteral("owner")) + "/" +
+           repoSegment(repo.name, QStringLiteral("repository"));
+}
+
+QString repositorySourceKey(const RepositoryRecord &repo)
+{
+    if (!repo.localPath.trimmed().isEmpty())
+        return "local:" + cleanFilesystemPath(repo.localPath);
+    QString clone = repo.cloneUrl.trimmed();
+    while (clone.size() > 1 && clone.endsWith('/'))
+        clone.chop(1);
+    return clone.isEmpty() ? QString() : "remote:" + clone;
+}
+
+QSet<QString> usedMirrorPaths(const QList<RepositoryRecord> &repos,
+                              int ignoreIndex = -1)
+{
+    QSet<QString> used;
+    for (int i = 0; i < repos.size(); ++i) {
+        if (i == ignoreIndex)
+            continue;
+        const QString path = cleanFilesystemPath(repos.at(i).mirrorPath);
+        if (!path.isEmpty())
+            used.insert(path);
+    }
+    return used;
+}
+
+qint64 repositoryFreshness(const RepositoryRecord &repo)
+{
+    return qMax(repo.lastSyncMs, repo.publishedAtMs);
+}
+
+bool preferRepositoryRecord(const RepositoryRecord &candidate,
+                            const RepositoryRecord &current)
+{
+    const bool candidateMirror = mirrorPathIsUsableBareRepo(candidate.mirrorPath);
+    const bool currentMirror = mirrorPathIsUsableBareRepo(current.mirrorPath);
+    if (candidateMirror != currentMirror)
+        return candidateMirror;
+    if (repositoryFreshness(candidate) != repositoryFreshness(current))
+        return repositoryFreshness(candidate) > repositoryFreshness(current);
+    const bool candidateLocal = pathIsGitRepository(candidate.localPath);
+    const bool currentLocal = pathIsGitRepository(current.localPath);
+    if (candidateLocal != currentLocal)
+        return candidateLocal;
+    return !candidate.cloneUrl.trimmed().isEmpty() &&
+           current.cloneUrl.trimmed().isEmpty();
+}
+
+void absorbRepositoryRecord(RepositoryRecord &target,
+                            const RepositoryRecord &other)
+{
+    if (target.description.trimmed().isEmpty() &&
+        !other.description.trimmed().isEmpty())
+        target.description = other.description;
+    if (target.bchAddress.trimmed().isEmpty() &&
+        !other.bchAddress.trimmed().isEmpty())
+        target.bchAddress = other.bchAddress;
+    if (!pathIsGitRepository(target.localPath) &&
+        pathIsGitRepository(other.localPath))
+        target.localPath = other.localPath;
+    if (target.cloneUrl.trimmed().isEmpty() &&
+        !other.cloneUrl.trimmed().isEmpty())
+        target.cloneUrl = other.cloneUrl;
+    if (!mirrorPathIsUsableBareRepo(target.mirrorPath) &&
+        mirrorPathIsUsableBareRepo(other.mirrorPath))
+        target.mirrorPath = other.mirrorPath;
+    else if (target.mirrorPath.trimmed().isEmpty() &&
+             !other.mirrorPath.trimmed().isEmpty())
+        target.mirrorPath = other.mirrorPath;
+    target.publishToNetwork = target.publishToNetwork || other.publishToNetwork;
+    target.actionsEnabled = target.actionsEnabled || other.actionsEnabled;
+    target.hostedSinceMs = qMax(target.hostedSinceMs, other.hostedSinceMs);
+    target.lastSyncMs = qMax(target.lastSyncMs, other.lastSyncMs);
+    target.publishedAtMs = qMax(target.publishedAtMs, other.publishedAtMs);
+}
+
+RepositoryRecord mergedRepositoryRecord(const RepositoryRecord &a,
+                                        const RepositoryRecord &b)
+{
+    RepositoryRecord merged = preferRepositoryRecord(b, a) ? b : a;
+    absorbRepositoryRecord(merged, preferRepositoryRecord(b, a) ? a : b);
+    return merged;
+}
