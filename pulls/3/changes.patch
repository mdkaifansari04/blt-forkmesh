+    selected_count = max(0, int((selected_row or {}).get("n", 0) or 0))
+    recipient_rows = await d1_all(
+        env,
+        "SELECT DISTINCT r.id,r.email_bi,r.data FROM email_recipients r "
+        "JOIN email_category_memberships m ON m.recipient_id=r.id "
+        "WHERE m.category_id IN ("
+        + placeholders
+        + ") ORDER BY r.id",
+        *selected,
+    )
+    if not recipient_rows:
+        raise ValueError("selected categories have no recipients")
+
+    recipients = []
+    seen_emails = set()
+    seen_blind_indexes = set()
+    invalid_count = 0
+    normalized_duplicate_count = 0
+    for row in recipient_rows:
+        email_bi = str(row.get("email_bi") or "").strip()
+        if not email_bi:
+            invalid_count += 1
+            continue
+        decrypted = await decrypt_row(env, row.get("data"))
+        if not isinstance(decrypted, dict):
+            invalid_count += 1
+            continue
+        try:
+            recipient = normalize_recipient_record(
+                decrypted.get("email"),
+                decrypted.get("name", ""),
+                decrypted.get("company", ""),
+            )
