+             .toBool())
+        return;
+    // Respect an explicitly parked node — the desktop's "Start mirror
+    // services" button is the deliberate un-park. Headless nodes are forced
+    // online in setHeadlessMode, so this never strands an unattended mirror.
+    if (m_nodeOffline)
