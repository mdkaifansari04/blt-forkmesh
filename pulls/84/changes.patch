+def test_gateway_counters_load_rows_written_before_the_served_stamps(
+    tmp_path: Path,
+):
+    path = tmp_path / gateway.SERVICE_COUNTERS_FILE
+    path.write_text(
+        json.dumps({
+            "schemaVersion": 1,
+            "type": gateway.SERVICE_COUNTERS_TYPE,
