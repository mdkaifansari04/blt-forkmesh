+class VerticalIconButton : public QPushButton
+{
+public:
+    enum Form { Action, Tab };
+    explicit VerticalIconButton(const QString &text, Form form,
+                                QWidget *parent = nullptr)
+        : QPushButton(text, parent), m_form(form)
