+QJsonArray dayRows(const QMap<QString, DayCounts> &days)
+{
+    QJsonArray rows;
+    for (auto it = days.constBegin(); it != days.constEnd(); ++it) {
+        QString date;
+        QString actor;
+        splitDayActorKey(it.key(), &date, &actor);
+        rows.append(QJsonArray{date, actor, it->commits, it->issues, it->pulls,
+                               it->reviews});
+    }
+    return rows;
+}
