+void MainWindow::scheduleAgentsTabReload(int sessionId)
+{
+    if (sessionId > 0)
+        m_queuedAgentsSessionId = sessionId;
+    if (m_agentsTabReloadQueued)
+        return;
+
+    m_agentsTabReloadQueued = true;
+    // issue #289: reloadAgents() shells git reads for Diff cells, blocking the GUI
+    // thread for a beat. Running it inline after setCurrentIndex(3) delays the
+    // tab repaint, so the Agents page appears only after the git work. A
+    // zero-delay timer can still be serviced before the paint event, so wait one
+    // frame: the tab paints first (with prior rows), then the heavier reload runs.
+    // Load pulls first so PR status is current.
+    constexpr int kAgentsTabRefreshDelayMs = 16;
+    QTimer::singleShot(kAgentsTabRefreshDelayMs, this, [this] {
+        const int sessionIdToShow = m_queuedAgentsSessionId;
+        m_queuedAgentsSessionId = -1;
+        reloadPulls();
+        reloadAgents();
+        if (sessionIdToShow > 0)
+            showAgentSession(sessionIdToShow);
+        m_agentsTabReloadQueued = false;
+    });
 }
 
