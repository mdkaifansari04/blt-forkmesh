+async def _email_admin_validate_recipient_ids(env, submitted_ids):
+    if submitted_ids is None:
+        values = []
+    elif isinstance(submitted_ids, str):
+        values = [submitted_ids]
+    else:
+        try:
+            values = list(submitted_ids)
+        except TypeError as error:
+            raise ValueError("unknown recipient") from error
+    if len(values) > 50:
+        raise ValueError("select no more than 50 individual recipients")
+
+    selected = []
+    for value in values:
+        try:
+            selected.append(_email_admin_id(value, "recipient"))
+        except ValueError as error:
+            raise ValueError("unknown recipient") from error
+    if len(set(selected)) != len(selected):
+        raise ValueError("duplicate recipient selection")
+    if not selected:
+        return []
+
+    payload = json.dumps(selected, separators=(",", ":"))
+    live_rows = await d1_all(
+        env,
+        "SELECT id FROM email_recipients "
+        "WHERE id IN (SELECT CAST(value AS INTEGER) FROM json_each(?))",
+        payload,
+    )
+    live = set()
+    for row in live_rows:
+        try:
+            live.add(_email_admin_id(row.get("id"), "recipient"))
+        except (AttributeError, ValueError):
+            continue
+    if live != set(selected):
+        raise ValueError("unknown recipient")
+    return selected
+
