+            return [
+                {
+                    "id": 10,
+                    "email_bi": "bi:person",
+                    "data": {"email": "person@example.com"},
+                }
+            ]
+        raise AssertionError(sql)
+
+    async def d1_first(_env, sql, *_args):
+        if "FROM email_templates" in sql:
+            return {
