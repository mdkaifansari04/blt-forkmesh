-+PullReviewSnapshot buildPullReviewSnapshot(const PullRequest &pr)
-+{
-+    PullReviewSnapshot snapshot;
-+    snapshot.reviewSummary = pr.reviewSummary();
-+
-+    QHash<QString, int> indexById;
