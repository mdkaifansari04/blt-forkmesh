+    def test_duplicate_slug_and_conflicting_manifest_reject_without_mutation(
+        self,
+    ) -> None:
+        catalog_before = self.records["catalogRepositories"]
+        duplicate = self.scenarios["reject-duplicate-owner-slug"]
+        candidate = duplicate["input"]["catalogEntry"]
+        self.assertTrue(
+            any(
+                (item["ownerAccount"], item["slug"])
+                == (candidate["ownerAccount"], candidate["slug"])
+                and item["repoId"] != candidate["repoId"]
+                for item in catalog_before
+            )
+        )
+        self.assertEqual((duplicate["expectedOutcome"], duplicate["code"]), ("rejected", "CATALOG_SLUG_CONFLICT"))
+        self.assertFalse(duplicate["resultingState"]["mutationApplied"])
+        self.assertEqual(
+            duplicate["resultingState"]["catalogRepositoryCount"],
+            len(catalog_before),
+        )
+        self.assertEqual(
+            duplicate["resultingState"]["catalogRepoIds"],
+            [item["repoId"] for item in catalog_before],
+        )
+        clones_before = self.records["cloneLocations"]
+        conflict = self.scenarios["reject-clone-location-rebinding"]
+        existing = next(
+            item for item in clones_before if item["id"] == conflict["input"]["cloneLocationId"]
+        )
+        self.assertEqual(existing["replicaId"], conflict["input"]["replicaId"])
+        self.assertNotEqual(existing["repoId"], conflict["input"]["presentedManifest"]["repoId"])
+        self.assertEqual((conflict["expectedOutcome"], conflict["code"]), ("rejected", "REPLICA_BINDING_CONFLICT"))
+        self.assertFalse(conflict["resultingState"]["mutationApplied"])
+        self.assertEqual(conflict["resultingState"]["retainedBinding"], existing)
