+)
+DRAFT_2020_12 = "https://json-schema.org/draft/2020-12/schema"
+MAX_TIMESTAMP = 253_402_300_799_999
+ACCOUNT_PATTERN = r"^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
+ACCOUNT_RE = re.compile(ACCOUNT_PATTERN)
+CAPABILITY_RE = re.compile(r"[a-z][a-z0-9]*(?:[._-][a-z0-9]+){1,5}")
+SIMPLE_ID_RE = re.compile(r"[a-z][a-z0-9-]{0,63}")
+REF_RE = re.compile(
+    r"refs/heads/(?![/.])(?!.*//)(?!.*/\.)(?!.*\./)(?!.*\.\.)"
+    r"(?!.*\.lock(?:/|$))(?!.*[/.]$)[A-Za-z0-9._/-]{1,244}"
+)
+SHA_RE = re.compile(r"(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})")
+UUID_RE = re.compile(
+    r"[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-"
+    r"[89ab][0-9a-f]{3}-[0-9a-f]{12}"
+)
