-            .contains(QStringLiteral("mcp")))
-        resp += "Sec-WebSocket-Protocol: mcp\r\n";
-    resp += "\r\n";
-    c.sock->write(resp);
-
-    c.buf.remove(0, end + 4); // keep any frame bytes that arrived with the request
-    c.upgraded = true;
-    emit clientConnected();
-    emit log(QStringLiteral("[ide] CLI connected"));
-    return true;
-}
