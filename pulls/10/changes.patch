+def is_account(value: Any) -> bool:
+    return isinstance(value, str) and ACCOUNT_RE.fullmatch(value) is not None
+
+
+def is_capability_id(value: Any) -> bool:
+    return (
+        isinstance(value, str)
+        and len(value) <= 64
+        and CAPABILITY_RE.fullmatch(value) is not None
+    )
+
+
+def account_values(value: Any, path: str = "$") -> Iterator[tuple[str, Any]]:
+    if isinstance(value, dict):
+        for key, child in value.items():
+            child_path = f"{path}.{key}"
+            if key in ACCOUNT_FIELDS:
+                yield child_path, child
+            else:
+                yield from account_values(child, child_path)
+    elif isinstance(value, list):
+        for index, child in enumerate(value):
+            yield from account_values(child, f"{path}[{index}]")
+
+
+def is_timestamp(value: Any) -> bool:
+    return type(value) is int and 0 <= value <= MAX_TIMESTAMP
+
+
+def is_canonical_base64url(
+    value: Any, prefix: str, byte_length: int
+) -> bool:
+    if not isinstance(value, str) or not value.startswith(prefix):
+        return False
+    encoded = value[len(prefix) :]
+    if "=" in encoded:
+        return False
+    try:
+        decoded = base64.b64decode(
+            encoded + "=" * ((4 - len(encoded) % 4) % 4),
+            altchars=b"-_",
+            validate=True,
+        )
+    except (binascii.Error, ValueError):
+        return False
+    canonical = base64.urlsafe_b64encode(decoded).rstrip(b"=").decode("ascii")
+    return len(decoded) == byte_length and encoded == canonical
+
+
+def canonical_payload(envelope: dict[str, Any]) -> str:
+    if set(envelope) != {*REF_UNSIGNED_FIELDS, "signature"}:
+        raise AssertionError("canonical envelope fields drifted")
+    if any(type(envelope[field]) is not int for field in ("version", "createdAt", "expiresAt")):
+        raise AssertionError("canonical integer fields must be JSON integers")
+    unsigned = {field: envelope[field] for field in REF_UNSIGNED_FIELDS}
+    return json.dumps(
+        unsigned,
+        allow_nan=False,
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+
+
+def constraints_match(
+    node: dict[str, Any], capability: dict[str, Any], context: dict[str, Any]
+) -> bool:
+    constraints = capability.get("constraints", {})
+    if not isinstance(constraints, dict):
+        return False
+    if "platforms" in constraints and (
+        node["deviceKind"] not in constraints["platforms"]
+        or node["deviceKind"] not in context.get("allowedPlatforms", [])
+    ):
+        return False
+    if "runtimes" in constraints and context.get("runtime") not in constraints["runtimes"]:
+        return False
+    if "availability" in constraints:
+        rank = {"offline": 0, "active-only": 1, "background": 2, "always": 3}
+        advertised = rank.get(constraints["availability"])
+        requested = rank.get(context.get("availability"))
+        if advertised is None or requested is None or advertised < requested:
+            return False
+    if "maxRepositoryBytes" in constraints:
+        size = context.get("repositoryBytes")
+        if type(size) is not int or size > constraints["maxRepositoryBytes"]:
+            return False
+    if "networkPolicy" in constraints:
+        accepted = {
+            "any": {"offline", "online", "unmetered"},
+            "online": {"online", "unmetered"},
+            "unmetered": {"unmetered"},
+        }
+        if context.get("networkPolicy") not in accepted.get(
+            constraints["networkPolicy"], set()
+        ):
+            return False
+    if "chargingPolicy" in constraints:
+        charging = context.get("charging")
+        if type(charging) is not bool:
+            return False
+        if constraints["chargingPolicy"] == "required" and not charging:
+            return False
+    if "supportedToolIds" in constraints:
+        requested = context.get("requestedToolIds")
+        if not isinstance(requested, list) or not set(requested) <= set(
+            constraints["supportedToolIds"]
+        ):
+            return False
+    return True
+
+
+def eligible_node_ids(
+    request: dict[str, Any],
+    nodes: list[dict[str, Any]],
+    trusted: set[str],
+    grants: list[dict[str, Any]],
+    roles: list[dict[str, Any]],
+) -> list[str]:
+    if not is_account(request.get("actorAccount")):
+        return []
+    matching_roles = [
+        role
+        for role in roles
+        if is_account(role.get("actorAccount"))
+        and (role["repoId"], role["actorAccount"])
+        == (request["repoId"], request["actorAccount"])
+    ]
+    if len(matching_roles) != 1 or matching_roles[0]["repoRole"] != request["repoRole"]:
+        return []
+
+    required = set(request["requiredCapabilities"])
+    eligible = []
+    for node in nodes:
+        if (
+            node["nodeId"] not in trusted
+            or node["state"] != "enabled"
+            or not is_account(node.get("account"))
+            or node["account"] != request["actorAccount"]
+        ):
+            continue
+        advertised = {item["id"]: item for item in node["capabilities"] if item["enabled"]}
+        if not required <= set(advertised):
+            continue
+        if not all(
+            constraints_match(node, advertised[capability_id], request["context"])
+            for capability_id in required
+        ):
+            continue
+        granted = {
+            capability_id
+            for grant in grants
+            if is_account(grant.get("actorAccount"))
+            and grant["repoId"] == request["repoId"]
+            and grant["nodeId"] == node["nodeId"]
+            and grant["actorAccount"] == request["actorAccount"]
+            and grant["repoRole"] == request["repoRole"]
+            and grant["enabled"]
+            and grant["expiresAt"] > request["context"]["requestedAt"]
+            for capability_id in grant["capabilityIds"]
+        }
+        if required <= granted:
+            eligible.append(node["nodeId"])
+    return eligible
+
+
+class NodeContractsTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls) -> None:
+        expected = {*SCHEMA_FILES, "fixtures.json"}
+        present = {path.name for path in CONTRACT_DIR.glob("*.json")}
+        if expected - present:
+            raise AssertionError(
+                "missing node contract files: " + ", ".join(sorted(expected - present))
+            )
+        cls.schemas = {
+            name: json.loads((CONTRACT_DIR / name).read_text(encoding="utf-8"))
+            for name in SCHEMA_FILES
+        }
+        cls.fixtures = json.loads(
+            (CONTRACT_DIR / "fixtures.json").read_text(encoding="utf-8")
+        )
+        cls.records = cls.fixtures["records"]
+        cls.scenarios = {
+            scenario["id"]: scenario for scenario in cls.fixtures["scenarios"]
+        }
+
+    def assert_fields(
+        self, value: Any, expected: set[str] | frozenset[str], path: str
+    ) -> None:
+        self.assertIsInstance(value, dict, path)
+        self.assertEqual(set(value), set(expected), f"{path} fields")
+
+    def assert_schema_record(
+        self, value: Any, schema_name: str, path: str
+    ) -> None:
+        schema = self.schemas[schema_name]
+        self.assertIsInstance(value, dict, path)
+        self.assertFalse(set(schema["required"]) - set(value), f"{path} required")
+        self.assertFalse(set(value) - set(schema["properties"]), f"{path} unknown")
+
+    def assert_id(
+        self, value: Any, prefix: str, byte_length: int, path: str
+    ) -> None:
+        self.assertTrue(
+            is_canonical_base64url(value, prefix, byte_length), f"{path}: {value!r}"
+        )
+
+    def assert_timestamp(self, value: Any, path: str, nullable: bool = False) -> None:
+        self.assertTrue(nullable and value is None or is_timestamp(value), path)
+
+    def assert_head(self, value: Any, path: str) -> None:
+        if value is None:
+            return
+        self.assert_fields(value, {"ref", "sha"}, path)
+        self.assertIsNotNone(REF_RE.fullmatch(value["ref"]), path)
+        self.assertIsNotNone(SHA_RE.fullmatch(value["sha"]), path)
+
+    def assert_ref_envelope(self, envelope: Any, path: str) -> None:
+        self.assert_schema_record(envelope, "ref-update.schema.json", path)
+        self.assertEqual(envelope["version"], 1, path)
+        self.assert_id(envelope["repoId"], "fmrepo_", 16, f"{path}.repoId")
+        self.assert_id(envelope["nodeId"], "fmnode_", 16, f"{path}.nodeId")
+        self.assert_id(envelope["signature"], "", 64, f"{path}.signature")
+        self.assertIsNotNone(REF_RE.fullmatch(envelope["ref"]), f"{path}.ref")
+        self.assertIsNotNone(SHA_RE.fullmatch(envelope["newSha"]), f"{path}.newSha")
+        old_sha = envelope["expectedOldSha"]
+        self.assertTrue(old_sha is None or SHA_RE.fullmatch(old_sha), path)
+        if old_sha is not None:
+            self.assertEqual(len(old_sha), len(envelope["newSha"]), path)
+        self.assertTrue(is_account(envelope["actorAccount"]), path)
+        self.assert_timestamp(envelope["createdAt"], f"{path}.createdAt")
+        self.assert_timestamp(envelope["expiresAt"], f"{path}.expiresAt")
+        self.assertGreater(envelope["expiresAt"], envelope["createdAt"], path)
+        self.assertIsNotNone(UUID_RE.fullmatch(envelope["idempotencyKey"]), path)
+
