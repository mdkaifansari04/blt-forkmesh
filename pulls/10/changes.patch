+#!/usr/bin/env python3
+"""Validate the authoritative mobile/Qt parity catalog and render its matrix.
+
+The catalog intentionally uses JSON syntax in a .yaml file so this checker can
+remain dependency-free. Matrix output is normalized by domain and capability ID
+regardless of catalog order.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import defaultdict
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+import stat
+import sys
+import tempfile
+from typing import Iterable
+import unicodedata
+
+
+MODES = {
+    "direct",
+    "signed-inbox",
+    "node-execution",
+    "mobile-equivalent",
+    "not-applicable",
+}
+FORBIDDEN_BROAD_CAPABILITY_IDS = {
+    "action.variable.manage",
+    "agent.delete",
+    "agent.external.manage",
+    "agent.provider.configure",
+    "agent.usage.read",
+    "chat.channel.manage",
+    "chat.message",
+    "chat.private_channel.manage",
+    "code.file.write",
+    "cove.document.write",
+    "cove.password.manage",
+    "desktop.agent_credentials.transfer",
+    "desktop.app.update",
+    "desktop.firewall.manage",
+    "desktop.firewall.read",
+    "desktop.identity.backup_restore",
+    "desktop.voice_engine.manage",
+    "issue.ai.analyze",
+    "issue.metadata.update",
+    "node.link",
+    "notification.read",
+    "pull.file.manage",
+    "release.prune",
+    "relay.manage",
+    "relay.read",
+    "repo.collaborator.manage",
+    "repo.delete",
+    "repo.remote.manage",
+    "scm.message.generate",
+    "shortcut.write",
+}
+RISKS = {"read", "write", "destructive", "secret"}
+ROLES = {
+    "account",
+    "admin",
+    "author",
+    "collaborator",
+    "guest",
+    "invitee",
+    "maintainer",
+    "owner",
+}
+STATUSES = {"implemented", "partial", "planned", "not-applicable"}
+ROOT_FIELDS = {"version", "capabilities"}
+REQUIRED_CAPABILITY_FIELDS = {
+    "id",
+    "domain",
+    "title",
+    "mode",
+    "risk",
+    "roles",
+    "status",
+    "qt",
+    "mobile",
+    "tests",
+    "prerequisites",
+}
+CAPABILITY_FIELDS = REQUIRED_CAPABILITY_FIELDS | {"rationale"}
+LIST_FIELDS = ("roles", "qt", "mobile", "tests", "prerequisites")
+REFERENCE_FIELDS = ("qt", "mobile", "tests")
+REFERENCE_PREFIXES = {
+    "qt": ("qt_client/",),
+    "mobile": ("flutter_app/lib/",),
+    "tests": (
+        "cloudflare_worker/tests/",
+        "flutter_app/test/",
+        "qt_client/tests/",
+        "tools/",
+    ),
+}
+CAPABILITY_ID = re.compile(
+    r"^[a-z][a-z0-9_-]*(?:\.[a-z][a-z0-9_-]*)+$"
+)
+PREREQUISITE_ID = re.compile(r"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$")
+MAX_JSON_INTEGER_DIGITS = 4_300
+
+MATRIX_PREAMBLE = """# Mobile/Qt Feature Parity Matrix
+
+> Generated from `docs/mobile/remote-command-catalog.yaml`; edit the catalog, not this table.
+
+Execution modes: `direct`, `signed-inbox`, `node-execution`, `mobile-equivalent`, `not-applicable`.
+
+`node-execution` runs locally on the requesting registered node when it advertises the enabled atomic capability.
+If local execution is unavailable, the user may optionally route a typed request to another trusted eligible node.
+It does not require Qt or pairing.
+"""
+
+
+class _DuplicateJsonKey(ValueError):
+    pass
+
+
+def _parse_json_integer(value: str) -> int:
+    digits = value.removeprefix("-")
+    if len(digits) > MAX_JSON_INTEGER_DIGITS:
+        raise ValueError(
+            f"integer exceeds {MAX_JSON_INTEGER_DIGITS}-digit limit"
+        )
+    return int(value)
+
+
+def _object_without_duplicate_keys(
+    pairs: list[tuple[str, object]],
+) -> dict[str, object]:
+    result: dict[str, object] = {}
+    for key, value in pairs:
+        if key in result:
+            raise _DuplicateJsonKey(key)
+        result[key] = value
+    return result
+
+
+def _plural(count: int, singular: str) -> str:
+    if count == 1:
+        return singular
+    if singular.endswith("y"):
+        return f"{singular[:-1]}ies"
+    return f"{singular}s"
+
+
+def _emit(message: str, *, error: bool = False) -> None:
+    stream = sys.stderr if error else sys.stdout
+    encoding = stream.encoding or "utf-8"
+    safe_message = message.encode(encoding, errors="backslashreplace").decode(encoding)
+    stream.write(f"{safe_message}\n")
+
+
+def _find_repo_root(catalog_path: Path) -> Path:
+    for candidate in (catalog_path.parent, *catalog_path.parents):
+        if (candidate / ".git").exists():
+            return candidate
+    return catalog_path.parent
+
+
+def _load_catalog(path: Path) -> tuple[object | None, list[str]]:
+    try:
+        text = path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return None, [f"catalog not found: {path}"]
+    except (OSError, UnicodeError) as error:
+        return None, [f"cannot read catalog {path}: {error}"]
+
+    try:
+        return json.loads(
+            text,
+            object_pairs_hook=_object_without_duplicate_keys,
+            parse_int=_parse_json_integer,
+        ), []
+    except _DuplicateJsonKey as error:
+        return None, [f"duplicate JSON key in {path}: {error}"]
+    except json.JSONDecodeError as error:
+        return None, [
+            "invalid JSON-compatible YAML in "
+            f"{path} at line {error.lineno}, column {error.colno}: {error.msg}"
+        ]
+    except ValueError as error:
+        return None, [f"invalid JSON-compatible YAML in {path}: {error}"]
+    except RecursionError:
+        return None, [f"invalid JSON-compatible YAML in {path}: JSON is too deeply nested"]
+
+
+def _nonempty_string(
+    value: object,
+    location: str,
+    errors: list[str],
+) -> str | None:
+    if not isinstance(value, str):
+        errors.append(f"{location} must be a string")
+        return None
+    try:
+        value.encode("utf-8")
+    except UnicodeEncodeError:
+        errors.append(f"{location} must contain valid Unicode scalar values")
+        return None
+    if any(
+        unicodedata.category(character) in {"Cc", "Zl", "Zp"}
+        and character not in "\r\n"
+        for character in value
+    ):
+        errors.append(
+            f"{location} must not contain control or separator characters"
+        )
+        return None
+    if not value.strip():
+        errors.append(f"{location} must not be empty or whitespace-only")
+        return None
+    return value
+
+
+def _string_list(
+    capability: dict[str, object],
+    field: str,
+    location: str,
+    errors: list[str],
+) -> list[str] | None:
+    value = capability.get(field)
+    if not isinstance(value, list):
+        errors.append(f"{location}.{field} must be a list")
+        return None
+
+    strings: list[str] = []
+    for index, item in enumerate(value):
+        string = _nonempty_string(
+            item,
+            f"{location}.{field}[{index}]",
+            errors,
+        )
+        if string is not None:
+            strings.append(string)
+    return strings
+
+
+def _reference_path(
+    reference: str,
+    field: str,
+    location: str,
+    repo_root: Path,
+    errors: list[str],
+) -> tuple[Path | None, bool]:
+    path_text = reference
+    if reference.startswith("planned:"):
+        path_text = reference.removeprefix("planned:")
+        if not path_text.strip():
+            errors.append(f"{location}.{field} has an empty planned: reference")
+            return None, True
+        planned = True
+    else:
+        planned = False
+
+    path = PurePosixPath(path_text)
+    if path.is_absolute() or ".." in path.parts or "\\" in path_text:
+        errors.append(
+            f"{location}.{field} reference must be a repository-relative path: "
+            f"{reference}"
+        )
+        return None, planned
+
+    normalized = path.as_posix()
+    if not normalized.startswith(REFERENCE_PREFIXES[field]):
+        expected = " or ".join(REFERENCE_PREFIXES[field])
+        errors.append(
+            f"{location}.{field} reference must be under {expected}: {reference}"
+        )
+        return None, planned
+
+    return repo_root.joinpath(*path.parts), planned
+
+
+def _validate_capability(
+    capability: object,
+    index: int,
+    repo_root: Path,
+    seen_ids: set[str],
+) -> list[str]:
+    errors: list[str] = []
+    base_location = f"capabilities[{index}]"
+    if not isinstance(capability, dict):
+        return [f"{base_location} must be an object"]
+
+    fields = set(capability)
+    for field in sorted(REQUIRED_CAPABILITY_FIELDS - fields):
+        errors.append(f"{base_location} is missing required field {field!r}")
+    for field in sorted(fields - CAPABILITY_FIELDS):
+        errors.append(f"{base_location} has unknown field {field!r}")
+
+    identifier = _nonempty_string(
+        capability.get("id"),
+        f"{base_location}.id",
+        errors,
+    )
+    location = f"capability {identifier!r}" if identifier else base_location
+    if identifier is not None:
+        if not CAPABILITY_ID.fullmatch(identifier):
+            errors.append(
+                f"{location}.id must be a stable dotted lowercase identifier"
+            )
+        if identifier in seen_ids:
+            errors.append(f"{location}.id is a duplicate capability ID")
+        if identifier in FORBIDDEN_BROAD_CAPABILITY_IDS:
+            errors.append(f"{location}.id is a forbidden broad capability ID")
+        seen_ids.add(identifier)
+
+    _nonempty_string(capability.get("domain"), f"{location}.domain", errors)
+    _nonempty_string(capability.get("title"), f"{location}.title", errors)
+    mode = _nonempty_string(capability.get("mode"), f"{location}.mode", errors)
+    risk = _nonempty_string(capability.get("risk"), f"{location}.risk", errors)
+    status = _nonempty_string(
+        capability.get("status"),
+        f"{location}.status",
+        errors,
+    )
+
+    if mode is not None and mode not in MODES:
+        errors.append(f"{location}.mode has unsupported value {mode!r}")
+    if risk is not None and risk not in RISKS:
+        errors.append(f"{location}.risk has unsupported value {risk!r}")
+    if status is not None and status not in STATUSES:
+        errors.append(f"{location}.status has unsupported value {status!r}")
+
+    lists = {
+        field: _string_list(capability, field, location, errors)
+        for field in LIST_FIELDS
+        if field in capability
+    }
+    roles = lists.get("roles")
+    tests = lists.get("tests")
+    if roles is not None:
+        for index, role in enumerate(roles):
+            if role not in ROLES:
+                errors.append(
+                    f"{location}.roles[{index}] has unsupported role {role!r}; "
+                    f"expected one of {', '.join(sorted(ROLES))}"
+                )
+        if "guest" in roles and risk in {"secret", "destructive"}:
+            errors.append(
+                f"{location}.roles must not grant {risk!r} risk to role 'guest'"
+            )
+    if mode != "not-applicable":
+        if roles == []:
+            errors.append(f"{location}.roles must contain at least one role")
+        if tests == []:
+            errors.append(f"{location}.tests must contain at least one test reference")
+
+    rationale: str | None = None
+    if "rationale" in capability:
+        rationale = _nonempty_string(
+            capability["rationale"],
+            f"{location}.rationale",
+            errors,
+        )
+    if mode == "not-applicable":
+        if status != "not-applicable":
+            errors.append(
+                f"{location}.status must be 'not-applicable' when mode is 'not-applicable'"
+            )
+        if rationale is None:
+            errors.append(
+                f"{location}.rationale is required for mode 'not-applicable'"
+            )
+    if status == "not-applicable" and mode != "not-applicable":
+        errors.append(
+            f"{location}.mode must be 'not-applicable' when status is 'not-applicable'"
+        )
+
+    resolved_repo_root = repo_root.resolve()
+    allowed_reference_roots = {
+        field: tuple(
+            resolved_repo_root.joinpath(*PurePosixPath(prefix).parts)
+            for prefix in REFERENCE_PREFIXES[field]
+        )
+        for field in REFERENCE_FIELDS
+    }
+    current_references: dict[str, int] = defaultdict(int)
+    for field in REFERENCE_FIELDS:
+        for reference in lists.get(field) or []:
+            path, planned = _reference_path(
+                reference,
+                field,
+                location,
+                repo_root,
+                errors,
+            )
+            if path is None:
+                continue
+            if planned:
+                continue
+            if not path.exists():
+                errors.append(
+                    f"{location}.{field} reference does not exist: {reference}"
+                )
+                continue
+            try:
+                resolved_path = path.resolve(strict=True)
+            except (OSError, RuntimeError) as error:
+                errors.append(
+                    f"{location}.{field} reference cannot be resolved: "
+                    f"{reference}: {error}"
+                )
+                continue
+            if not resolved_path.is_relative_to(resolved_repo_root):
+                errors.append(
+                    f"{location}.{field} reference resolves outside repository: "
+                    f"{reference}"
+                )
+            elif not any(
+                resolved_path.is_relative_to(allowed_root)
+                for allowed_root in allowed_reference_roots[field]
+            ):
+                errors.append(
+                    f"{location}.{field} reference resolves outside allowed source "
+                    f"tree: {reference}"
+                )
+            elif not resolved_path.is_file():
+                errors.append(
+                    f"{location}.{field} reference must be a regular file: "
+                    f"{reference}"
+                )
+            else:
+                current_references[field] += 1
+
+    if status in {"implemented", "partial"}:
+        if current_references["mobile"] == 0:
+            errors.append(
+                f"{location} requires a current mobile implementation reference "
+                f"when status is {status!r}"
+            )
+        if current_references["tests"] == 0:
+            errors.append(
+                f"{location} requires a current test reference when status is {status!r}"
+            )
+
+    for index, prerequisite in enumerate(lists.get("prerequisites") or []):
+        if not PREREQUISITE_ID.fullmatch(prerequisite):
+            errors.append(
+                f"{location}.prerequisites[{index}] must be a stable prerequisite ID"
+            )
+    if mode == "node-execution":
+        prerequisites = set(lists.get("prerequisites") or [])
+        for required_prerequisite in ("node-registration", "capability-grant"):
+            if required_prerequisite not in prerequisites:
+                errors.append(
+                    f"{location}.prerequisites must include "
+                    f"{required_prerequisite!r} for mode 'node-execution'"
+                )
+    return errors
+
+
+def validate_catalog(catalog: object, repo_root: Path) -> list[str]:
+    """Return every schema, semantic, and evidence error in a catalog."""
+    if not isinstance(catalog, dict):
+        return ["catalog root must be an object"]
+
+    errors: list[str] = []
+    fields = set(catalog)
+    for field in sorted({"version", "capabilities"} - fields):
+        errors.append(f"catalog root is missing required field {field!r}")
+    for field in sorted(fields - ROOT_FIELDS):
+        errors.append(f"catalog root has unknown field {field!r}")
+
+    version = catalog.get("version")
+    if type(version) is not int or version != 1:
+        errors.append("catalog version must equal integer 1")
+    capabilities = catalog.get("capabilities")
+    if not isinstance(capabilities, list):
+        errors.append("catalog capabilities must be a list")
+        return errors
+
+    seen_ids: set[str] = set()
+    for index, capability in enumerate(capabilities):
+        errors.extend(
+            _validate_capability(capability, index, repo_root, seen_ids)
+        )
+    return errors
+
+
+def _escape_markdown_cell(value: str) -> str:
+    return (
+        value.replace("\\", "\\\\")
+        .replace("|", "\\|")
+        .replace("\r\n", "<br>")
+        .replace("\r", "<br>")
+        .replace("\n", "<br>")
+    )
+
+
+def render_matrix(capabilities: Iterable[dict[str, object]]) -> str:
+    """Render deterministic Markdown grouped by domain and sorted by ID."""
+    grouped: dict[str, list[dict[str, object]]] = defaultdict(list)
+    for capability in capabilities:
+        grouped[str(capability["domain"])].append(capability)
+
+    lines = [MATRIX_PREAMBLE.rstrip(), ""]
+    for domain in sorted(grouped):
+        lines.extend(
+            (
+                f"## {_escape_markdown_cell(domain)}",
+                "",
+                "| Capability | User outcome | Mode | Risk | Status |",
+                "|---|---|---|---|---|",
+            )
+        )
+        for capability in sorted(grouped[domain], key=lambda item: str(item["id"])):
+            identifier = _escape_markdown_cell(str(capability["id"]))
+            title = _escape_markdown_cell(str(capability["title"]))
+            mode = _escape_markdown_cell(str(capability["mode"]))
+            risk = _escape_markdown_cell(str(capability["risk"]))
+            status = _escape_markdown_cell(str(capability["status"]))
+            lines.append(
+                f"| `{identifier}` | {title} | {mode} | {risk} | {status} |"
+            )
+        lines.append("")
+    return "\n".join(lines)
+
+
+def _write_atomic(path: Path, content: str) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
+    descriptor, temporary_name = tempfile.mkstemp(
+        prefix=f".{path.name}.",
+        suffix=".tmp",
+        dir=path.parent,
+        text=True,
+    )
+    temporary_path = Path(temporary_name)
+    try:
+        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
+            handle.write(content)
+            handle.flush()
+            os.fsync(handle.fileno())
+        temporary_path.chmod(mode)
+        os.replace(temporary_path, path)
+    except BaseException:
+        temporary_path.unlink(missing_ok=True)
+        raise
+
+
+def _parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="Validate a JSON-compatible mobile/Qt parity catalog.",
+    )
+    parser.add_argument("catalog", type=Path)
+    matrix = parser.add_mutually_exclusive_group()
+    matrix.add_argument("--write-matrix", type=Path, metavar="PATH")
+    matrix.add_argument("--check-matrix", type=Path, metavar="PATH")
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = _parser().parse_args(argv)
+    try:
+        catalog_path = args.catalog.expanduser().resolve()
+    except (OSError, RuntimeError) as error:
+        _emit(
+            f"error: cannot resolve catalog path {args.catalog}: {error}",
+            error=True,
+        )
+        return 1
+
+    raw_matrix_path = args.write_matrix or args.check_matrix
+    matrix_path: Path | None = None
+    if raw_matrix_path is not None:
+        try:
+            matrix_path = raw_matrix_path.expanduser().resolve()
+        except (OSError, RuntimeError) as error:
+            _emit(
+                f"error: cannot resolve matrix path {raw_matrix_path}: {error}",
+                error=True,
+            )
+            return 1
+        same_file = matrix_path == catalog_path
+        if not same_file and matrix_path.exists():
+            try:
+                same_file = matrix_path.samefile(catalog_path)
+            except OSError:
+                same_file = False
+        if same_file:
+            _emit(
+                "error: catalog and matrix paths must differ",
+                error=True,
+            )
+            return 1
+
+    catalog, errors = _load_catalog(catalog_path)
+    if not errors:
+        errors = validate_catalog(catalog, _find_repo_root(catalog_path))
+    if errors:
+        for error in errors:
+            _emit(f"error: {error}", error=True)
+        return 1
+
+    assert isinstance(catalog, dict)
+    capabilities = catalog["capabilities"]
+    assert isinstance(capabilities, list)
+    typed_capabilities = [
+        capability
+        for capability in capabilities
+        if isinstance(capability, dict)
+    ]
+    matrix = render_matrix(typed_capabilities)
+
+    if args.write_matrix is not None:
+        assert matrix_path is not None
+        try:
+            _write_atomic(matrix_path, matrix)
+        except OSError as error:
+            _emit(f"error: cannot write matrix {matrix_path}: {error}", error=True)
+            return 1
+        _emit(f"Wrote matrix: {matrix_path}")
+
+    if args.check_matrix is not None:
+        assert matrix_path is not None
+        try:
+            current_matrix = matrix_path.read_bytes().decode("utf-8")
+        except (OSError, UnicodeError) as error:
+            _emit(f"error: cannot read matrix {matrix_path}: {error}", error=True)
+            return 1
+        if current_matrix != matrix:
+            _emit(
+                f"error: matrix drift detected in {matrix_path}; "
+                "regenerate it with --write-matrix",
+                error=True,
+            )
+            return 1
+        _emit(f"Matrix is up to date: {matrix_path}")
+
+    domain_count = len({str(item["domain"]) for item in typed_capabilities})
+    capability_count = len(typed_capabilities)
+    _emit(
+        f"Validated {capability_count} {_plural(capability_count, 'capability')} "
+        f"across {domain_count} {_plural(domain_count, 'domain')}."
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
