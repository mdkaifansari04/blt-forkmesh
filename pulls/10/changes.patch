+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "ref-update.schema.json",
+  "title": "ForkMesh signed canonical ref update",
+  "description": "Canonical signing MUST follow RFC 8785, the JSON Canonicalization Scheme (JCS). Sign the UTF-8 bytes of compact JSON for exactly the unsigned fields version, repoId, ref, expectedOldSha, newSha, actorAccount, nodeId, createdAt, expiresAt, and idempotencyKey, with keys sorted lexically, the signature field excluded, separators ',' and ':', and no trailing newline. Protocol inputs version, createdAt, and expiresAt MUST arrive as JSON integer values without fractional or exponent spellings. expiresAt MUST be greater than createdAt; consumers MUST enforce this mandatory semantic invariant because JSON Schema cannot compare sibling numbers.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "version",
+    "repoId",
+    "ref",
+    "expectedOldSha",
+    "newSha",
+    "actorAccount",
+    "nodeId",
+    "createdAt",
+    "expiresAt",
+    "idempotencyKey",
+    "signature"
+  ],
+  "oneOf": [
+    {
+      "properties": {
+        "expectedOldSha": {
+          "type": "null",
+          "const": null
+        }
+      }
+    },
+    {
+      "properties": {
+        "expectedOldSha": {
+          "type": "string",
+          "minLength": 40,
+          "maxLength": 40,
+          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
+        },
+        "newSha": {
+          "type": "string",
+          "minLength": 40,
+          "maxLength": 40,
+          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
+        }
+      }
+    },
+    {
+      "properties": {
+        "expectedOldSha": {
+          "type": "string",
+          "minLength": 64,
+          "maxLength": 64,
+          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
+        },
+        "newSha": {
+          "type": "string",
+          "minLength": 64,
+          "maxLength": 64,
+          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
+        }
+      }
+    }
+  ],
+  "properties": {
+    "version": {
+      "type": "integer",
+      "const": 1,
+      "minimum": 1,
+      "maximum": 1
+    },
+    "repoId": {
+      "type": "string",
+      "minLength": 29,
+      "maxLength": 29,
+      "pattern": "^fmrepo_[A-Za-z0-9_-]{21}[AQgw]$"
+    },
+    "ref": {
+      "type": "string",
+      "minLength": 12,
+      "maxLength": 255,
+      "pattern": "^refs/heads/(?!\\.)(?!.*//)(?!.*/\\.)(?!.*\\./)(?!.*\\.\\.)(?!.*\\.lock(?:/|$))(?!.*[/.]$)[A-Za-z0-9._/-]{1,244}$"
+    },
+    "expectedOldSha": {
+      "type": [
+        "string",
+        "null"
+      ],
+      "minLength": 40,
+      "maxLength": 64,
+      "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
+    },
+    "newSha": {
+      "type": "string",
+      "minLength": 40,
+      "maxLength": 64,
+      "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
+    },
+    "actorAccount": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 63,
+      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
+    },
+    "nodeId": {
+      "type": "string",
+      "minLength": 29,
+      "maxLength": 29,
+      "pattern": "^fmnode_[A-Za-z0-9_-]{21}[AQgw]$"
+    },
+    "createdAt": {
+      "type": "integer",
+      "minimum": 0,
+      "maximum": 253402300799999
+    },
+    "expiresAt": {
+      "type": "integer",
+      "minimum": 0,
+      "maximum": 253402300799999
+    },
+    "idempotencyKey": {
+      "type": "string",
+      "minLength": 36,
+      "maxLength": 36,
+      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
+    },
+    "signature": {
+      "type": "string",
+      "minLength": 86,
+      "maxLength": 86,
+      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
+    }
+  }
+}
