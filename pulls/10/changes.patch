diff --git a/contracts/node/v1/node.schema.json b/contracts/node/v1/node.schema.json
new file mode 100644
index 00000000..8676e873
--- /dev/null
+++ b/contracts/node/v1/node.schema.json
@@ -0,0 +1,87 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "node.schema.json",
+  "title": "ForkMesh registered node",
+  "description": "One independently keyed installation. Authorization depends on account policy, enabled node registration, and enabled atomic capabilities, never on deviceKind alone. Consumers MUST enforce that capability advertisements are unique by id.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "version",
+    "nodeId",
+    "account",
+    "deviceKind",
+    "publicKey",
+    "label",
+    "state",
+    "capabilities",
+    "lastSeenAt"
+  ],
+  "properties": {
+    "version": {
+      "type": "integer",
+      "const": 1,
+      "minimum": 1,
+      "maximum": 1
+    },
+    "nodeId": {
+      "type": "string",
+      "minLength": 29,
+      "maxLength": 29,
+      "pattern": "^fmnode_[A-Za-z0-9_-]{21}[AQgw]$"
+    },
+    "account": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 63,
+      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
+    },
+    "deviceKind": {
+      "type": "string",
+      "minLength": 3,
+      "maxLength": 8,
+      "enum": [
+        "desktop",
+        "android",
+        "ios",
+        "server",
+        "headless"
+      ]
+    },
+    "publicKey": {
+      "type": "string",
+      "minLength": 43,
+      "maxLength": 43,
+      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
+    },
+    "label": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 80,
+      "pattern": "^(?!\\s)(?!.*\\s$)[^\\x00-\\x1F\\x7F]{1,80}$"
+    },
+    "state": {
+      "type": "string",
+      "minLength": 7,
+      "maxLength": 7,
+      "enum": [
+        "enabled",
+        "revoked"
+      ]
+    },
+    "capabilities": {
+      "description": "Enabled and disabled advertisements may coexist. Consumers MUST reject this node unless capability advertisements are unique by id.",
+      "type": "array",
+      "minItems": 1,
+      "maxItems": 128,
+      "uniqueItems": true,
+      "items": {
+        "$ref": "capability.schema.json"
+      }
+    },
+    "lastSeenAt": {
+      "type": "integer",
+      "minimum": 0,
+      "maximum": 253402300799999
+    }
+  }
+}
