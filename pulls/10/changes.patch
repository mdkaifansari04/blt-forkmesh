-
-void ClaudeStreamSession::stop()
-{
-    if (!m_proc)
-        return;
-    m_proc->disconnect(this);
-    if (m_proc->state() != QProcess::NotRunning) {
-        m_proc->closeWriteChannel(); // signal end-of-input first
-        m_proc->terminate();
-        if (!m_proc->waitForFinished(1500))
-            m_proc->kill();
-    }
-    m_proc->deleteLater();
