-            this, [this](int code, QProcess::ExitStatus) { emit finished(code); });
-
-    // Run through a login shell so the user's PATH (e.g. ~/.local/bin) resolves
-    // `claude`, exactly like the embedded terminal does. `exec` hands stdin/out
-    // straight to claude.
