+        repo_id = projection["input"]["repoId"]
+        entries = [
+            item for item in self.records["catalogRepositories"] if item["repoId"] == repo_id
+        ]
+        replicas = [item for item in self.records["replicas"] if item["repoId"] == repo_id]
+        node_by_id = {item["nodeId"]: item for item in self.records["nodes"]}
+        self.assertEqual((projection["expectedOutcome"], projection["code"]), ("accepted", "REPOSITORY_PROJECTED"))
+        self.assertEqual(len(entries), 1)
+        self.assertEqual(len(replicas), 3)
+        self.assertEqual(
+            len(projection["input"]["replicaIds"]),
+            len(set(projection["input"]["replicaIds"])),
+        )
+        self.assertEqual(set(projection["input"]["replicaIds"]), {item["replicaId"] for item in replicas})
+        self.assertTrue(all(item["repoId"] == repo_id for item in replicas))
+        self.assertEqual(
+            {node_by_id[item["nodeId"]]["deviceKind"] for item in replicas},
+            {"desktop", "android", "ios"},
+        )
+        self.assertEqual(projection["resultingState"]["catalogRepositoryCount"], 1)
+        self.assertEqual(projection["resultingState"]["catalogRepoIds"], [repo_id])
+        self.assertEqual(
+            set(projection["resultingState"]["replicaIds"]),
+            {item["replicaId"] for item in replicas},
+        )
+        self.assertEqual(
+            len(projection["resultingState"]["replicaIds"]), len(replicas)
+        )
+
+        second = self.scenarios["create-same-name-independent-repository"]
+        same_name = [
+            item
+            for item in self.records["catalogRepositories"]
+            if item["ownerAccount"] == second["input"]["ownerAccount"]
+            and item["displayName"] == second["input"]["displayName"]
+        ]
+        self.assertEqual((second["expectedOutcome"], second["code"]), ("accepted", "REPOSITORY_CREATED"))
+        self.assertIn(second["input"], self.records["catalogRepositories"])
+        self.assertEqual(len(same_name), 2)
+        self.assertEqual({item["slug"] for item in same_name}, {"forkmesh", "forkmesh-mobile"})
+        self.assertEqual(len({item["repoId"] for item in same_name}), 2)
+        self.assertEqual(second["resultingState"]["catalogRepositoryCount"], 2)
+        self.assertEqual(
+            len(second["resultingState"]["catalogRepoIds"]),
