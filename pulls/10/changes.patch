+    def test_canonical_payload_and_compare_and_swap(self) -> None:
+        signing = self.fixtures["metadata"]["canonicalSigning"]
+        self.assertEqual(tuple(signing["unsignedFields"]), REF_UNSIGNED_FIELDS)
+        self.assertEqual(signing["canonicalization"], "RFC 8785 (JCS)")
+        self.assertEqual(signing["integerFields"], ["createdAt", "expiresAt", "version"])
+        self.assertEqual((signing["encoding"], signing["signatureField"], signing["trailingNewline"]), ("UTF-8", "signature", False))
+
+        updates = {item["id"]: item for item in self.records["refUpdates"]}
+        for update_id, update in updates.items():
+            envelope = update["envelope"]
+            self.assert_ref_envelope(envelope, update_id)
+            self.assertEqual(update["canonicalPayload"], canonical_payload(envelope))
+            self.assertNotIn("signature", json.loads(update["canonicalPayload"]))
+            self.assertFalse(update["canonicalPayload"].endswith("\n"))
+
+        accepted = self.scenarios["accept-main-ref-cas"]
+        stale = self.scenarios["reject-stale-main-ref-cas"]
+        accepted_envelope = updates[accepted["input"]["refUpdateId"]]["envelope"]
+        stale_envelope = updates[stale["input"]["refUpdateId"]]["envelope"]
+        starting_heads = {
+            replica["canonicalHead"]["sha"]
+            for replica in self.records["replicas"]
+            if replica["repoId"] == accepted_envelope["repoId"]
+            and replica["canonicalHead"] is not None
+            and replica["canonicalHead"]["ref"] == accepted_envelope["ref"]
+        }
+        self.assertEqual(starting_heads, {accepted_envelope["expectedOldSha"]})
+        self.assertEqual((accepted["expectedOutcome"], accepted["code"], accepted["resultingState"]["mutationApplied"]), ("accepted", "REF_UPDATE_ACCEPTED", True))
+        self.assertEqual(accepted_envelope["ref"], accepted["resultingState"]["ref"])
+        self.assertEqual(accepted_envelope["newSha"], accepted["resultingState"]["currentSha"])
+        self.assertEqual((stale["expectedOutcome"], stale["code"], stale["resultingState"]["mutationApplied"]), ("rejected", "REF_UPDATE_STALE", False))
+        self.assertEqual(stale_envelope["ref"], stale["resultingState"]["ref"])
+        self.assertEqual(
+            stale_envelope["expectedOldSha"], accepted_envelope["expectedOldSha"]
+        )
+        self.assertNotEqual(stale_envelope["expectedOldSha"], stale["resultingState"]["currentSha"])
+        self.assertEqual(accepted["resultingState"]["currentSha"], stale["resultingState"]["currentSha"])
+
+        for label, mutate in (
+            ("bad ref", lambda item: item.update(ref="refs/heads//main")),
+            ("zero SHA", lambda item: item.update(newSha="0" * 40)),
+            ("stale expiry", lambda item: item.update(expiresAt=item["createdAt"])),
+            ("fractional timestamp", lambda item: item.update(createdAt=1.5)),
+        ):
+            with self.subTest(malformed_envelope=label):
+                malformed = deepcopy(accepted_envelope)
+                mutate(malformed)
+                with self.assertRaises(AssertionError):
+                    self.assert_ref_envelope(malformed, label)
+
+    def test_atomic_capability_routing_and_required_split_ids(self) -> None:
+        scenario = self.scenarios["route-capability-constrained-work"]
+        records = self.records
+        trusted = set(scenario["input"]["trustedNodeIds"])
+        expected = scenario["resultingState"]
+        self.assertEqual(
+            (scenario["expectedOutcome"], scenario["code"]),
+            ("accepted", "CAPABILITY_ROUTE_READY"),
+        )
+        self.assertEqual(
+            expected["routingBasis"],
+            "registered-trusted-enabled-advertisement-grant-and-constraints",
+        )
+        self.assertEqual(
+            expected["selectionPolicy"],
+            "requesting-node-first-then-eligible-trusted-node",
+        )
+        routes = {}
+        selections = {}
+        rejections = {}
+        for request in scenario["input"]["requests"]:
+            candidates = eligible_node_ids(
+                request,
+                records["nodes"],
+                trusted,
+                records["capabilityGrants"],
+                records["repositoryRoles"],
+            )
+            routes[request["id"]] = candidates
+            if not candidates:
+                rejections[request["id"]] = "NO_ELIGIBLE_NODE"
+            elif request["requestingNodeId"] in candidates:
+                selections[request["id"]] = request["requestingNodeId"]
+            else:
+                selections[request["id"]] = candidates[0]
+        self.assertEqual(routes, expected["eligibleNodeIdsByRequest"])
+        self.assertEqual(selections, expected["selectedNodeIdByRequest"])
+        self.assertEqual(rejections, expected["rejectionCodeByRequest"])
+
+        base_request = deepcopy(scenario["input"]["requests"][0])
+        base_candidates = routes[base_request["id"]]
+        for label, account, accepted in (
+            ("63 characters", "a" * 63, True),
+            ("leading digit", "1account", False),
+            ("uppercase", "Account", False),
+            ("non-ASCII", "éclair", False),
+            ("trailing hyphen", "account-", False),
+            ("64 characters", "a" * 64, False),
+        ):
+            with self.subTest(account_scenario=label):
+                request = deepcopy(base_request)
+                nodes = deepcopy(records["nodes"])
+                grants = deepcopy(records["capabilityGrants"])
+                roles = deepcopy(records["repositoryRoles"])
+                request["actorAccount"] = account
+                for node in nodes:
+                    node["account"] = account
+                for item in [*grants, *roles]:
+                    item["actorAccount"] = account
+                self.assertTrue(
+                    all(node["account"] == request["actorAccount"] for node in nodes)
+                )
+                self.assertTrue(
+                    all(item["actorAccount"] == request["actorAccount"] for item in [*grants, *roles])
+                )
+                candidates = eligible_node_ids(request, nodes, trusted, grants, roles)
+                self.assertEqual(candidates, base_candidates if accepted else [])
+
+        catalog = json.loads(CATALOG_PATH.read_text(encoding="utf-8"))
+        catalog_ids = {item["id"] for item in catalog["capabilities"]}
+        advertised_ids = {
+            capability["id"]
+            for node in records["nodes"]
+            for capability in node["capabilities"]
+        }
+        self.assertFalse(REQUIRED_SPLIT_IDS - catalog_ids)
+        self.assertFalse(FORBIDDEN_BROAD_IDS & catalog_ids)
+        self.assertFalse(advertised_ids - catalog_ids)
