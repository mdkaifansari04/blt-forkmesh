+void MainWindow::scheduleAgentsTabRefresh()
+{
+    // issue #289: reloadPulls() + reloadAgents() can spend noticeable time in
+    // git-backed table work. A 0ms timer can still run before Qt gets a useful
+    // paint of the newly-selected Agents page, so give the event loop one normal
+    // frame before refreshing the data behind the already-visible table.
+    m_agentsTabRefreshPending = true;
+    const int generation = ++m_agentsTabRefreshGeneration;
+    QTimer::singleShot(16, this, [this, generation] {
+        if (generation != m_agentsTabRefreshGeneration)
+            return;
+        m_agentsTabRefreshPending = false;
+        if (!m_repoDetailStack || m_repoDetailStack->currentIndex() != 3)
+            return;
+        // Load pulls first so the agents list can show each session's PR status
+        // (open/merged/closed) from m_currentPulls.
+        reloadPulls();
+        reloadAgents();
+    });
+}
