-+
-+QStringList trackedPathsFromMirror(const QString &mirrorPath)
-+{
-+    const QString out = runGit(mirrorPath, {QStringLiteral("ls-tree"),
-+                                            QStringLiteral("-r"),
-+                                            QStringLiteral("--name-only"),
-+                                            QStringLiteral("HEAD")});
-+    return out.split(QLatin1Char('\n'), Qt::SkipEmptyParts);
