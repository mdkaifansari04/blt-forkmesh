+        setIssueInlineNotice(error.isEmpty() ? "Could not update progress." : error,
+                             true);
+        return;
+    }
+    setIssueInlineNotice(QStringLiteral("Progress set to %1%.").arg(progress));
+    reloadIssues();
+}
