-+    const bool useMirror = !useLocal && !input.mirrorPath.trimmed().isEmpty() &&
-+                           QDir(input.mirrorPath).exists();
-+    const QStringList paths = useLocal ? trackedPathsFromLocal(input.localPath)
-+                                       : trackedPathsFromMirror(input.mirrorPath);
