++QString runGit(const QString &dir, const QStringList &args)
++{
++    if (dir.trimmed().isEmpty())
++        return QString();
++    QProcess git;
++    git.start(QStringLiteral("git"), QStringList{QStringLiteral("-C"), dir} + args);
