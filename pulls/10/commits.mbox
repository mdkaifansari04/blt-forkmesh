+            const QJsonObject contentObj = contentValue.toObject();
+            const QString text = contentObj.value(QStringLiteral("text")).toString();
+            if (!text.trimmed().isEmpty())
+                parts << text.trimmed();
+        }
+    }
+    return parts.join(QStringLiteral("\n\n")).trimmed();
