+    if (m_issueAiTypingRow) {
+        if (m_issueThreadLayout)
+            m_issueThreadLayout->removeWidget(m_issueAiTypingRow);
+        m_issueAiTypingRow->deleteLater();
+        m_issueAiTypingRow = nullptr;
+    }
+}
