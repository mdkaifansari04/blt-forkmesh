+        m_presenceTimer = new QTimer(this);
+        m_presenceTimer->setInterval(kPresenceIntervalMs);
+        connect(m_presenceTimer, &QTimer::timeout, this, [this] {
+            sendPresence();
+            updateRosterAndStatus(); // re-evaluate staleness even with no traffic
