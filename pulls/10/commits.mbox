-+    QString ref = runGit(input.localPath, {QStringLiteral("rev-parse"),
-+                                           QStringLiteral("--short"), QStringLiteral("HEAD")});
-+    if (!ref.isEmpty())
-+        return ref;
-+    ref = runGit(input.mirrorPath, {QStringLiteral("rev-parse"),
-+                                    QStringLiteral("--short"), QStringLiteral("HEAD")});
