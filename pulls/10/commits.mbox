+    // Restore the last open repository first (matches the old scheduling order).
+    if (m_pendingRestoreRepoIndex >= 0 &&
+        m_pendingRestoreRepoIndex < m_repositories.size()) {
+        const int index = m_pendingRestoreRepoIndex;
