+bool ForkMeshIdentity::replaceWithFreshKey()
+{
+    if (!isValid() && !load())
+        return false;
+
+    const QString dir = defaultKeyDir();
+    const QString keyPath = dir + QStringLiteral("/ed25519.pem");
+    const QString archiveDir = dir + QStringLiteral("/previous");
+    if (!QDir().mkpath(archiveDir)) {
+        m_error = "Could not create the previous-identity directory.";
+        return false;
+    }
+    const QString archivedPath =
+        archiveDir + QLatin1Char('/') + m_publicKey + QStringLiteral(".pem");
+    if (!QFile::exists(archivedPath) && !QFile::copy(keyPath, archivedPath)) {
+        m_error = "Could not preserve the current identity key before replacing it.";
+        return false;
+    }
+    QFile::setPermissions(archivedPath, QFile::ReadOwner | QFile::WriteOwner);
+
+    const QString nextPath = dir + QStringLiteral("/ed25519.next.pem");
+    QFile::remove(nextPath);
+    if (!generate(nextPath))
+        return false;
+
+    // The archived copy makes the replacement recoverable even on filesystems
+    // that cannot atomically overwrite an existing file.
+    if (!QFile::remove(keyPath) || !QFile::rename(nextPath, keyPath)) {
+        QFile::remove(nextPath);
+        if (!QFile::exists(keyPath))
+            QFile::copy(archivedPath, keyPath);
+        m_error = "Could not install the new desktop identity key.";
+        return false;
+    }
+
+    m_keyDir = dir;
+    return readKey(keyPath) && refreshPublicKey();
+}
+
+bool ForkMeshIdentity::restorePreviousKey(const QString &publicKeyB64url)
+{
+    static const QRegularExpression publicKeyPattern(
+        QStringLiteral("^[A-Za-z0-9_-]{43}$"));
+    if (!publicKeyPattern.match(publicKeyB64url).hasMatch())
+        return false;
+    if (!isValid() && !load())
+        return false;
+    if (publicKeyB64url == m_publicKey)
+        return true;
+
+    const QString dir = defaultKeyDir();
+    const QString keyPath = dir + QStringLiteral("/ed25519.pem");
+    const QString archiveDir = dir + QStringLiteral("/previous");
+    const QString requestedPath =
+        archiveDir + QLatin1Char('/') + publicKeyB64url + QStringLiteral(".pem");
+    if (!QFile::exists(requestedPath) || !QDir().mkpath(archiveDir))
+        return false;
+
+    const QString currentArchive =
+        archiveDir + QLatin1Char('/') + m_publicKey + QStringLiteral(".pem");
+    if (!QFile::exists(currentArchive) &&
+        !QFile::copy(keyPath, currentArchive)) {
+        m_error = "Could not preserve the current identity key before switching it.";
+        return false;
+    }
+    QFile::setPermissions(currentArchive, QFile::ReadOwner | QFile::WriteOwner);
+
+    const QString nextPath = dir + QStringLiteral("/ed25519.next.pem");
+    QFile::remove(nextPath);
+    if (!QFile::copy(requestedPath, nextPath) || !QFile::remove(keyPath) ||
+        !QFile::rename(nextPath, keyPath)) {
+        QFile::remove(nextPath);
+        if (!QFile::exists(keyPath))
+            QFile::copy(currentArchive, keyPath);
+        m_error = "Could not restore this account's desktop identity key.";
+        return false;
+    }
+    QFile::setPermissions(keyPath, QFile::ReadOwner | QFile::WriteOwner);
+
+    m_keyDir = dir;
+    if (!readKey(keyPath) || !refreshPublicKey() ||
+        m_publicKey != publicKeyB64url) {
+        QFile::remove(keyPath);
+        QFile::copy(currentArchive, keyPath);
+        readKey(keyPath);
+        refreshPublicKey();
+        m_error = "The preserved desktop identity did not match this account.";
+        return false;
+    }
+    return true;
+}
+
