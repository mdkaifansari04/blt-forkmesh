From 60ab7848ae79cdcf5479bc7d4690d9a07e278a5d Mon Sep 17 00:00:00 2001
From: dev-2f782c1c <dev-2f782c1c@users.noreply.forkmesh.com>
Date: Fri, 26 Jun 2026 20:02:43 -0400
Subject: [PATCH 1/2] Make an agent session always deletable

Deleting an agent session could fail in three ways: a runner that
wouldn't exit within stop()'s 1.5s window forced a "delete it again
once it exits" retry, and clearing the issue's agent assignment hard-
failed deletion for non-hosts or on any write error.

Now deletion always removes the local session: a runner that won't stop
promptly is abandoned (killed, signals dropped so a late finish can't
re-save the row, worktree cleaned, reset to idle for reuse), and the
issue-event clear is best-effort with a warning instead of a bail.

Also make removeWorktree tolerant of an already-removed worktree so the
combined "delete worktree, branch & agent" action still deletes the
branch after a runner has cleaned up its own worktree.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 qt_client/src/AgentRunner.cpp | 20 +++++++++++
 qt_client/src/AgentRunner.h   |  5 +++
 qt_client/src/MainWindow.cpp  | 63 ++++++++++++++++++++++-------------
 3 files changed, 64 insertions(+), 24 deletions(-)

diff --git a/qt_client/src/AgentRunner.cpp b/qt_client/src/AgentRunner.cpp
index fa4bf197..9d3cadfc 100644
--- a/qt_client/src/AgentRunner.cpp
+++ b/qt_client/src/AgentRunner.cpp
@@ -313,6 +313,26 @@ void AgentRunner::stop()
     complete(false, AgentStatus::Stopped, QStringLiteral("Stopped."));
 }
 
+void AgentRunner::abandon()
+{
+    // Forcefully forget the current session without finishing it: kill the
+    // process now (no wait), disconnect it so a late finish can't re-save the
+    // session the caller is about to delete, clean up the worktree, and reset to
+    // idle so this pooled runner can be reused.
+    if (m_noOutputTimer)
+        m_noOutputTimer->stop();
+    if (m_process) {
+        m_process->disconnect(this);
+        m_process->kill();
+        m_process->deleteLater();
+        m_process = nullptr;
+    }
+    cleanupWorktree();
+    m_stopping = false;
+    m_phase = Phase::Idle;
+    m_busy = false;
+}
+
 void AgentRunner::steer(const QString &prompt)
 {
     const QString trimmed = prompt.trimmed();
