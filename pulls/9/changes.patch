+void MainWindow::scheduleAgentsTabRefresh()
+{
+    if (!m_agentsTabRefreshTimer) {
+        m_agentsTabRefreshTimer = new QTimer(this);
+        m_agentsTabRefreshTimer->setSingleShot(true);
+        connect(m_agentsTabRefreshTimer, &QTimer::timeout, this, [this] {
+            // issue #289: reloadAgents() shells git reads for Diff cells. A short
+            // delay lets the tab click repaint before the refresh starts.
+            reloadPulls();
+            reloadAgents();
+        });
+    }
+    m_agentsTabRefreshTimer->start(16);
+}
