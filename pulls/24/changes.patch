+            selectedName = repoNameFromUrl(QString::fromUtf8(origin).trimmed());
+        const QString currentName =
+            repoSegment(currentRepo.name, QStringLiteral("repository"));
+        if (selectedName != currentName) {
+            QMessageBox::warning(
+                this, "New pull request",
