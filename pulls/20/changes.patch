+QStringList gitWritableRoots(const QString &cwd)
+{
+    if (cwd.trimmed().isEmpty())
+        return {};
+    QProcess git;
+    git.setWorkingDirectory(cwd);
+    git.start(QStringLiteral("git"),
+              {QStringLiteral("rev-parse"), QStringLiteral("--git-dir"),
+               QStringLiteral("--git-common-dir")});
+    if (!git.waitForFinished(5000) || git.exitCode() != 0)
+        return {};
+    QStringList roots;
+    const QDir cwdDir(cwd);
+    for (const QByteArray &line : git.readAllStandardOutput().split('\n')) {
+        QString root = QString::fromUtf8(line).trimmed();
+        if (root.isEmpty())
+            continue;
+        if (!QDir::isAbsolutePath(root))
+            root = cwdDir.absoluteFilePath(root);
+        root = QDir::cleanPath(root);
+        if (!roots.contains(root))
+            roots.append(root);
+    }
+    return roots;
+}
