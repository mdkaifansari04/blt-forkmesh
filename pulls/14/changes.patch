+                        ORDER BY CASE
+                           WHEN sources.active_generation_bi IS NOT NULL
+                            AND sources.verified_from IS NOT NULL
+                            AND sources.verified_from<=? THEN 0
+                           WHEN sources.active_generation_bi IS NOT NULL
