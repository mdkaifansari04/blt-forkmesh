+            message.ack()
+            return
+        outcome = await _email_admin_process_delivery(env, delivery_id)
+        if outcome == "retry":
+            message.retry(delaySeconds=60)
+        else:
+            message.ack()
+    except Exception as error:
+        try:
+            print("Email queue message failed: " + type(error).__name__)
+        except Exception:
+            pass
+        message.retry(delaySeconds=60)
