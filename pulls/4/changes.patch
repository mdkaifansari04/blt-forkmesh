+async def _email_admin_load_job(env, campaign_id):
+    record_id = _email_admin_campaign_id(campaign_id)
+    campaign = await d1_first(
+        env,
+        "SELECT id,status,created_at,data FROM email_campaigns WHERE id=?",
+        record_id,
+    )
+    if not campaign:
+        raise ValueError("campaign not found")
+    snapshot = await decrypt_row(env, campaign.get("data"))
+    if not isinstance(snapshot, dict):
+        raise ValueError("campaign content is unavailable")
+    _name, subject, _body = normalize_template_values(
+        "Campaign history", snapshot.get("subject"), snapshot.get("body")
+    )
+    count_rows = await d1_all(
+        env,
+        "SELECT status,COUNT(*) AS n FROM email_deliveries "
+        "WHERE campaign_id=? GROUP BY status",
+        record_id,
+    )
+    counts = {
+        "draft": 0,
+        "queued": 0,
+        "sending": 0,
+        "sent": 0,
+        "retrying": 0,
+        "failed": 0,
+    }
+    for row in count_rows:
+        status = str(row.get("status") or "")
+        if status not in counts:
+            continue
+        try:
+            counts[status] = max(0, int(row.get("n") or 0))
+        except (TypeError, ValueError):
+            continue
+    delivery_rows = await d1_all(
+        env,
+        "SELECT id,status,data,attempts,last_error,updated_at "
+        "FROM email_deliveries WHERE campaign_id=? "
+        "ORDER BY CASE WHEN status='failed' THEN 0 "
+        "WHEN status='retrying' THEN 1 WHEN status='sending' THEN 2 "
+        "WHEN status='queued' THEN 3 WHEN status='draft' THEN 4 ELSE 5 END,id "
+        "LIMIT 500",
+        record_id,
+    )
+    deliveries = []
+    allowed_statuses = frozenset(counts)
+    for row in delivery_rows:
+        decrypted = await decrypt_row(env, row.get("data"))
+        if not isinstance(decrypted, dict):
+            continue
+        try:
+            recipient = normalize_recipient_record(
+                decrypted.get("email"),
+                decrypted.get("name", ""),
+                decrypted.get("company", ""),
+            )
+            delivery_id = _email_admin_delivery_id(row.get("id"))
+            attempts = max(0, int(row.get("attempts") or 0))
+            updated_at = max(0, int(row.get("updated_at") or 0))
+        except (TypeError, ValueError):
+            continue
+        status = str(row.get("status") or "unknown")
+        if status not in allowed_statuses:
+            status = "unknown"
+        last_error = str(row.get("last_error") or "")[:80]
+        if last_error and not re.fullmatch(r"[a-z0-9_]+", last_error):
+            last_error = "email_delivery_failed"
+        deliveries.append(
+            {
+                "id": delivery_id,
+                "email": recipient["email"],
+                "status": status,
+                "attempts": attempts,
+                "last_error": last_error,
+                "updated_at": updated_at,
+            }
+        )
+    status_order = {
+        "failed": 0,
+        "retrying": 1,
+        "sending": 2,
+        "queued": 3,
+        "draft": 4,
+        "sent": 5,
+        "unknown": 6,
+    }
+    deliveries.sort(
+        key=lambda item: (status_order[item["status"]], item["email"], item["id"])
+    )
+    publication_error = str(snapshot.get("publication_error") or "")
+    if publication_error != "queue_publish_failed":
+        publication_error = ""
+    total = sum(counts.values())
+    return {
+        "id": record_id,
+        "subject": subject,
+        "status": str(campaign.get("status") or "unknown")[:40],
+        "created_at": max(0, int(campaign.get("created_at") or 0)),
+        "total": total,
+        **counts,
+        "publication_error": publication_error,
+        "deliveries": deliveries,
+        "truncated": total > 500,
+    }
