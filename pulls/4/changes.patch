+                "subject": subject,
+                "status": str(row.get("status") or "unknown")[:40],
+                "created_at": created_at,
+                "total": count("total"),
+                "draft": count("draft"),
+                "queued": count("queued"),
+                "sending": count("sending"),
+                "sent": count("sent"),
+                "retrying": count("retrying"),
+                "failed": count("failed"),
+                "publication_error": publication_error,
