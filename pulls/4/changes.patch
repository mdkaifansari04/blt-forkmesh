+                snapshot.get("subject"),
+                snapshot.get("body"),
+            )
+        except ValueError:
+            continue
+
+        def count(key):
+            try:
+                return max(0, int(row.get(key) or 0))
+            except (TypeError, ValueError):
+                return 0
+
+        publication_error = str(snapshot.get("publication_error") or "")
+        if publication_error != "queue_publish_failed":
+            publication_error = ""
