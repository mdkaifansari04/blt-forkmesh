+def _load_email_admin_history(extra_globals):
+    selected = [
+        node
+        for node in ENTRY_TREE.body
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        and node.name in EMAIL_HISTORY_FUNCTIONS
+    ]
+    found = {node.name for node in selected}
+    assert found == EMAIL_HISTORY_FUNCTIONS, (
+        "missing history functions: "
+        + ", ".join(sorted(EMAIL_HISTORY_FUNCTIONS - found))
+    )
+    module = ast.fix_missing_locations(ast.Module(body=selected, type_ignores=[]))
+    namespace = {
+        "re": __import__("re"),
+        "Date": _FakeDate,
+        "normalize_email": email_admin.normalize_email,
+        "normalize_recipient_record": email_admin.normalize_recipient_record,
+        "normalize_template_values": email_admin.normalize_template_values,
+    }
+    exec(compile(module, str(ENTRY), "exec"), namespace)
+    namespace.update(extra_globals)
+    return namespace
