+bool MainWindow::testShowRepoCommitsTab()
+{
+    if (!m_repoDetailStack || m_repoDetailStack->count() <= 1)
+        return false;
+    m_repoDetailStack->setCurrentIndex(1); // Commits
+    if (m_repoDetailTabs) {
+        if (QAbstractButton *b = m_repoDetailTabs->button(1))
+            b->setChecked(true);
+    }
+    loadCommits();
+    return true;
+}
+
+bool MainWindow::testCommitListRowHasRestoreAction() const
+{
+    if (!m_commitsTable || m_commitsTable->rowCount() == 0)
+        return false;
+    const QList<QWidget *> actionGroups =
+        m_commitsTable->findChildren<QWidget *>(QStringLiteral("commitRowActions"));
+    for (QWidget *actions : actionGroups) {
+        bool hasRestore = false;
+        bool hasDelete = false;
+        const QList<QPushButton *> buttons = actions->findChildren<QPushButton *>();
+        for (QPushButton *button : buttons) {
+            const QString action =
+                button->property("commitAction").toString();
+            hasRestore = hasRestore || action == QStringLiteral("restore");
+            hasDelete = hasDelete || action == QStringLiteral("delete");
+        }
+        if (hasRestore && hasDelete)
+            return true;
+    }
+    return false;
+}
