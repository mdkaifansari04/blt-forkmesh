+    assert "hashlib.pbkdf2_hmac" in ENV_EXAMPLE_TEXT
+    assert "100000" in ENV_EXAMPLE_TEXT
+    assert "founders@forkmesh.com" in ENV_EXAMPLE_TEXT
+    assert "OUTREACH_SENDER_NAME" in ENV_EXAMPLE_TEXT
+    assert "DATA_KEY" in DEPLOY_TEXT[
+        DEPLOY_TEXT.index("local required=") : DEPLOY_TEXT.index(
+            'echo "Pushing secrets', DEPLOY_TEXT.index("local required=")
+        )
+    ]
+
+
+def test_deploy_provisions_both_email_queues_before_worker_upload():
+    assert "ensure_email_queues()" in DEPLOY_TEXT
+    assert "pywrangler queues create" in DEPLOY_TEXT
+    assert "forkmesh-email-outreach" in DEPLOY_TEXT
+    assert "forkmesh-email-outreach-dlq" in DEPLOY_TEXT
+    assert "Queues: Edit" in DEPLOY_TEXT
+
+    deploy_case = DEPLOY_TEXT[DEPLOY_TEXT.index("    deploy)") :]
+    queue_call = deploy_case.index("ensure_email_queues")
+    upload = deploy_case.index("pywrangler deploy")
+    assert queue_call < upload
+    queue_function = DEPLOY_TEXT[
+        DEPLOY_TEXT.index("ensure_email_queues()") : DEPLOY_TEXT.index(
+            "# A stamp identifying"
+        )
+    ]
+    assert "already" in queue_function
+
+
+def test_required_secret_placeholders_fail_instead_of_only_warning():
+    required_section = DEPLOY_TEXT[
+        DEPLOY_TEXT.index("push_secrets()") : DEPLOY_TEXT.index(
+            "publish_release_binary()"
+        )
+    ]
+
+    assert "placeholder_keys" in required_section
+    assert "required secret(s) still use placeholder values" in required_section
+    assert required_section.index(
+        "required secret(s) still use placeholder values"
+    ) < required_section.index("pywrangler secret put")
