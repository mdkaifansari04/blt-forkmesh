+            if (error)
+                *error = QStringLiteral("git commit failed: ") + err;
+            return false;
+        }
+    }
+
+    QByteArray refs;
+    if (!runGit(m_workTree, {"rev-list", "--all", "--max-count=1"}, &refs, &err,
