+async def repo_banner_handler(env, request, owner, repo):
+    """Serve the generated default fediverse header for a public repository."""
+    if method_name(request) not in ("GET", "HEAD"):
+        return json_response({"error": "method_not_allowed"}, status=405)
+    parts = urlparse(request.url)
+    cache_key = (_ap_origin(env, request) + parts.path
+                 + (("?" + parts.query) if parts.query else ""))
+    cached = await edge_cache_match_media(cache_key, "image/png")
+    if cached is not None:
+        return cached
+    await ensure_schema(env)
+    if await _repo_is_private(env, owner, repo):
+        return json_response({"error": "not_found"}, status=404)
+    repo_bi = await blind_index(env, owner + "/" + repo)
+    row = await d1_first(
+        env, "SELECT data FROM repositories WHERE key_bi=?", repo_bi)
+    if not row:
+        return json_response({"error": "not_found"}, status=404)
+    rec = (await decrypt_row(env, row.get("data"))) or {}
+
+    # Verified contribution snapshots carry exact language byte/file totals.
+    # Existing repos without a snapshot still get the full catalog infographic.
+    language_rows = await d1_all(
+        env,
+        """SELECT languages.language, languages.bytes, languages.files
+             FROM profile_contribution_projects AS projects
+             JOIN profile_contribution_languages AS languages
+               ON languages.source_repo_bi=projects.source_repo_bi
+              AND languages.generation_bi=projects.active_generation_bi
+            WHERE projects.source_repo_bi=? AND projects.is_public=1
+            ORDER BY languages.bytes DESC LIMIT 10""",
+        repo_bi)
+    languages = [{
+        "name": item.get("language") or "Other",
+        "bytes": item.get("bytes") or 0,
+        "files": item.get("files") or 0,
+        "color": contributions.language_color(item.get("language")),
+    } for item in (language_rows or [])]
+
+    stars_row = await d1_first(
+        env, "SELECT COUNT(*) AS n FROM repo_stars WHERE repo_bi=?", repo_bi)
+    followers = 0
+    if await _ap_enabled(env):
+        handle = ap.repo_handle(str(owner).lower(), str(repo).lower())
+        actor_bi = await _ap_actor_bi(env, AP_ACTOR_REPO, handle)
+        follower_row = await d1_first(
+            env, "SELECT COUNT(*) AS c FROM ap_followers WHERE actor_bi=?",
+            actor_bi)
+        followers = (follower_row or {}).get("c", 0) or 0
+    mirrors = 0
+    try:
+        now_ms = int(time.time() * 1000)
+        for entry in await _decrypted_public_catalog(env, now_ms):
+            if repo_mirror_same_group(rec, entry.get("data")):
+                mirrors += 1
+    except Exception:
+        mirrors = 0
+    info = {
+        "owner": owner,
+        "repo": repo,
+        "description": rec.get("description", ""),
+        "branch": rec.get("branch", ""),
+        "stars": (stars_row or {}).get("n", 0) or 0,
+        "followers": followers,
+        "mirrors": max(1, mirrors),
+        "issues": rec.get("issueCount", ""),
+        "pulls": rec.get("pullCount", ""),
+        "commits": rec.get("commitCount", ""),
+        "branches": rec.get("branchCount", ""),
+        "discussions": rec.get("discussionCount", ""),
+        "artifacts": rec.get("artifactCount", ""),
+        "sizeBytes": rec.get("sizeBytes", 0),
+        "updatedAt": rec.get("updatedAt", ""),
+        "activityWeeks": rec.get("activityWeeks", []),
+        "languages": languages,
+        "files": sum(int(item.get("files") or 0) for item in languages),
+    }
