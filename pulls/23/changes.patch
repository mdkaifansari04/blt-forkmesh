+#!/usr/bin/env python3
+"""Pillar 1 public/docs copy contracts."""
+
+from pathlib import Path
+
+PUBLIC = Path(__file__).resolve().parents[1] / "public"
+HOME = PUBLIC / "index.html"
+DOCS_PAGES = (
+    PUBLIC / "docs.html",
+    PUBLIC / "docs" / "index.html",
+)
+PILLAR_COPY_PAGES = (HOME, *DOCS_PAGES)
+
+
+def _html(page: Path) -> str:
+    return page.read_text(encoding="utf-8")
+
+
+def _text(page: Path) -> str:
+    return " ".join(_html(page).split())
+
+
+def test_public_copy_uses_mainnode_and_never_masternode():
+    for page in PILLAR_COPY_PAGES:
+        text = _text(page).lower()
+        assert "mainnode" in text
+        for forbidden in ("masternode", "master node", "master-node"):
+            assert forbidden not in text
+
+
+def test_homepage_pins_pillar1_clarity_cards_and_worker_boundary():
+    text = _text(HOME)
+    html = _html(HOME)
+
+    for marker in (
+        "Boring Git first",
+        "Mainnode, not Git owner",
+        "Core protocol is not token-gated",
+        "ForkMesh does not make the Worker or a mainnode the canonical Git storage layer.",
+        "Solana paths are experimental",
+        "What parts are centralized today?",
+        "What happens if forkmesh.com goes offline?",
+    ):
+        assert marker in text
+
+    for anchor in (
+        'href="/docs#compatibility-matrix"',
+        'href="/docs#centralization-model"',
+        'href="/docs#money-model"',
+    ):
+        assert anchor in html
+
+
+def test_docs_publish_pillar1_sections():
+    for page in DOCS_PAGES:
+        html = _html(page)
+        text = _text(page)
+
+        for section_id in (
+            "product-clarity",
+            "compatibility-matrix",
+            "centralization-model",
+            "money-model",
+            "threat-model",
+            "comparison",
+            "github-refugees",
+        ):
+            assert f'id="{section_id}"' in html
+            assert f'href="#{section_id}"' in html
+
+        for marker in (
+            "What ForkMesh is",
+            "Compatibility matrix",
+            "Git clone",
+            "Git fetch",
+            "Git push",
+            "Git LFS",
+            "Desktop app",
+            "Web browser",
+            "VS Code",
+            "Mobile",
+            "Mainnode / Worker",
+            "Control plane, not Git storage",
+            "Core protocol",
+            "Threat model",
+            "GitHub refugee guide",
+        ):
+            assert marker in text
+
+
+def test_docs_centralization_and_money_copy_is_honest():
+    for page in DOCS_PAGES:
+        text = _text(page)
+
+        for marker in (
+            "the public network uses one Cloudflare Worker mainnode",
+            "Git mirrors live on desktop/headless nodes",
+            "automatic multi-mainnode catalog convergence is roadmap work",
+            "ForkMesh core Git preservation does not require a token",
+            "Treat those money paths as product experiments",
+            "Git push",
+        ):
+            assert marker in text
