+void MainWindow::setDataStatus(const QString &text, bool error)
+{
+    if (!m_dataStatus)
+        return;
+    m_dataStatus->setText(text);
+    m_dataStatus->setStyleSheet(error ? QStringLiteral("color:#f85149;")
+                                       : QString());
+    m_dataStatus->setVisible(!text.isEmpty());
+}
