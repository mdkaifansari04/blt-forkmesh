+        runGit(workTree, {"fetch", "--no-tags", "--quiet", mirror,
+                          "refs/heads/" + head})) {
+        if (runGit(workTree,
+                   {"rev-parse", "--verify", "--quiet", "FETCH_HEAD^{commit}"},
+                   &sha) &&
+            !sha.trimmed().isEmpty())
+            return QString::fromUtf8(sha).trimmed();
+    }
+    return QString();
+}
