+ADMIN_SESSION_COOKIE = "forkmesh_admin"
+ADMIN_SESSION_TTL_MS = 12 * 60 * 60 * 1000
+
+
+def _admin_session_secret(env):
+    return (str(getattr(env, "ADMIN_PASS", "") or "") + "|" +
+            str(getattr(env, "DATA_KEY", "") or "")).encode()
+
+
+def _admin_session_token(env, now=None):
+    ts = str(int(Date.now() if now is None else now))
+    sig = hmac.new(
+        _admin_session_secret(env),
+        ("forkmesh-admin-session-v1\n" + ts).encode(),
+        "sha256",
+    ).hexdigest()
+    return ts + "." + sig
+
+
+def _admin_session_valid(env, token):
+    try:
+        ts, sig = str(token or "").split(".", 1)
+        age = int(Date.now()) - int(ts)
+    except (TypeError, ValueError):
+        return False
+    if age < 0 or age > ADMIN_SESSION_TTL_MS:
+        return False
+    expected = _admin_session_token(env, now=int(ts)).split(".", 1)[1]
+    return hmac.compare_digest(sig, expected)
+
+
+def _request_cookie(request, name):
+    header = request.headers.get("cookie") or ""
+    prefix = name + "="
+    for part in header.split(";"):
+        item = part.strip()
+        if item.startswith(prefix):
+            return item[len(prefix):]
+    return ""
+
+
+def _admin_session_cookie(env, request):
+    secure = "; Secure" if urlparse(request.url).scheme == "https" else ""
+    return (
+        ADMIN_SESSION_COOKIE + "=" + _admin_session_token(env) +
+        "; Path=/admin; Max-Age=%d; HttpOnly; SameSite=Lax%s" %
+        (ADMIN_SESSION_TTL_MS // 1000, secure)
+    )
+
+
+def _admin_clear_session_cookie(request):
+    secure = "; Secure" if urlparse(request.url).scheme == "https" else ""
+    return (ADMIN_SESSION_COOKIE +
+            "=; Path=/admin; Max-Age=0; HttpOnly; SameSite=Lax" + secure)
+
+
+def _admin_is_authenticated(env, request):
+    return (_check_basic_auth(env, request) or
+            _admin_session_valid(env, _request_cookie(request, ADMIN_SESSION_COOKIE)))
+
+
+def _admin_login_ok(env, form):
+    user = str(getattr(env, "ADMIN_USER", "") or "")
+    password = str(getattr(env, "ADMIN_PASS", "") or "")
+    if not user or not password:
+        return False
+    submitted_user = (form.get("username", [""]) or [""])[0]
+    submitted_password = (form.get("password", [""]) or [""])[0]
+    return (hmac.compare_digest(submitted_user, user) and
+            hmac.compare_digest(submitted_password, password))
+
+
+def _admin_login_response(message="", status=200):
+    banner = ('<div class="login-error">%s</div>' % _html_escape(message)) if message else ""
+    return Response(
+        "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
+        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
+        "<title>forkmesh · admin sign in</title><style>" + ADMIN_STYLE +
+        "</style></head><body class=\"login-body\">"
+        "<main class=\"login-shell\"><section class=\"login-card\">"
+        "<div class=\"login-kicker\">forkmesh admin</div>"
+        "<h1>Sign in</h1>"
+        "<p class=\"meta\">Use the admin username and password from Worker secrets.</p>"
+        + banner +
+        "<form method=\"post\" action=\"/admin?action=login\" class=\"login-form\">"
+        "<label class=\"login-field\"><span>Username</span>"
+        "<input name=\"username\" autocomplete=\"username\" required autofocus></label>"
+        "<label class=\"login-field\"><span>Password</span>"
+        "<input name=\"password\" type=\"password\" autocomplete=\"current-password\" required></label>"
+        "<button type=\"submit\">Sign in</button>"
+        "</form></section></main></body></html>",
+        status=status,
+        headers={"content-type": "text/html; charset=utf-8"},
+    )
+
+
+def _admin_redirect(request, cookie):
+    url = urlparse(request.url)
+    location = url.scheme + "://" + url.netloc + "/admin"
+    return Response("", status=303, headers={"location": location, "set-cookie": cookie})
+
+
