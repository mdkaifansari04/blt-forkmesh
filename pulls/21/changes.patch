diff --git a/cloudflare_worker/tests/test_admin_sign_in.py b/cloudflare_worker/tests/test_admin_sign_in.py
new file mode 100644
index 0000000..ef5b5a7
--- /dev/null
+++ b/cloudflare_worker/tests/test_admin_sign_in.py
@@ -0,0 +1,22 @@
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+ENTRY = (ROOT / "src" / "entry.py").read_text()
+WRANGLER = (ROOT / "wrangler.toml").read_text()
+
+
+def test_bare_admin_path_routes_to_worker_before_assets():
+    assert 'requested_path == "admin"' in ENTRY
+    assert '"/admin"' in WRANGLER
+    assert '"/admin/*"' in WRANGLER
+    assert '"/admin-*"' in WRANGLER
+
+
+def test_admin_uses_form_login_session_instead_of_browser_prompt():
+    assert 'def _admin_login_response(' in ENTRY
+    assert 'def _admin_session_token(' in ENTRY
+    assert 'def _admin_is_authenticated(' in ENTRY
+    assert '/admin?action=login' in ENTRY
+    assert 'forkmesh_admin' in ENTRY
+    unauth_block = ENTRY.split('if not _admin_is_authenticated', 1)[1].split('await ensure_schema', 1)[0]
+    assert 'WWW-Authenticate' not in unauth_block
