+base: main
+head: agent/adhoc-48-when-i-delete-an-agent-from-the-list-please-adva
+status: open
+ts: 1782518677488
+author: 7ZMh_2s_IOTPiKoZ6K5eDe4AclTYh_JzqJ7pK2lovT4
