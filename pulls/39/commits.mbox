+// selection is preserved across a provider switch when the model still applies.
+void populateAgentModelCombo(QComboBox *combo, const QString &provider)
+{
+    if (!combo)
+        return;
+    const QString previous = combo->currentData().toString();
+    QSignalBlocker block(combo);
+    combo->clear();
+    combo->addItem(QStringLiteral("Default model"), QString());
+    // Claude Code and the Claude API both take Claude model ids; OpenAI's model
+    // is configured in Settings, so it keeps the default-only choice here.
+    if (provider != QLatin1String("openai")) {
+        combo->addItem(QStringLiteral("Claude Opus 4.8"),
