+int MainWindow::nextAgentSessionAfterSelected() const
+{
+    if (!m_agentTable)
+        return -1;
+    const QModelIndexList sel = m_agentTable->selectionModel()->selectedRows();
+    if (sel.isEmpty())
+        return -1;
+    const int row = sel.first().row();
+    // Prefer the row below the one being deleted; fall back to the row above
+    // when the last row is going away.
+    int nextRow = -1;
+    if (row + 1 < m_agentTable->rowCount())
+        nextRow = row + 1;
+    else if (row - 1 >= 0)
+        nextRow = row - 1;
+    if (nextRow < 0)
+        return -1;
+    QTableWidgetItem *item = m_agentTable->item(nextRow, 0);
+    return item ? item->data(Qt::UserRole).toInt() : -1;
