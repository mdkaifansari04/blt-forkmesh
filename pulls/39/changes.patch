+    const message = String(error && (error.stack || error.message || error));
+    const event = {
+      event_id: eventId,
+      timestamp: Date.now() / 1000,
+      platform: "javascript",
+      logger: "forkmesh.cloudflare_marketing_worker",
+      level: "error",
+      message: message.slice(0, 1000) || "Worker threw exception",
+      transaction: url.pathname,
+      tags: {
+        runtime: "cloudflare-worker",
+        service: "forkmesh-marketing",
+        "cloudflare.error_code": "1101",
+        "cloudflare.ray_id": ray,
+      },
+      contexts: {
+        cloudflare: { error_code: "1101", ray_id: ray },
+      },
+      request: {
+        url: url.origin + url.pathname,
+        method: request.method,
+        headers: {
+          "user-agent": request.headers.get("user-agent") || "",
+          "cf-ray": ray,
+        },
+      },
+      exception: {
+        values: [{
+          type: String(error && error.name || "Error"),
+          value: String(error && error.message || error).slice(0, 1000),
+        }],
+      },
+      extra: { stack: message.slice(0, 8000) },
+    };
+    const envelope = JSON.stringify({ event_id: eventId, dsn: parts.dsn }) +
+      "\n" + JSON.stringify({ type: "event" }) +
+      "\n" + JSON.stringify(event) + "\n";
+    const response = await fetch(parts.endpoint, {
+      method: "POST",
+      headers: {
+        "content-type": "application/x-sentry-envelope",
+        "x-sentry-auth": parts.auth,
+      },
+      body: envelope,
+    });
+    return response.ok;
+  } catch (_err) {
+    return false;
+  }
+}
