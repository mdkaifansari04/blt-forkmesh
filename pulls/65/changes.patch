+/* Persistent, centered World controls. Avatar actions are gameplay controls,
+   not chat controls, so they remain reachable even when the chat transcript is
+   closed. The three activity totals similarly have one home at the top center
+   instead of duplicating badges inside the avatar launcher. */
+.world-avatar-actions {
+  position: fixed;
+  z-index: 58;
+  bottom: max(12px, env(safe-area-inset-bottom));
+  left: 50%;
+  display: flex;
+  max-width: calc(100vw - 160px);
+  gap: 7px;
+  overflow-x: auto;
+  padding: 4px;
+  scrollbar-width: none;
+  transform: translateX(-50%);
+}
+
+.world-avatar-actions::-webkit-scrollbar {
+  display: none;
+}
+
+.world-avatar-actions button {
+  display: grid;
+  width: 42px;
+  min-width: 42px;
+  height: 42px;
+  place-items: center;
+  border: 1px solid rgb(139 148 158 / 0.55);
+  border-radius: 50%;
+  background: rgb(13 17 23 / 0.72);
+  color: #f0f6fc;
+  font-size: 1.05rem;
+  box-shadow: 0 8px 24px rgb(1 4 9 / 0.35);
+  cursor: pointer;
+  backdrop-filter: blur(16px) saturate(1.2);
+}
+
+.world-avatar-actions button:hover,
+.world-avatar-actions button:focus-visible {
