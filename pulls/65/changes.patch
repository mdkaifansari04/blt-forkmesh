+  background: rgb(31 111 235 / 0.4);
+  outline: none;
+}
+
+.world-status-actions {
+  position: fixed;
+  z-index: 59;
+  top: max(10px, env(safe-area-inset-top));
+  left: 50%;
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  transform: translateX(-50%);
+}
+
+.world-status-actions button {
+  display: inline-flex;
+  min-width: 44px;
+  height: 28px;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  border: 1px solid rgb(139 148 158 / 0.55);
