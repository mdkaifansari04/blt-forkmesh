diff --git a/cloudflare_worker/migrations/0036_email_admin_default_category.sql b/cloudflare_worker/migrations/0036_email_admin_default_category.sql
new file mode 100644
index 00000000..24857525
--- /dev/null
+++ b/cloudflare_worker/migrations/0036_email_admin_default_category.sql
@@ -0,0 +1,27 @@
+-- ForkMesh D1 migration 0029 - one protected default outreach category.
+
+ALTER TABLE email_categories
+  ADD COLUMN is_system INTEGER NOT NULL DEFAULT 0
+  CHECK (is_system IN (0, 1));
+
+INSERT OR IGNORE INTO email_categories
+  (name, is_system, created_at, updated_at)
+VALUES
+  ('default', 1, unixepoch() * 1000, unixepoch() * 1000);
+
+UPDATE email_categories
+SET is_system = CASE
+  WHEN name = 'default' COLLATE NOCASE THEN 1
+  ELSE 0
+END;
+
+CREATE UNIQUE INDEX IF NOT EXISTS idx_email_categories_one_system
+  ON email_categories(is_system)
+  WHERE is_system = 1;
+
+INSERT OR IGNORE INTO email_category_memberships
+  (category_id, recipient_id, created_at)
+SELECT category.id, recipient.id, unixepoch() * 1000
+FROM email_categories AS category
+CROSS JOIN email_recipients AS recipient
+WHERE category.is_system = 1;
diff --git a/cloudflare_worker/public/assets/email-admin.js b/cloudflare_worker/public/assets/email-admin.js
new file mode 100644
index 00000000..3c459989
--- /dev/null
+++ b/cloudflare_worker/public/assets/email-admin.js
@@ -0,0 +1,376 @@
+(function (root, factory) {
+  const api = factory();
+  if (typeof module === "object" && module.exports) {
+    module.exports = api;
+  } else {
+    root.ForkMeshEmailAdmin = api;
+    if (root.document) {
+      root.document.addEventListener("DOMContentLoaded", function () {
+        api.bindRecipientImport(root.document);
+        api.bindRecipientSelection(root.document);
+      });
+    }
+  }
+})(typeof globalThis === "object" ? globalThis : this, function () {
+  "use strict";
+
+  const MAX_JSON_CHARS = 2 * 1024 * 1024;
+  const MAX_RECIPIENTS = 1000;
+  const EMAIL_LOCAL = /^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+$/;
+  const EMAIL_DOMAIN_LABEL = /^[A-Za-z0-9-]+$/;
+  const UNSAFE_TEXT = /[\p{C}\p{Zl}\p{Zp}]/u;
+
+  function normalizeEmail(value) {
+    if (typeof value !== "string" || UNSAFE_TEXT.test(value)) return "";
+    const email = value.trim().toLowerCase();
+    if (!/^[\x00-\x7f]+$/.test(email) || email.length > 254) return "";
+    if ((email.match(/@/g) || []).length !== 1) return "";
+
+    const parts = email.split("@");
+    const local = parts[0];
+    const domain = parts[1];
+    if (
+      local.length < 1 ||
+      local.length > 64 ||
+      !EMAIL_LOCAL.test(local) ||
+      local.startsWith(".") ||
+      local.endsWith(".") ||
+      local.includes("..") ||
+      domain.length < 1 ||
+      domain.length > 253 ||
+      !domain.includes(".")
+    ) {
+      return "";
+    }
+
+    const labels = domain.split(".");
+    if (
+      labels.some(function (label) {
+        return (
+          label.length < 1 ||
+          label.length > 63 ||
+          !EMAIL_DOMAIN_LABEL.test(label) ||
+          label.startsWith("-") ||
+          label.endsWith("-")
+        );
+      })
+    ) {
+      return "";
+    }
+    return email;
+  }
+
+  function jsonErrorMessage(raw, error) {
+    const message = String(error && error.message ? error.message : "");
+    const lineColumn = message.match(/line\s+(\d+)\s+column\s+(\d+)/i);
+    if (lineColumn) {
+      return (
+        "JSON syntax error at line " +
+        lineColumn[1] +
+        ", column " +
+        lineColumn[2] +
+        "."
+      );
+    }
+
+    const positionMatch = message.match(/position\s+(\d+)/i);
+    let position = positionMatch ? Number(positionMatch[1]) : 0;
+    if (!Number.isFinite(position) || position < 0) position = 0;
+    const prefix = raw.slice(0, position);
+    const lines = prefix.split("\n");
+    return (
+      "JSON syntax error at line " +
+      lines.length +
+      ", column " +
+      (lines[lines.length - 1].length + 1) +
+      "."
+    );
+  }
+
+  function metadataErrors(item, index) {
+    const errors = [];
+    ["name", "company"].forEach(function (field) {
+      const value = item[field];
+      if (value === undefined || value === null) return;
+      if (typeof value !== "string") {
+        errors.push(
+          'Item ' + index + ': field "' + field + '" must be text or null.'
+        );
+      } else if (UNSAFE_TEXT.test(value)) {
+        errors.push(
+          'Item ' + index + ': field "' + field + '" contains invalid characters.'
+        );
+      }
+    });
+    return errors;
+  }
+
+  function validateRecipientArray(raw) {
+    if (typeof raw !== "string" || raw.length > MAX_JSON_CHARS) {
+      return {
+        ok: false,
+        errors: ["Recipient JSON cannot exceed 2 MiB."],
+      };
+    }
+
+    let payload;
+    try {
+      payload = JSON.parse(raw);
+    } catch (error) {
+      return { ok: false, errors: [jsonErrorMessage(raw, error)] };
+    }
+    if (!Array.isArray(payload)) {
+      return {
+        ok: false,
+        errors: ["Top-level JSON value must be an array."],
+      };
+    }
+    if (payload.length === 0) {
+      return {
+        ok: false,
+        errors: ["Recipient array must contain at least one item."],
+      };
+    }
+    if (payload.length > MAX_RECIPIENTS) {
+      return {
+        ok: false,
+        errors: ["Recipient array cannot contain more than 1,000 items."],
+      };
+    }
+
+    const errors = [];
+    const normalized = new Set();
+    let validCount = 0;
+    payload.forEach(function (item, offset) {
+      const index = offset + 1;
+      let emailValue;
+      if (typeof item === "string") {
+        emailValue = item;
+      } else if (item && typeof item === "object" && !Array.isArray(item)) {
+        if (
+          !Object.prototype.hasOwnProperty.call(item, "email") ||
+          item.email === null ||
+          (typeof item.email === "string" && !item.email.trim())
+        ) {
+          errors.push('Item ' + index + ': required field "email" is missing.');
+          return;
+        }
+        emailValue = item.email;
+        const itemErrors = metadataErrors(item, index);
+        if (itemErrors.length) {
+          errors.push.apply(errors, itemErrors);
+          return;
+        }
+      } else {
+        errors.push(
+          "Item " + index + ": expected an email string or recipient object."
+        );
+        return;
+      }
+
+      const email = normalizeEmail(emailValue);
+      if (!email) {
+        errors.push(
+          'Item ' + index + ': field "email" must be a valid ASCII email address.'
+        );
+        return;
+      }
+      validCount += 1;
+      normalized.add(email);
+    });
+
+    if (errors.length) return { ok: false, errors: errors };
+    return {
+      ok: true,
+      formatted: JSON.stringify(payload, null, 2),
+      validCount: validCount,
+      uniqueCount: normalized.size,
+      duplicateCount: validCount - normalized.size,
+    };
+  }
+
+  function createImportState() {
+    let accepted = [];
+    return {
+      validate: function (raw) {
+        const result = validateRecipientArray(raw);
+        accepted = result.ok ? [raw, result.formatted] : [];
+        return result;
+      },
+      invalidate: function () {
+        accepted = [];
+        return false;
+      },
+      isReady: function (raw) {
+        return accepted.includes(raw);
+      },
+    };
+  }
+
+  function renderValidation(container, result) {
+    container.replaceChildren();
+    if (result.ok) {
+      container.className = "validation-status validation-success";
+      container.textContent =
+        result.validCount +
+        " valid · " +
+        result.uniqueCount +
+        " unique · " +
+        result.duplicateCount +
+        " duplicate" +
+        (result.duplicateCount === 1 ? "" : "s") +
+        " merged";
+      return;
+    }
+
+    container.className = "validation-status import-errors";
+    const list = container.ownerDocument.createElement("ul");
+    result.errors.forEach(function (message) {
+      const item = container.ownerDocument.createElement("li");
+      item.textContent = message;
+      list.appendChild(item);
+    });
+    container.appendChild(list);
+  }
+
+  function bindRecipientImport(document) {
+    const form = document.getElementById("recipient-import-form");
+    if (!form) return false;
+    const textarea = document.getElementById("recipient-json");
+    const format = document.getElementById("recipient-format");
+    const submit = document.getElementById("recipient-import-submit");
+    const status = document.getElementById("recipient-validation");
+    if (!textarea || !format || !submit || !status) return false;
+
+    const state = createImportState();
+    submit.disabled = true;
+    textarea.addEventListener("input", function () {
+      state.invalidate();
+      submit.disabled = true;
+      status.replaceChildren();
+      status.className = "validation-status";
+    });
+    format.addEventListener("click", function () {
+      const result = state.validate(textarea.value);
+      if (result.ok) textarea.value = result.formatted;
+      renderValidation(status, result);
+      submit.disabled = !result.ok;
+    });
+    form.addEventListener("submit", function (event) {
+      if (!state.isReady(textarea.value)) {
+        event.preventDefault();
+        submit.disabled = true;
+        renderValidation(status, {
+          ok: false,
+          errors: ["Format and validate the current array before importing."],
+        });
+      }
+    });
+    return true;
+  }
+
+  function recipientBulkState(selectedCount, action, categoryId, confirmed) {
+    const count = Number.isFinite(Number(selectedCount))
+      ? Math.max(0, Number(selectedCount))
+      : 0;
+    const categoryAction =
+      action === "add_category" || action === "remove_category";
+    const deleteAction = action === "delete";
+    const hasCategory = String(categoryId || "").trim().length > 0;
+    return {
+      showBar: count > 0,
+      showCategory: categoryAction,
+      showDeleteConfirm: deleteAction,
+      canSubmit:
+        count > 0 &&
+        ((categoryAction && hasCategory) || (deleteAction && confirmed === true)),
+    };
+  }
+
+  function bindRecipientSelection(document) {
+    const form = document.getElementById("recipient-bulk-form");
+    if (!form) return false;
+    const rows = Array.from(form.querySelectorAll(".recipient-select"));
+    const selectAll = form.querySelector("[data-select-all]");
+    const count = form.querySelector("[data-selection-count]");
+    const bar = form.querySelector("[data-bulk-actions]");
+    const action = form.querySelector('[name="bulk_action"]');
+    const categoryControl = form.querySelector("[data-category-control]");
+    const category = form.querySelector('[name="category_id"]');
+    const deleteControl = form.querySelector("[data-delete-control]");
+    const deleteConfirmation = form.querySelector(
+      '[name="confirm_bulk_delete"]'
+    );
+    const submit = form.querySelector("[data-bulk-submit]");
+
+    function update() {
+      const selected = rows.filter(function (checkbox) {
+        return checkbox.checked;
+      });
+      const state = recipientBulkState(
+        selected.length,
+        action ? action.value : "",
+        category ? category.value : "",
+        Boolean(deleteConfirmation && deleteConfirmation.checked)
+      );
+      if (count) count.textContent = String(selected.length);
+      if (bar) bar.hidden = !state.showBar;
+      if (categoryControl) categoryControl.hidden = !state.showCategory;
+      if (category) {
+        category.disabled = !state.showCategory;
+        category.required = state.showCategory;
+      }
+      if (deleteControl) deleteControl.hidden = !state.showDeleteConfirm;
+      if (deleteConfirmation) {
+        deleteConfirmation.disabled = !state.showDeleteConfirm;
+      }
+      if (submit) submit.disabled = !state.canSubmit;
+      rows.forEach(function (checkbox) {
+        const row = checkbox.closest("tr");
+        if (row) row.classList.toggle("selected-row", checkbox.checked);
+      });
+      if (selectAll) {
+        selectAll.checked = rows.length > 0 && selected.length === rows.length;
+        selectAll.indeterminate = selected.length > 0 && selected.length < rows.length;
+      }
+    }
+
+    rows.forEach(function (checkbox) {
+      checkbox.addEventListener("change", update);
+    });
+    if (selectAll) {
+      selectAll.addEventListener("change", function () {
+        rows.forEach(function (checkbox) {
+          checkbox.checked = selectAll.checked;
+        });
+        update();
+      });
+    }
+    if (action) {
+      action.addEventListener("change", function () {
+        if (action.value !== "delete" && deleteConfirmation) {
+          deleteConfirmation.checked = false;
+        }
+        update();
+      });
+    }
+    if (category) category.addEventListener("change", update);
+    if (deleteConfirmation) {
+      deleteConfirmation.addEventListener("change", update);
+    }
+    form.addEventListener("reset", function () {
+      setTimeout(update, 0);
+    });
+    update();
+    return true;
+  }
+
+  return {
+    validateRecipientArray: validateRecipientArray,
+    normalizeEmail: normalizeEmail,
+    createImportState: createImportState,
+    recipientBulkState: recipientBulkState,
+    bindRecipientImport: bindRecipientImport,
+    bindRecipientSelection: bindRecipientSelection,
+  };
+});
