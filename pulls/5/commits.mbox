+async def _email_admin_bulk_recipients(
+    env, submitted_ids, action, category_id=None, confirm_delete=False
+):
+    values = [] if submitted_ids is None else list(submitted_ids)
+    if not values:
+        raise ValueError("select at least one recipient")
+    if len(values) > 50:
+        raise ValueError("select no more than 50 recipients")
+
+    selected = []
+    for value in values:
+        try:
+            selected.append(_email_admin_id(value, "recipient"))
+        except ValueError as error:
+            raise ValueError("unknown recipient") from error
+    if len(set(selected)) != len(selected):
+        raise ValueError("duplicate recipient selection")
+    if action not in ("add_category", "remove_category", "delete"):
+        raise ValueError("unknown bulk action")
+    if action == "delete" and not confirm_delete:
+        raise ValueError("confirm recipient deletion first")
+
+    placeholders = ",".join("?" for _value in selected)
+    live_rows = await d1_all(
+        env,
+        "SELECT id FROM email_recipients WHERE id IN (" + placeholders + ")",
+        *selected,
+    )
+    live = {
+        _email_admin_id(row.get("id"), "recipient")
+        for row in live_rows
+        if row.get("id") is not None
+    }
+    if live != set(selected):
+        raise ValueError("unknown recipient")
+
+    if action in ("add_category", "remove_category"):
+        try:
+            selected_category = _email_admin_id(category_id, "category")
+        except ValueError as error:
+            raise ValueError("unknown category") from error
+        category = await d1_first(
+            env,
+            "SELECT id,is_system FROM email_categories WHERE id=?",
+            selected_category,
+        )
+        if not category:
+            raise ValueError("unknown category")
+        if int(category.get("is_system") or 0) == 1:
+            raise ValueError("default category is protected")
+
+        if action == "add_category":
+            now = int(Date.now())
+            statements = []
+            for start in range(0, len(selected), 33):
+                chunk = selected[start:start + 33]
+                values_sql = ",".join("(?,?,?)" for _value in chunk)
+                args = []
+                for recipient_id in chunk:
+                    args.extend((selected_category, recipient_id, now))
+                statements.append(
+                    env.DB.prepare(
+                        "INSERT OR IGNORE INTO email_category_memberships "
+                        "(category_id,recipient_id,created_at) VALUES "
+                        + values_sql
+                    ).bind(*args)
+                )
+            await env.DB.batch(statements)
+            return (
+                "Added "
+                + str(len(selected))
+                + " recipient"
+                + ("" if len(selected) == 1 else "s")
+                + " to the category."
+            )
+
+        await d1_run(
+            env,
+            "DELETE FROM email_category_memberships WHERE category_id=? "
+            "AND recipient_id IN (" + placeholders + ")",
+            selected_category,
+            *selected,
+        )
+        return (
+            "Removed "
+            + str(len(selected))
+            + " recipient"
+            + ("" if len(selected) == 1 else "s")
+            + " from the category."
+        )
+
+    await d1_run(
+        env,
+        "DELETE FROM email_recipients WHERE id IN (" + placeholders + ")",
+        *selected,
+    )
+    return (
+        "Deleted "
+        + str(len(selected))
+        + " recipient"
+        + ("" if len(selected) == 1 else "s")
+        + "."
+    )
