+import json
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+CLIENT = ROOT / "public" / "assets" / "email-admin.js"
+
+
+def run_client(expression, raw=None):
+    script = (
+        "const api=require(" + json.dumps(str(CLIENT)) + ");"
+        + "const value="
+        + expression
+        + ";process.stdout.write(JSON.stringify(value));"
+    )
+    arguments = ["node", "-e", script]
+    if raw is not None:
+        arguments.append(raw)
+    result = subprocess.run(
+        arguments,
+        cwd=ROOT,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+    )
+    assert result.returncode == 0, result.stderr
+    return json.loads(result.stdout)
+
+
+def validate(raw):
+    return run_client("api.validateRecipientArray(process.argv[1])", raw)
+
+
+def test_client_formats_valid_mixed_array_and_counts_duplicates():
+    result = validate(
+        '["A@example.com",'
+        '{"email":"a@example.com","name":"Alpha","company":"Orbit"}]'
+    )
+
+    assert result["ok"] is True
+    assert result["validCount"] == 2
+    assert result["uniqueCount"] == 1
+    assert result["duplicateCount"] == 1
+    assert result["formatted"].startswith('[\n  "A@example.com",')
+
+
+def test_client_reports_indexed_prototype_errors():
+    result = validate('[{"name":"Missing"},42]')
+
+    assert result == {
+        "ok": False,
+        "errors": [
+            'Item 1: required field "email" is missing.',
+            "Item 2: expected an email string or recipient object.",
+        ],
+    }
+
+
+def test_client_reports_json_location_and_requires_an_array():
+    syntax = validate('["valid@example.com",]')
+    wrong_shape = validate('{"email":"person@example.com"}')
+
+    assert syntax["ok"] is False
+    assert syntax["errors"][0].startswith("JSON syntax error at line 1, column ")
+    assert wrong_shape == {
+        "ok": False,
+        "errors": ["Top-level JSON value must be an array."],
+    }
+
+
+def test_client_rejects_an_empty_array():
+    assert validate("[]") == {
+        "ok": False,
+        "errors": ["Recipient array must contain at least one item."],
+    }
+
+
+def test_client_enforces_item_limit_and_metadata_types():
+    too_many = json.dumps(["person@example.com"] * 1_001)
+    result = validate(too_many)
+    invalid_metadata = validate(
+        '[{"email":"person@example.com","name":42,"company":["Orbit"]}]'
+    )
+
+    assert result == {
+        "ok": False,
+        "errors": ["Recipient array cannot contain more than 1,000 items."],
+    }
+    assert invalid_metadata == {
+        "ok": False,
+        "errors": [
+            'Item 1: field "name" must be text or null.',
+            'Item 1: field "company" must be text or null.',
+        ],
+    }
+
+
+def test_client_email_normalization_matches_ascii_server_contract():
+    result = run_client(
+        "["
+        "api.normalizeEmail(' Person@Example.com '),"
+        "api.normalizeEmail('person@example'),"
+        "api.normalizeEmail('té@example.com'),"
+        "api.normalizeEmail('a..b@example.com')"
+        "]"
+    )
+
+    assert result == ["person@example.com", "", "", ""]
+
+
+def test_client_validation_state_requires_exact_unchanged_text():
+    result = run_client(
+        "(()=>{"
+        "const state=api.createImportState();"
+        "const raw='[\"person@example.com\"]';"
+        "const checked=state.validate(raw);"
+        "return [checked.ok,state.isReady(raw),state.isReady(raw+' '),"
+        "state.invalidate(),state.isReady(raw)];"
+        "})()"
+    )
+
+    assert result == [True, True, False, False, False]
+
+
+def test_client_bulk_state_reveals_only_required_controls():
+    result = run_client(
+        "["
+        "api.recipientBulkState(0,'','',false),"
+        "api.recipientBulkState(2,'add_category','',false),"
+        "api.recipientBulkState(2,'remove_category','3',false),"
+        "api.recipientBulkState(2,'delete','',false),"
+        "api.recipientBulkState(2,'delete','',true)"
+        "]"
+    )
+
+    assert result == [
+        {
