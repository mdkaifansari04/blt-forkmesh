@@ -0,0 +1,130 @@
+from pathlib import Path
+import json
+import subprocess
+
+
+PUBLIC = Path(__file__).resolve().parents[1] / "public"
+ROOT = PUBLIC.parent.parent
+EVENTS = (
+    "forkmesh.homepage_cta_clicked",
+    "forkmesh.install_command_copied",
+    "forkmesh.proof_path_link_clicked",
+)
+ROADMAP_EVENTS = (
+    "forkmesh.desktop_installer_started",
+    "forkmesh.desktop_installer_succeeded",
+    "forkmesh.repo_mirrored_or_published",
+    "forkmesh.clone_route_requested",
+    "forkmesh.clone_fallback_served_by_mirror",
+)
+
+
+def _read(path: Path) -> str:
+    return path.read_text(encoding="utf-8")
+
+
+def test_product_telemetry_uses_a_closed_event_and_property_allowlist():
+    helper = _read(PUBLIC / "product-telemetry.js")
+
+    for event in EVENTS:
+        assert event in helper
+    for property_name in ("surface", "destination", "proof_step"):
+        assert property_name in helper
+    for forbidden_property in ("repository", "repo", "user", "email", "host", "clone_url"):
+        assert f'"{forbidden_property}":' not in helper
+
+
+def test_product_telemetry_runtime_drops_unknown_events_and_non_allowlisted_properties():
+    script = """
+const fs = require("fs");
+const vm = require("vm");
+const calls = [];
+const listeners = {};
+const context = {
+  window: { posthog: { capture: (eventName, properties) => calls.push({ eventName, properties }) } },
+  document: { addEventListener: (name, listener) => { listeners[name] = listener; } },
+};
+vm.runInNewContext(fs.readFileSync(process.argv[1], "utf8"), context);
+context.window.forkmeshTrackProductEvent("forkmesh.homepage_cta_clicked", {
+  surface: "homepage",
+  destination: "docs",
+  repository: "private-project",
+});
+context.window.forkmeshTrackProductEvent("forkmesh.unknown", { surface: "homepage" });
+listeners.click({ target: { closest: () => ({ dataset: {
+  productEvent: "forkmesh.proof_path_link_clicked",
+  productSurface: "docs",
+  productDestination: "mirror_failover",
+  productProofStep: "clone_again",
+  productRepository: "private-project",
+} }) } });
+console.log(JSON.stringify(calls));
+"""
+    result = subprocess.run(
+        ["node", "-e", script, str(PUBLIC / "product-telemetry.js")],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+    assert json.loads(result.stdout) == [
+        {
+            "eventName": "forkmesh.homepage_cta_clicked",
+            "properties": {"surface": "homepage", "destination": "docs"},
+        },
+        {
+            "eventName": "forkmesh.proof_path_link_clicked",
+            "properties": {
+                "surface": "docs",
+                "destination": "mirror_failover",
