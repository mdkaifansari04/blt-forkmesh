+        for proof_step in ("collaborate", "add_mirror", "source_host_offline", "clone_again"):
+            assert f'data-product-proof-step="{proof_step}"' in content
+
+
+def test_telemetry_evidence_marks_server_side_product_metrics_as_roadmap_until_privacy_reviewed():
+    evidence = _read(ROOT / "docs" / "product-contract-evidence.md")
+
+    for event in ROADMAP_EVENTS:
+        assert event in evidence
+    assert "Roadmap" in evidence
+    assert "privacy-reviewed aggregate" in evidence
