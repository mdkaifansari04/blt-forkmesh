+
+    homepage = _read(PUBLIC / "index.html")
+    for destination in ("signup", "desktop", "docs"):
+        assert (
+            'data-product-event="forkmesh.homepage_cta_clicked"'
+            in homepage
+        )
+        assert f'data-product-destination="{destination}"' in homepage
+
+    desktop = _read(PUBLIC / "desktop.html")
+    assert desktop.count('data-product-copy-event="forkmesh.install_command_copied"') == 4
+    assert 'data-product-surface="desktop"' in desktop
+
+    for page in (PUBLIC / "index.html", PUBLIC / "docs.html", PUBLIC / "docs" / "index.html"):
