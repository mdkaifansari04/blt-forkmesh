@@ -0,0 +1,61 @@
+(() => {
+  const EVENT_PROPERTIES = Object.freeze({
+    "forkmesh.homepage_cta_clicked": Object.freeze({
+      surface: Object.freeze(["homepage"]),
+      destination: Object.freeze(["signup", "desktop", "docs"]),
+    }),
+    "forkmesh.install_command_copied": Object.freeze({
+      surface: Object.freeze(["homepage", "desktop"]),
+    }),
+    "forkmesh.proof_path_link_clicked": Object.freeze({
+      surface: Object.freeze(["homepage", "docs"]),
+      destination: Object.freeze([
+        "collaboration",
+        "desktop",
+        "mirror_failover",
+        "repositories",
+      ]),
+      proof_step: Object.freeze([
+        "collaborate",
+        "add_mirror",
+        "source_host_offline",
+        "clone_again",
+      ]),
+    }),
+  });
+
+  function trackProductEvent(eventName, candidateProperties = {}) {
+    const allowedProperties = EVENT_PROPERTIES[eventName];
+    if (
+      !allowedProperties ||
+      !window.posthog ||
+      typeof window.posthog.capture !== "function"
+    ) {
+      return false;
+    }
+
+    const safeProperties = {};
+    Object.entries(allowedProperties).forEach(([key, values]) => {
+      const value = candidateProperties[key];
+      if (typeof value === "string" && values.includes(value)) {
+        safeProperties[key] = value;
+      }
+    });
+
+    window.posthog.capture(eventName, safeProperties);
+    return true;
+  }
+
+  window.forkmeshTrackProductEvent = trackProductEvent;
+
+  document.addEventListener("click", (event) => {
+    if (!event.target || typeof event.target.closest !== "function") return;
+    const action = event.target.closest("[data-product-event]");
+    if (!action) return;
+    trackProductEvent(action.dataset.productEvent, {
+      surface: action.dataset.productSurface,
+      destination: action.dataset.productDestination,
+      proof_step: action.dataset.productProofStep,
+    });
+  });
+})();
