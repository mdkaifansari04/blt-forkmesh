@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""Static contract for the short public product proof path."""
+
+import html as html_lib
+import re
+from pathlib import Path
+
+
+PUBLIC = Path(__file__).resolve().parents[1] / "public"
+PROOF_PAGES = (
+    PUBLIC / "index.html",
+    PUBLIC / "docs.html",
+    PUBLIC / "docs" / "index.html",
+)
+DOCS_PAGES = PROOF_PAGES[1:]
+
+
+def _read(page: Path) -> str:
+    return page.read_text(encoding="utf-8")
+
+
+def _section_match(html: str, section_id: str) -> re.Match[str]:
+    match = re.search(
+        rf'<section\b(?=[^>]*\bid="{re.escape(section_id)}")[^>]*>(?P<body>.*?)</section>',
+        html,
+        flags=re.DOTALL,
+    )
+    assert match, f"{section_id} section is missing"
+    return match
+
+
+def _proof_section(html: str) -> str:
+    match = _section_match(html, "proof-path")
+    return match.group(0)
+
+
+def _li_texts(section: str) -> list[str]:
+    items = re.findall(r"<li\b[^>]*>(.*?)</li>", section, flags=re.DOTALL)
+    return [
+        re.sub(
+            r"\s+([,.;:!?])",
+            r"\1",
+            " ".join(
+                html_lib.unescape(re.sub(r"<[^>]+>", " ", item)).split(),
+            ),
+        )
+        for item in items
+    ]
+
+
+def test_public_pages_publish_the_short_operator_proof_path():
+    for page in PROOF_PAGES:
+        section = _proof_section(_read(page))
+        steps = _li_texts(section)
+
+        assert steps == [
+            "1. Collaborate Open an issue, signed PR, or repo room for the repository.",
+            "2. Add a mirror Install a desktop node and mirror the repository on it.",
+            "3. Source host offline Operator proof required Disconnect the source desktop node or source host, then review the mirror failover guidance.",
+            "4. Clone again Operator proof required Clone from the same ForkMesh repo URL. An online mirror can serve the Git data. Review the mirror failover guidance, then Open Repositories, select your repository, then open the Mirrors tab to inspect live host health.",
+        ]
+        assert section.count("Operator proof required") == 2
+        assert "Operator proof required" not in steps[0]
+        assert "Operator proof required" not in steps[1]
+        assert steps[2].count("Operator proof required") == 1
+        assert steps[3].count("Operator proof required") == 1
+
+        assert 'href="/docs/#collaboration"' in section
+        assert 'href="/desktop"' in section
+        assert section.count('href="/docs/#mirror-failover"') == 2
+        assert 'href="/dashboard/repos"' in section
+
+
+def test_docs_proof_path_uses_distinct_detailed_sections():
+    docs_html = _read(DOCS_PAGES[0])
+    docs_index_html = _read(DOCS_PAGES[1])
+    proof_match = _section_match(docs_html, "proof-path")
+    docs_section = proof_match.group(0)
+
+    assert docs_section == _proof_section(docs_index_html)
+
+    targets = re.findall(r'href="/docs/#([^"]+)"', docs_section)
+    assert targets == ["collaboration", "mirror-failover", "mirror-failover"]
+
+    for target in ("collaboration", "mirror-failover"):
+        target_match = _section_match(docs_html, target)
+        target_section = target_match.group(0)
+        assert target_match.start() > proof_match.end(), target
+        assert target_section == _section_match(docs_index_html, target).group(0)
+
+    collaboration_section = _section_match(docs_html, "collaboration").group(0)
+    assert "Collaboration routes" in collaboration_section
+    assert "signed pull requests" in collaboration_section
+    assert "encrypted rooms" in collaboration_section
+
+    mirror_failover_section = _section_match(docs_html, "mirror-failover").group(0)
+    assert "Mirror failover and operator verification" in mirror_failover_section
+    assert "same ForkMesh repo URL" in mirror_failover_section
+    assert "does not store Git packfiles" in mirror_failover_section
