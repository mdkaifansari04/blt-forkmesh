@@ -0,0 +1,182 @@
+import json
+from html.parser import HTMLParser
+from pathlib import Path
+
+
+PUBLIC = Path(__file__).resolve().parents[1] / "public"
+ROOT = PUBLIC.parent.parent
+PROMISE = (
+    "ForkMesh lets developers collaborate on, mirror, and preserve source-code "
+    "repositories across independent hosts—without relying on any single hosting provider."
+)
+
+
+class MetaParser(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.in_head = False
+        self.values = {}
+
+    def handle_starttag(self, tag, attrs):
+        if tag == "head":
+            self.in_head = True
+            return
+        if tag != "meta" or not self.in_head:
+            return
+        values = dict(attrs)
+        key = values.get("name") or values.get("property")
+        if key:
+            self.values.setdefault(key, []).append(values.get("content"))
+
+    def handle_endtag(self, tag):
+        if tag == "head":
+            self.in_head = False
+
+
+class Element:
+    def __init__(self, tag, attrs, parent=None):
+        self.tag = tag
+        self.attrs = dict(attrs)
+        self.parent = parent
+        self.children = []
+        self.parts = []
+
+    def content(self):
+        content = (part.content() if isinstance(part, Element) else part for part in self.parts)
+        return " ".join(" ".join(content).split())
+
+
+class ElementParser(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.elements = []
+        self.stack = []
+
+    def handle_starttag(self, tag, attrs):
+        parent = self.stack[-1] if self.stack else None
+        element = Element(tag, attrs, parent)
+        if parent:
+            parent.children.append(element)
+            parent.parts.append(element)
+        self.elements.append(element)
+        if tag not in {"meta", "link", "img", "input", "br", "hr", "source"}:
+            self.stack.append(element)
+
+    def handle_startendtag(self, tag, attrs):
+        self.handle_starttag(tag, attrs)
+        if self.stack and self.stack[-1].tag == tag:
+            self.stack.pop()
+
+    def handle_endtag(self, tag):
+        for index in range(len(self.stack) - 1, -1, -1):
+            if self.stack[index].tag == tag:
+                del self.stack[index:]
+                return
+
+    def handle_data(self, data):
+        if self.stack:
+            self.stack[-1].parts.append(data)
+
+
+def _read(path: Path) -> str:
+    return path.read_text(encoding="utf-8")
+
+
+def _elements(path: Path):
+    parser = ElementParser()
+    parser.feed(_read(path))
+    return parser.elements
+
+
+def _has_class(element, class_name):
+    return class_name in element.attrs.get("class", "").split()
+
+
+def _first_sibling_after(start, predicate):
+    siblings = start.parent.children
+    start_index = siblings.index(start)
+    return next(element for element in siblings[start_index + 1 :] if predicate(element))
+
+
+def _assert_lead_starts_with_promise(path: Path, predicate):
+    lead = next(element for element in _elements(path) if predicate(element))
+    assert lead.content().startswith(PROMISE), path
+
+
+def _assert_following_lead_starts_with_promise(path: Path, heading, predicate):
+    elements = _elements(path)
+    title = next(element for element in elements if element.tag == "h1" and element.content() == heading)
+    lead = _first_sibling_after(title, predicate)
+    assert lead.content().startswith(PROMISE), path
+
+
+def _assert_metadata_uses_promise(path: Path, expected_keys):
+    parser = MetaParser()
+    parser.feed(_read(path))
+    for key in expected_keys:
+        assert parser.values.get(key) == [PROMISE], (path, key, parser.values.get(key))
+
+
+def _json_ld_records(html: str):
+    parser = ElementParser()
+    parser.feed(html)
+    records = []
+    for element in parser.elements:
+        if element.tag != "script" or element.attrs.get("type") != "application/ld+json":
+            continue
+        payload = json.loads(element.content())
+        records.extend(payload.get("@graph", [payload]))
+    return records
+
+
+def test_readme_keeps_the_approved_promise_as_source_reference():
+    assert PROMISE in _read(ROOT / "README.md")
+
+
+def test_every_requested_public_surface_uses_the_promise_as_primary_lead_copy():
+    _assert_lead_starts_with_promise(
+        PUBLIC / "index.html",
+        lambda element: element.tag == "p"
+        and any(_has_class(ancestor, "hero-section") for ancestor in _ancestors(element)),
+    )
+    _assert_following_lead_starts_with_promise(
+        PUBLIC / "signup.html",
+        "Join ForkMesh",
+        lambda element: element.tag == "p" and _has_class(element, "join-sub"),
+    )
+    _assert_lead_starts_with_promise(
+        PUBLIC / "desktop.html",
+        lambda element: element.tag == "p" and _has_class(element, "install-lede"),
+    )
+    _assert_following_lead_starts_with_promise(
+        PUBLIC / "pricing.html", "Coding Reimagined For Modern Teams", lambda element: element.tag == "p"
+    )
+    _assert_following_lead_starts_with_promise(
+        PUBLIC / "mirror-payouts.html",
+        "Get paid to mirror",
+        lambda element: element.tag == "p" and _has_class(element, "join-sub"),
+    )
+    for page in (PUBLIC / "docs.html", PUBLIC / "docs" / "index.html"):
+        _assert_following_lead_starts_with_promise(page, "ForkMesh", lambda element: element.tag == "p")
+
+
+def _ancestors(element):
+    while element.parent:
+        element = element.parent
+        yield element
+
+
+def test_homepage_and_repository_primary_metadata_use_the_promise():
+    _assert_metadata_uses_promise(
+        PUBLIC / "index.html", ("description", "og:description", "twitter:description")
+    )
+    _assert_metadata_uses_promise(PUBLIC / "dashboard" / "repo.html", ("description",))
+
+
+def test_homepage_json_ld_uses_the_promise_for_primary_graph_records():
+    records = _json_ld_records(_read(PUBLIC / "index.html"))
+    descriptions = [record.get("description") for record in records]
+    assert descriptions.count(PROMISE) == 3
+    for record_type in ("Organization", "WebSite", "SoftwareApplication"):
+        record = next(record for record in records if record.get("@type") == record_type)
+        assert record["description"] == PROMISE
diff --git a/cloudflare_worker/tests/test_product_contract_copy.py b/cloudflare_worker/tests/test_product_contract_copy.py
new file mode 100644
index 000000000..ff89b1afd
--- /dev/null
+++ b/cloudflare_worker/tests/test_product_contract_copy.py
@@ -0,0 +1,199 @@
+from html.parser import HTMLParser
+from pathlib import Path
+import re
+
+
+ROOT = Path(__file__).resolve().parents[2]
+PUBLIC = ROOT / "cloudflare_worker" / "public"
+PROMISE = (
+    "ForkMesh lets developers collaborate on, mirror, and preserve source-code "
+    "repositories across independent hosts—without relying on any single hosting provider."
+)
+PROMISE_SURFACES = (
+    ROOT / "README.md",
+    PUBLIC / "index.html",
+    PUBLIC / "dashboard" / "repo.html",
+    PUBLIC / "signup.html",
+    PUBLIC / "desktop.html",
+    PUBLIC / "pricing.html",
+    PUBLIC / "mirror-payouts.html",
+)
+PRODUCT_PAGES = PROMISE_SURFACES[1:]
+CONTRADICTORY_PHRASES = (
+    "replacement for GitHub",
+    "central hosting provider",
+    "cloud stores your Git",
+    "Worker stores repositories",
+)
+NEGATED_PREFIXES = {
+    "replacement for github": re.compile(r"\b(?:is not|isn't)\s+(?:an?\s+)?$"),
+    "central hosting provider": re.compile(
+        r"\b(?:is not|isn't|does not depend on|doesn't depend on|does not rely on|doesn't rely on)\s+(?:an?\s+)?$"
+    ),
+}
+SUPPRESSED_TAGS = {"head", "script", "style", "template"}
+VOID_TAGS = {
+    "area",
+    "base",
+    "br",
+    "col",
+    "embed",
+    "hr",
+    "img",
+    "input",
+    "link",
+    "meta",
+    "param",
+    "source",
+    "track",
+    "wbr",
+}
+
+
+class _VisibleTextParser(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__()
+        self.text: list[str] = []
+        self.list_items: list[list[str]] = []
+        self.calc_cells: list[list[str]] = []
+        self.calc_notes: list[list[str]] = []
+        self._body_depth = 0
+        self._ignored_depth = 0
+        self._tag_stack: list[tuple[str, bool, bool, list[str] | None]] = []
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        attributes = dict(attrs)
+        classes = attributes.get("class", "").casefold().split()
+        if tag in VOID_TAGS:
+            return
+        suppressed = (
+            tag in SUPPRESSED_TAGS
+            or "hidden" in attributes
+            or attributes.get("aria-hidden", "").casefold() == "true"
+            or "hidden" in classes
+        )
+        in_body = self._body_depth > 0 or tag == "body"
+        if tag == "body":
+            self._body_depth += 1
+        if suppressed:
+            self._ignored_depth += 1
+
+        capture: list[str] | None = None
+        if in_body and not self._ignored_depth and tag == "li":
+            capture = []
+            self.list_items.append(capture)
+        elif (
+            in_body
+            and not self._ignored_depth
+            and tag == "div"
+            and "calc-cell" in classes
+        ):
+            capture = []
+            self.calc_cells.append(capture)
+        elif in_body and not self._ignored_depth and tag == "p" and "calc-note" in classes:
+            capture = []
+            self.calc_notes.append(capture)
+        self._tag_stack.append((tag, tag == "body", suppressed, capture))
+
+    def handle_endtag(self, tag: str) -> None:
+        for index in range(len(self._tag_stack) - 1, -1, -1):
+            if self._tag_stack[index][0] != tag:
+                continue
+            closed_tags = self._tag_stack[index:]
+            del self._tag_stack[index:]
+            for _, is_body, suppressed, _ in closed_tags:
+                if is_body:
+                    self._body_depth -= 1
+                if suppressed:
+                    self._ignored_depth -= 1
+            return
+
+    def handle_data(self, data: str) -> None:
+        if not self._body_depth or self._ignored_depth:
+            return
+        self.text.append(data)
+        for _, _, _, capture in self._tag_stack:
+            if capture is not None:
+                capture.append(data)
+
+
+def _read(path: Path) -> str:
+    return path.read_text(encoding="utf-8")
+
+
+def _normalized(text: str) -> str:
+    return " ".join(text.split())
+
+
+def _visible_text(content: str) -> _VisibleTextParser:
+    parser = _VisibleTextParser()
+    parser.feed(content)
+    return parser
+
+
+def _is_negated(content: str, phrase: str, phrase_start: int) -> bool:
+    pattern = NEGATED_PREFIXES.get(phrase.casefold())
+    return pattern is not None and bool(pattern.search(content[:phrase_start]))
+
+
+def test_product_contract_promise_is_present_on_every_required_surface():
+    for path in PROMISE_SURFACES:
+        assert PROMISE in _read(path), path
+
+
+def test_product_contract_rejects_known_contradictory_positioning():
+    for path in PRODUCT_PAGES:
+        content = _normalized("".join(_visible_text(_read(path)).text)).casefold()
+        for phrase in CONTRADICTORY_PHRASES:
+            for match in re.finditer(re.escape(phrase.casefold()), content):
+                assert _is_negated(content, phrase, match.start()), (path, phrase)
+
+
+def test_product_contract_negation_and_visible_text_parsing_are_bounded():
+    accepted = (
+        ("ForkMesh does not depend on a central hosting provider", "central hosting provider"),
+        ("ForkMesh doesn't rely on a central hosting provider", "central hosting provider"),
+        ("ForkMesh is not a replacement for GitHub", "replacement for GitHub"),
+        ("ForkMesh is not a central hosting provider", "central hosting provider"),
+    )
+    for content, phrase in accepted:
+        assert _is_negated(
+            content.casefold(), phrase.casefold(), content.casefold().index(phrase.casefold())
+        )
+
+    rejected = (
+        ("ForkMesh relies on a central hosting provider", "central hosting provider"),
+        ("ForkMesh never sleeps and is a central hosting provider", "central hosting provider"),
+        ("ForkMesh is not small but a replacement for GitHub", "replacement for GitHub"),
+        ("ForkMesh does not mirror code and is a central hosting provider", "central hosting provider"),
+    )
+    for content, phrase in rejected:
+        assert not _is_negated(
+            content.casefold(), phrase.casefold(), content.casefold().index(phrase.casefold())
+        )
+
+    parser = _visible_text(
+        "<head><title>Hidden title</title></head>"
+        "<body><template><img><p>Template text</p></template>"
+        "<p hidden>Hidden attribute</p><p aria-hidden=\"true\">Aria hidden</p>"
+        "<p class=\"hidden\">Hidden class</p><p>Rendered text</p></body>"
+    )
+    assert _normalized("".join(parser.text)) == "Rendered text"
+
+
+def test_commercial_pages_keep_non_live_claims_clearly_labeled():
+    pricing = _visible_text(_read(PUBLIC / "pricing.html"))
+    mirror_payouts = _visible_text(_read(PUBLIC / "mirror-payouts.html"))
+
+    assert "Private beta and roadmap access" in {
+        _normalized("".join(item)) for item in pricing.list_items
+    }
+    cells = {_normalized("".join(cell)) for cell in mirror_payouts.calc_cells}
+    assert any("Payout per join" in cell and "illustrative" in cell for cell in cells)
+    assert any("Est. earnings" in cell and "estimate only" in cell for cell in cells)
+    assert any(
+        "Estimates are illustrative while the reward engine is in progress." in _normalized(
+            "".join(note)
+        )
+        for note in mirror_payouts.calc_notes
+    )
