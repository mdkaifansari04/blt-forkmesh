+```python
+from html.parser import HTMLParser
+from pathlib import Path
+
+
+PUBLIC = Path(__file__).resolve().parents[1] / "public"
+ROOT = PUBLIC.parent.parent
+PROMISE = (
+    "ForkMesh lets developers collaborate on, mirror, and preserve source-code "
+    "repositories across independent hosts—without relying on any single hosting provider."
+)
+TARGET_PAGES = (
+    PUBLIC / "index.html",
+    PUBLIC / "dashboard" / "repo.html",
+    PUBLIC / "signup.html",
+    PUBLIC / "desktop.html",
+    PUBLIC / "pricing.html",
+    PUBLIC / "mirror-payouts.html",
+    PUBLIC / "docs.html",
+    PUBLIC / "docs" / "index.html",
+)
+
+
+class MetaParser(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.values = {}
+
+    def handle_starttag(self, tag, attrs):
+        if tag != "meta":
+            return
+        values = dict(attrs)
+        key = values.get("name") or values.get("property")
+        if key:
+            self.values[key] = values.get("content")
+
+
+def _read(path: Path) -> str:
+    return path.read_text(encoding="utf-8")
+
+
+def test_readme_keeps_the_approved_promise_as_source_reference():
+    assert PROMISE in _read(ROOT / "README.md")
+
+
+def test_every_requested_public_surface_uses_the_exact_promise():
+    for page in TARGET_PAGES:
+        assert PROMISE in _read(page), page
+
+
+def test_homepage_primary_metadata_and_json_ld_use_the_promise():
+    html = _read(PUBLIC / "index.html")
+    parser = MetaParser()
+    parser.feed(html)
+
+    for key in ("description", "og:description", "twitter:description"):
+        assert parser.values[key] == PROMISE
+
+    assert html.count(f'"description": "{PROMISE}"') == 3
+```
