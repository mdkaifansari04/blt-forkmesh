+
+  function renderPayoutNodes(nodes) {
+    const root = document.querySelector("#network-wallets");
+    if (!root) return;
+    const list = Array.isArray(nodes) ? nodes : [];
+    if (!list.length) {
+      root.innerHTML = '<div class="online-graph-empty">No active payout wallets yet.</div>';
