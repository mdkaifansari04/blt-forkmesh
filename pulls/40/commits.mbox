@@ -0,0 +1,61 @@
+"""Regression coverage for the D1 migration command scope."""
+
+import os
+import stat
+import subprocess
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+
+ROOT = Path(__file__).resolve().parents[1]
+MIGRATE_SCRIPT = ROOT / "migrate.sh"
+
+
+def run_migrate_script(overrides: dict[str, str]) -> subprocess.CompletedProcess[str]:
+    """Run migrate.sh with a fake pywrangler and return its captured output."""
+    with TemporaryDirectory() as temporary_directory:
+        venv_bin = Path(temporary_directory) / "bin"
+        venv_bin.mkdir()
+        fake_pywrangler = venv_bin / "pywrangler"
+        fake_pywrangler.write_text(
+            "#!/usr/bin/env bash\n"
+            "printf '%s\\n' \"$*\"\n",
+            encoding="utf-8",
+        )
+        fake_pywrangler.chmod(fake_pywrangler.stat().st_mode | stat.S_IXUSR)
+
+        environment = os.environ.copy()
+        environment.pop("FORKMESH_D1_LOCAL", None)
+        environment.pop("WRANGLER_COMMAND", None)
+        environment["PYWRANGLER_VENV"] = temporary_directory
+        environment.update(overrides)
+
+        return subprocess.run(
+            [str(MIGRATE_SCRIPT)],
+            cwd=ROOT,
+            env=environment,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+
+
+def test_wrangler_dev_uses_local_d1_migrations():
+    result = run_migrate_script({"WRANGLER_COMMAND": "dev"})
+
+    assert result.returncode == 0
+    assert "d1 migrations apply forkmesh --local" in result.stdout
+
+
+def test_deploy_uses_remote_d1_migrations():
+    result = run_migrate_script({"WRANGLER_COMMAND": "deploy"})
+
+    assert result.returncode == 0
+    assert "d1 migrations apply forkmesh --remote" in result.stdout
+
+
+def test_explicit_local_override_uses_local_d1_migrations():
+    result = run_migrate_script({"FORKMESH_D1_LOCAL": "1"})
+
+    assert result.returncode == 0
+    assert "d1 migrations apply forkmesh --local" in result.stdout
-- 
