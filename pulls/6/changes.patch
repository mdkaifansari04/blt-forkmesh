new file mode 100644
index 00000000..5bd83865
--- /dev/null
+++ b/cloudflare_worker/migrations/0037_email_admin_single_category.sql
@@ -0,0 +1,24 @@
+-- ForkMesh D1 migration 0030 - one category assignment per recipient.
+
+INSERT OR IGNORE INTO email_category_memberships
+  (category_id, recipient_id, created_at)
+SELECT category.id, recipient.id, unixepoch() * 1000
+FROM email_categories AS category
+CROSS JOIN email_recipients AS recipient
+WHERE category.is_system = 1;
+
+DELETE FROM email_category_memberships AS membership
+WHERE membership.category_id != (
+  SELECT candidate.category_id
+  FROM email_category_memberships AS candidate
+  JOIN email_categories AS category ON category.id = candidate.category_id
+  WHERE candidate.recipient_id = membership.recipient_id
+  ORDER BY
+    category.is_system ASC,
+    candidate.created_at DESC,
+    candidate.category_id DESC
+  LIMIT 1
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS idx_email_memberships_one_category
+  ON email_category_memberships(recipient_id);
