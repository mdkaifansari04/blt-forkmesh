+    for row in rows:
+        try:
+            record = await runtime.open(row.get("data"))
+        except Exception:
+            continue
+        if (
+            not is_admin
+            and _visibility(record) != "public"
+            and not bool(int(row.get("joined") or 0))
+        ):
