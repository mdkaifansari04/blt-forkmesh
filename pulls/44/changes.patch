+        if not member_bi or not canonical:
+            return _response(
+                runtime, {"error": "user_not_found"}, status=404)
+        if canonical in seen_members:
+            continue
+        seen_members.add(canonical)
+        if await runtime.is_admin(canonical):
+            continue
