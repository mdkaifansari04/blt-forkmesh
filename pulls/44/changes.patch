+      (() => {
+        function applyTheme(mode) {
+          const chosen =
+            mode ||
+            localStorage.getItem("forkmesh.theme") ||
+            (window.matchMedia &&
+            window.matchMedia("(prefers-color-scheme: dark)").matches
+              ? "dark"
+              : "light");
+          document.documentElement.classList.toggle("dark", chosen === "dark");
+          localStorage.setItem("forkmesh.theme", chosen);
+        }
+
+        applyTheme();
+
+        const themeToggle = document.querySelector("#theme-toggle");
+        if (themeToggle) {
+          themeToggle.addEventListener("click", () => {
+            applyTheme(
+              document.documentElement.classList.contains("dark")
+                ? "light"
+                : "dark",
+            );
+          });
+        }
+
+        const docsSearch = document.querySelector("#docs-search");
+        const docsSearchPanel = document.querySelector("#docs-search-panel");
+        const docsSearchResults = document.querySelector(
+          "#docs-search-results",
+        );
+        const docsSearchEmpty = document.querySelector("#docs-search-empty");
+        const docsSearchIndex = Array.from(
+          document.querySelectorAll("[data-search-title]"),
+        ).map((section) => ({
+          title: section.getAttribute("data-search-title") || "",
+          body: section.getAttribute("data-search-body") || "",
+          target: `#${section.id}`,
+        }));
+
+        function setDocsSearchPanel(open) {
+          if (!docsSearch || !docsSearchPanel) return;
+          docsSearchPanel.classList.toggle("hidden", !open);
+          docsSearch.setAttribute("aria-expanded", open ? "true" : "false");
+        }
+
+        function renderDocsSearchResults(query) {
+          if (!docsSearchResults || !docsSearchEmpty) return;
+          const normalized = query.trim().toLowerCase();
+          const matches = (
+            normalized
+              ? docsSearchIndex
+                  .map((item) => {
+                    const title = item.title.toLowerCase();
+                    const body = item.body.toLowerCase();
+                    const matched =
+                      title.includes(normalized) || body.includes(normalized);
+                    const score = title.includes(normalized) ? 0 : 1;
+                    return { ...item, matched, score };
+                  })
+                  .filter((item) => item.matched)
+                  .sort(
+                    (a, b) =>
+                      a.score - b.score || a.title.localeCompare(b.title),
+                  )
+              : docsSearchIndex
+          ).slice(0, 8);
+
+          docsSearchResults.textContent = "";
+          docsSearchEmpty.classList.toggle("hidden", matches.length > 0);
+
+          matches.forEach((item) => {
+            const link = document.createElement("a");
+            link.href = item.target;
+            link.className =
+              "block rounded-xl px-3 py-3 text-sm font-semibold text-[var(--docs-fg)] no-underline hover:bg-[var(--docs-hover)]";
+            link.setAttribute("role", "option");
+
+            const title = document.createElement("span");
+            title.className = "block";
+            title.textContent = item.title;
+
+            const body = document.createElement("span");
+            body.className =
+              "mt-1 block truncate text-xs font-semibold text-[var(--docs-muted)]";
+            body.textContent = item.body;
+
+            link.append(title, body);
+            link.addEventListener("click", () => {
+              setDocsSearchPanel(false);
+              docsSearch.value = "";
+            });
+            docsSearchResults.append(link);
+          });
+        }
+
+        if (docsSearch && docsSearchPanel) {
+          docsSearch.addEventListener("focus", () => {
+            renderDocsSearchResults(docsSearch.value);
+            setDocsSearchPanel(true);
+          });
+
+          docsSearch.addEventListener("input", () => {
+            renderDocsSearchResults(docsSearch.value);
+            setDocsSearchPanel(true);
+          });
+
+          docsSearch.addEventListener("keydown", (event) => {
+            if (event.key === "Escape") {
+              setDocsSearchPanel(false);
+              docsSearch.blur();
+              return;
+            }
+            if (event.key === "Enter") {
+              const firstResult = docsSearchPanel.querySelector("a");
+              if (firstResult) {
+                event.preventDefault();
+                firstResult.click();
+              }
+            }
+          });
+
+          document.addEventListener("keydown", (event) => {
+            if (
+              (event.metaKey || event.ctrlKey) &&
+              event.key.toLowerCase() === "k"
+            ) {
+              event.preventDefault();
+              docsSearch.focus();
+              docsSearch.select();
+            }
+          });
+
+          document.addEventListener("click", (event) => {
+            if (
+              !docsSearchPanel.contains(event.target) &&
+              event.target !== docsSearch
+            ) {
+              setDocsSearchPanel(false);
+            }
+          });
+        }
+
+        const copyButton = document.querySelector("#copy-page");
+        if (copyButton) {
+          const copyLabel = copyButton.querySelector("span");
+          copyButton.addEventListener("click", async () => {
+            const text = window.location.href.split("#")[0];
+            try {
+              await navigator.clipboard.writeText(text);
+            } catch (error) {
+              const area = document.createElement("textarea");
+              area.value = text;
+              area.style.position = "fixed";
+              area.style.left = "-9999px";
+              document.body.append(area);
+              area.select();
+              document.execCommand("copy");
+              area.remove();
+            }
+            if (!copyLabel) return;
+            const original = copyLabel.textContent;
+            copyLabel.textContent = "Copied";
+            setTimeout(() => {
+              copyLabel.textContent = original;
+            }, 1400);
+          });
+        }
+      })();
+    </script>
   </body>
