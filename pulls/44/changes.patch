+        "INSERT INTO chat_channels "
+        "(channel_id,name_bi,data,created_by_bi,created_at,updated_at,"
+        "key_version) VALUES (?,?,?,?,?,?,1)",
+        (channel_id, name_bi, sealed, account_bi, now, now),
+    )]
