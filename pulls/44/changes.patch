+            "INSERT INTO chat_channel_members "
+            "(channel_id,member_bi,data,invited_by_bi,joined_at) "
+            "VALUES (?,?,?,?,?)",
+            (channel_id, member_bi, member_data, account_bi, now),
+        ))
