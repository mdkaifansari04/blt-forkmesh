From 42993ce775d60889b31104a65d55ae2b3d02428a Mon Sep 17 00:00:00 2001
From: Md Kaif Ansari <amdkaif843@gmail.com>
Date: Thu, 2 Jul 2026 15:18:15 +0530
Subject: [PATCH] fix: stabilize Qt client tests and roster alerts

---
 qt_client/src/MainWindowInternal.h     |  4 ++--
 qt_client/src/MainWindowMessages.cpp   | 17 ++++++++++++-----
 qt_client/tests/test_window_resize.cpp | 15 +++++++++++++++
 3 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/qt_client/src/MainWindowInternal.h b/qt_client/src/MainWindowInternal.h
index b4472253..a1925258 100644
--- a/qt_client/src/MainWindowInternal.h
+++ b/qt_client/src/MainWindowInternal.h
@@ -2621,7 +2621,7 @@ inline QString builtExecutablePath(const QString &buildDir)
 }
 
 #ifdef Q_OS_MACOS
-QString brewPrefix(const QString &formula)
+inline QString brewPrefix(const QString &formula)
 {
     const QString brew = QStandardPaths::findExecutable("brew");
     if (brew.isEmpty())
@@ -6090,7 +6090,7 @@ inline QString autostartDesktopPath()
 }
 
 #if defined(Q_OS_MACOS)
-QString launchAgentPath()
+inline QString launchAgentPath()
 {
     return QDir::homePath() + "/Library/LaunchAgents/com.forkmesh.app.plist";
 }
diff --git a/qt_client/src/MainWindowMessages.cpp b/qt_client/src/MainWindowMessages.cpp
index 108262ee..605c2207 100644
--- a/qt_client/src/MainWindowMessages.cpp
+++ b/qt_client/src/MainWindowMessages.cpp
@@ -390,17 +390,25 @@ void MainWindow::setRoster(const QList<MemberInfo> &members)
     // previous roster), and skip the very first fill so we don't alert for every
     // node that was already online when we connected.
     const bool firstRoster = m_homeRoster.isEmpty();
+    const QString ownId = m_profileIdentity.publicKey();
+    const QString ownName = accountOwner();
     QSet<QString> previouslyOnline;
-    for (const MemberInfo &m : std::as_const(m_homeRoster))
+    for (const MemberInfo &m : std::as_const(m_homeRoster)) {
+        if (m.self)
+            continue;
+        if (!ownId.isEmpty() && m.id == ownId)
+            continue;
+        if (!ownName.isEmpty() && m.name.compare(ownName, Qt::CaseInsensitive) == 0)
+            continue;
         if (m.online && !m.id.isEmpty())
             previouslyOnline.insert(m.id);
-    if (!firstRoster &&
+    }
+    const bool firstPeerRoster = previouslyOnline.isEmpty();
+    if (!firstPeerRoster &&
         QDateTime::currentMSecsSinceEpoch() >= m_nodeAlertGraceUntilMs) {
         // Never notify about our own node coming online. The roster's "self"
         // flag isn't always set (e.g. on reconnect), so also match our own node
         // id (public key) and account name defensively.
-        const QString ownId = m_profileIdentity.publicKey();
-        const QString ownName = accountOwner();
         const bool showNodeConnectAlert =
             QSettings().value(kNodeConnectAlertSetting, false).toBool();
         for (const MemberInfo &m : visibleMembers) {
@@ -986,4 +994,3 @@ void MainWindow::saveIncomingFile(const QString &fileName, const QByteArray &dat
         return;
     }
 }
-
diff --git a/qt_client/tests/test_window_resize.cpp b/qt_client/tests/test_window_resize.cpp
index 5b16f4e7..fb68d5a4 100644
--- a/qt_client/tests/test_window_resize.cpp
+++ b/qt_client/tests/test_window_resize.cpp
@@ -16,6 +16,7 @@
 #include <QSemaphore>
 #include <QPushButton>
 #include <QSettings>
+#include <QStandardPaths>
 #include <QTemporaryDir>
 #include <QWidget>
 
@@ -220,11 +221,25 @@ int main(int argc, char *argv[])
     }
     qputenv("XDG_DATA_HOME", dataDir.path().toUtf8());
 
+    QStandardPaths::setTestModeEnabled(true);
+
     QApplication app(argc, argv);
     app.setQuitOnLastWindowClosed(false);
     app.setOrganizationName("ForkMeshTests");
     app.setApplicationName("WindowResize");
 
+    const QString appDataPath =
+        QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+    if (appDataPath.isEmpty()) {
+        qCritical("FAIL: could not resolve temporary app data directory");
+        return 1;
+    }
+    QDir appDataDir(appDataPath);
+    if (appDataDir.exists() && !appDataDir.removeRecursively()) {
+        qCritical("FAIL: could not clear temporary app data directory");
+        return 1;
+    }
+
     // issue #300: the headless node runs on the offscreen QPA plugin, whose
     // propagateSizeHints() base implementation logs "This plugin does not support
     // propagateSizeHints()" every time a window pushes its size constraints —
-- 
2.50.1 (Apple Git-155)

