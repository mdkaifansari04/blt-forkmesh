+    rec = await decrypt_row(env, row.get("data", ""))
+    if not rec:
+        return "", ""
+    return (clean_string(rec.get("owner", ""), MAX_NODE_NAME).lower(),
+            clean_string(rec.get("name", ""), MAX_REPO_SEGMENT))
