+
+        cards.forEach((card) => {
+          card.classList.toggle("is-hidden", !visibleCards.has(card));
+        });
+
+        list.classList.toggle("is-fetching", repoIsFetching);
+        document.querySelector("[data-repo-loading]")?.classList.toggle("hidden", !repoIsFetching);
+
+        const summary = document.querySelector("[data-repo-summary]");
+        if (summary) {
+          summary.textContent = matchedCards.length
+            ? `Showing ${start + 1}-${end} of ${matchedCards.length} mirrored repositories`
+            : "No repositories match this filter";
+        }
+
+        renderRepoPageButtons(totalPages);
+        setRepoButtonDisabled(document.querySelector("[data-repo-prev]"), repoIsFetching || repoCurrentPage === 1);
+        setRepoButtonDisabled(document.querySelector("[data-repo-next]"), repoIsFetching || repoCurrentPage === totalPages);
+      }
+
+      function setRepoPage(page, options = {}) {
+        const totalPages = Math.max(1, Math.ceil(filteredRepoCards().length / repoPageSize));
+        const targetPage = Math.min(Math.max(page, 1), totalPages);
+        if (targetPage === repoCurrentPage && !options.force) return;
+
+        window.clearTimeout(repoFetchTimer);
+        if (options.instant) {
+          repoCurrentPage = targetPage;
+          repoIsFetching = false;
+          applyRepoVisibility();
+          return;
+        }
+
+        repoIsFetching = true;
+        applyRepoVisibility();
+        repoFetchTimer = window.setTimeout(() => {
+          repoCurrentPage = targetPage;
+          repoIsFetching = false;
+          applyRepoVisibility();
+        }, 220);
+      }
+
+      document.getElementById("repoSearch").addEventListener("input", () => {
+        window.clearTimeout(repoFetchTimer);
+        repoCurrentPage = 1;
+        repoIsFetching = false;
+        applyRepoVisibility();
+      });
+
+      document.querySelector("[data-repo-prev]")?.addEventListener("click", () => setRepoPage(repoCurrentPage - 1));
+      document.querySelector("[data-repo-next]")?.addEventListener("click", () => setRepoPage(repoCurrentPage + 1));
+      applyRepoVisibility();
+
+      document.querySelectorAll("[data-view-mode]").forEach((button) => {
+        button.addEventListener("click", () => {
+          const mode = button.dataset.viewMode;
+          const gridMode = mode === "grid";
+          document.getElementById("repoList").classList.toggle("grid-mode", gridMode);
+          document.querySelectorAll("[data-view-mode]").forEach((control) => {
+            const active = control.dataset.viewMode === mode;
+            control.setAttribute("aria-pressed", active ? "true" : "false");
+            control.classList.toggle("bg-secondary", active);
+            control.classList.toggle("text-foreground", active);
+            control.classList.toggle("text-muted-foreground", !active);
+          });
+        });
+      });
+
+      document.querySelectorAll(".copy-button").forEach((button) => {
+        button.addEventListener("click", async () => {
+          const text = button.dataset.copy;
+          try {
+            await navigator.clipboard.writeText(text);
+          } catch (error) {
+            const temp = document.createElement("textarea");
+            temp.value = text;
+            temp.setAttribute("readonly", "");
+            temp.style.position = "fixed";
+            temp.style.opacity = "0";
+            document.body.appendChild(temp);
+            temp.select();
+            document.execCommand("copy");
+            temp.remove();
+          }
+          button.classList.add("copied");
+          window.setTimeout(() => button.classList.remove("copied"), 1600);
+        });
+      });
+
+      // Chat is wired by /dashboard-chat.js.
+	      // Notifications disabled until notification data is wired to real APIs.
+	      initProfileMenu();
+	      initContributionActivity();
+	      lucide.createIcons();
+    </script>
+  </body>
+</html>
