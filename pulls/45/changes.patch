+  <body class="bg-background text-foreground">
+    <div class="flex h-screen flex-col overflow-hidden bg-background text-foreground font-sans">
+      <header data-app-header class="relative h-14 border-b border-border bg-card flex items-center gap-6 px-4 shrink-0">
+        <a class="brand flex items-center gap-2.5 shrink-0" href="/" aria-label="ForkMesh home">
+          <img class="brand-mark w-7 h-7 rounded-md object-contain" src="/assets/logo.png" alt="" aria-hidden="true" />
