+def _chat_direct_ticket(env, conversation_id, key_version, account_bi):
+    expires = int(Date.now()) + CHAT_DIRECT_TICKET_TTL_MS
+    canonical = ".".join((
+        "v1",
+        str(conversation_id),
+        str(int(key_version)),
+        str(account_bi),
+        str(expires),
+    ))
+    signature = hmac.new(
+        (_require_data_secret(env) + ":chat-direct-ticket-v1").encode(),
+        canonical.encode(),
+        "sha256",
+    ).hexdigest()
+    return canonical + "." + signature
