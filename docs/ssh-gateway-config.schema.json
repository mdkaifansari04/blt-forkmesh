{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forkmesh.com/schemas/ssh-gateway-config-v1.json",
  "title": "ForkMesh node-side Git SSH gateway configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorizationSocket",
    "authorizationBrokerUser",
    "gatewayExecutable",
    "refreshNotifier",
    "repositoryRoot",
    "repositories"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "authorizationSocket": {
      "type": "string",
      "pattern": "^/[^\\r\\n\\u0000]+$"
    },
    "authorizationBrokerUser": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,62}$"
    },
    "gatewayExecutable": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9_./+-]+$"
    },
    "refreshNotifier": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9_./+-]+$"
    },
    "repositoryRoot": {
      "type": "string",
      "pattern": "^/[^\\r\\n\\u0000]+$"
    },
    "repositories": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "name", "path", "access"],
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,100}$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n\\u0000]+$"
          },
          "access": {"enum": ["read-only", "read-write"]}
        }
      }
    }
  }
}
