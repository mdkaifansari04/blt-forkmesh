{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forkmesh.com/schemas/headless-mirror-refresh-v1.json",
  "title": "ForkMesh headless mirror refresh configuration",
  "description": "Secret-free local orchestration configuration. Private keys, API tokens, passwords, and wallet credentials are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "sourceRepository",
    "archiveDirectory",
    "gatewayConfigPath",
    "identityStateDirectory",
    "identityHelperPath",
    "mirrorGatewayPath",
    "pythonProgram",
    "gitProgram",
    "manifestPath",
    "nodeOwner",
    "repositoryName",
    "ownerAliases",
    "workerOrigin",
    "publicOrigin",
    "listen",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "forkmesh.headless-mirror-refresh"
    },
    "sourceRepository": {
      "$ref": "#/$defs/absolutePath"
    },
    "archiveDirectory": {
      "$ref": "#/$defs/absolutePath"
    },
    "releaseStore": {
      "description": "Optional owner-local content-addressed store for public release assets. Repository source remains in the encrypted archive; this path contains only explicitly published immutable binaries.",
      "$ref": "#/$defs/absolutePath"
    },
    "gatewayConfigPath": {
      "$ref": "#/$defs/absolutePath"
    },
    "identityStateDirectory": {
      "$ref": "#/$defs/absolutePath"
    },
    "identityHelperPath": {
      "$ref": "#/$defs/absolutePath"
    },
    "mirrorGatewayPath": {
      "$ref": "#/$defs/absolutePath"
    },
    "pythonProgram": {
      "$ref": "#/$defs/absolutePath"
    },
    "gitProgram": {
      "$ref": "#/$defs/absolutePath"
    },
    "manifestPath": {
      "$ref": "#/$defs/absolutePath"
    },
    "nodeOwner": {
      "$ref": "#/$defs/nodeName"
    },
    "repositoryName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "ownerAliases": {
      "description": "Unique public owner paths served from the same encrypted archive. The configured nodeOwner must be present.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nodeName"
      }
    },
    "workerOrigin": {
      "$ref": "#/$defs/httpsOrigin"
    },
    "publicOrigin": {
      "$ref": "#/$defs/httpsOrigin"
    },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "enum": [
            "127.0.0.1",
            "::1",
            "localhost"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "operations": {
      "description": "The runtime additionally requires git-info-refs, git-upload-pack, tree, blob, and raw.",
      "type": "array",
      "minItems": 5,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "enum": [
          "git-info-refs",
          "git-upload-pack",
          "tree",
          "blobs",
          "blob",
          "raw",
          "history",
          "commit",
          "compare",
          "branches",
          "search",
          "stats",
          "sizes",
          "release-blob"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "git-info-refs"
          }
        },
        {
          "contains": {
            "const": "git-upload-pack"
          }
        },
        {
          "contains": {
            "const": "tree"
          }
        },
        {
          "contains": {
            "const": "blob"
          }
        },
        {
          "contains": {
            "const": "raw"
          }
        }
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "solana": {
          "description": "Optional public self-custodial payout address; never a private key.",
          "type": "string",
          "pattern": "^(?:|[1-9A-HJ-NP-Za-km-z]{32,44})$"
        },
        "channel": {
          "type": "string",
          "maxLength": 120
        },
        "hostedSince": {
          "type": "string",
          "pattern": "^(?:|[1-9][0-9]{0,18})$"
        },
        "branch": {
          "type": "string",
          "maxLength": 120
        },
        "platform": {
          "type": "string",
          "maxLength": 16
        },
        "version": {
          "type": "string",
          "maxLength": 32
        }
      }
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "nodeName": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "httpsOrigin": {
      "type": "string",
      "maxLength": 261,
      "pattern": "^https://[A-Za-z0-9.-]+/?$"
    }
  }
}
