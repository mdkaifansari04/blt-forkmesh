# Template for .env.production (which is gitignored). Copy it and fill in real
# values:  cp .env.production.example .env.production
#
# deploy.sh reads .env.production and pushes each line to the Worker as a SECRET
# (`pywrangler secret put KEY`). Secrets persist across deploys; plaintext vars do
# not (a deploy that omits them wipes them), which is why these aren't [vars].
#
# Exception: CLOUDFLARE_* keys configure wrangler itself (not the Worker), so
# deploy.sh exports them and does NOT push them as secrets.

# The Cloudflare account to deploy to. Kept here (gitignored) rather than in the
# committed wrangler.toml so this open-source repo doesn't ship a specific account
# ID and forks deploy to their own account. Find yours: `wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Admin error dashboard at https://<host>/<ADMIN_PATH>, gated by HTTP Basic auth.
# ADMIN_PATH must start with "admin-" so it is routed to the worker.
ADMIN_PATH=admin-CHANGE-ME-TO-SOMETHING-RANDOM
ADMIN_USER=admin
ADMIN_PASS=CHANGE-ME

# Treasury Solana address: receives automated sweeps from per-account join
# deposit wallets. Kept here as a secret rather than in wrangler.toml so it's
# not committed and a deploy can't wipe it. Falls back to NODE_SOLANA_ADDRESS.
TREASURY_SOLANA_ADDRESS=CHANGE-ME

# At-rest encryption key for D1: derives the AES-GCM data key AND the blind-index
# HMAC key. This protects every encrypted row, including the Ed25519 SEEDS that
# control custody deposit/bounty wallets — so it MUST be a strong, secret random
# value and MUST NOT live in wrangler.toml [vars] (plaintext + committed = public).
# Generate one with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating this value makes all existing encrypted rows undecryptable, so sweep
# any custody funds before changing it.
DATA_KEY=CHANGE-ME-RUN-THE-GENERATOR-ABOVE
