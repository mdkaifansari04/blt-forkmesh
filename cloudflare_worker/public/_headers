# ForkMesh World is an immediately entered multiplayer application. A browser
# refresh must never reuse an older module graph after a deployment; Cloudflare
# still distributes each deployment's content-addressed assets at the edge, but
# the browser is instructed not to retain the application shell or runtime.
# The World is also embedded same-origin at the bottom of every site page, so
# it must be frameable by 'self' (same unset-then-replace dance as /chat).
/world
  Cache-Control: no-store, max-age=0, must-revalidate
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN

/world/*
  Cache-Control: no-store, max-age=0, must-revalidate
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
