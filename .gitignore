qt_client/build-forkmesh/
qt_client/build-ci/
qt_client/build-release/
cloudflare_worker/python_modules/
.wrangler/

# Local secrets / env files (the *.example templates stay tracked).
.env
.env.*
!.env.*.example
build-forkmesh/
.venv/
.git-rewrite/
tools/__pycache__/
node_modules/
cloudflare_worker/browser_tests/test-results/
cloudflare_worker/test-results/
cloudflare_worker/browser_tests/playwright-report/

# Offline legacy-custody migration outputs. These may be encrypted, but remain
# owner-only operational artifacts and must never enter repository history.
*.fmcustody
*custody-confirmation*.json
*custody-scrub*.sql
*d1-snapshot*.sqlite
*d1-export*.sql

# Release artifact bytes live in a per-node content-addressed blob store and are
# NEVER committed (issue #304; see docs/design/release-binary-publishing.md).
# Only the small signed release metadata under .forkmesh/releases/ is tracked.
.forkmesh/release-blobs/
# Release publisher private keys are local trust roots, never repository data.
release-signing-key*.pem
.forkmesh/*release*private*.pem
forkmesh-variables.json
forkmesh-hosts.md
todo.md
todo2.md
improvements.md
todo.md
